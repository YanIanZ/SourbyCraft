{
    "_comment": "SourbyCraft v4-REL — Pelican/Pterodactyl Egg",
    "name": "SourbyCraft",
    "author": "support@iyanz.dev",
    "description": "High-performance Paper fork with built-in security, anti-xray, dynamic scaling, SWM, and NeoForge mod support. Requires Java 25.",
    "features": [
        "eula",
        "java_version"
    ],
    "docker_images": {
        "Java 25": "ghcr.io/pterodactyl/yolks:java_25",
        "Java 21": "ghcr.io/pterodactyl/yolks:java_21"
    },
    "file_denylist": [],
    "startup": "java -Xms128M --add-modules=jdk.incubator.vector -XX:+UseZGC -XX:+ZGenerational -XX:SoftMaxHeapSize=10G -XX:ConcGCThreads=2 -XX:ParallelGCThreads=4 -XX:ZCollectionInterval=5 -XX:ZUncommitDelay=300 -XX:ZAllocationSpikeTolerance=3 -XX:+AlwaysPreTouch -XX:+UseStringDeduplication -XX:+UseContainerSupport -XX:CICompilerCount=2 -XX:TieredStopAtLevel=1 -XX:MaxRAMPercentage=95.0 -Dterminal.jline=false -Dterminal.ansi=true -jar {{SERVER_JARFILE}} --nogui",
    "config": {
        "files": "{\n    \"server.properties\": {\n        \"parser\": \"properties\",\n        \"find\": {\n            \"server-ip\": \"0.0.0.0\",\n            \"server-port\": \"{{server.build.default.port}}\",\n            \"query.port\": \"{{server.build.default.port}}\",\n            \"rcon.port\": \"{{server.build.default.rcon}}\"\n        }\n    },\n    \"bukkit.yml\": {\n        \"parser\": \"yaml\",\n        \"find\": {\n            \"settings.allow-end\": false\n        }\n    },\n    \"spigot.yml\": {\n        \"parser\": \"yaml\",\n        \"find\": {\n            \"settings.bungeecord\": false\n        }\n    },\n    \"sourbycraft.yml\": {\n        \"parser\": \"yaml\",\n        \"find\": {\n            \"entity.tick-rate\": 1,\n            \"entity.mob-tick-distance\": 32,\n            \"entity.max-per-chunk\": 10\n        }\n    },\n    \"sourbycraft-security.yml\": {\n        \"parser\": \"yaml\",\n        \"find\": {\n            \"crash-prevention.nbt.max-bytes\": 2097152,\n            \"crash-prevention.nbt.max-depth\": 64\n        }\n    }\n}",
        "startup": "{\n    \"done\": \"Done\"\n}",
        "logs": "{\n    \"custom\": false,\n    \"location\": \"logs/latest.log\"\n}",
        "stop": "stop"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/bash\n\napt update\napt install -y curl jq\n\nRELEASE_TAG=${RELEASE_TAG:-v4-REL}\nMC_VERSION=${MC_VERSION:-1.21.11}\n\necho \"Downloading SourbyCraft $RELEASE_TAG...\"\n\nRELEASE_URL=$(curl -s https://api.github.com/repos/YanIanZ/SourbyCraft/releases/tags/$RELEASE_TAG | jq -r '.assets[] | select(.name | contains(\"paperclip\")) | .browser_download_url')\n\nif [ -z \"$RELEASE_URL\" ]; then\n    echo \"Release $RELEASE_TAG not found!\"\n    exit 1\nfi\n\ncurl -L -o sourbycraft-server.jar \"$RELEASE_URL\"\n\necho \"Downloaded successfully\"\n\nif [ ! -f server.properties ]; then\n    echo \"eula=true\" > eula.txt\nfi\n\necho \"Installation complete\"" ,
            "container": "ghcr.io/pterodactyl/installers:alpine",
            "entrypoint": "bash"
        }
    },
    "variables": [
        {
            "name": "Release Tag",
            "description": "SourbyCraft release version tag",
            "env_variable": "RELEASE_TAG",
            "default_value": "v4-REL",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|string|max:20"
        },
        {
            "name": "Server JAR File",
            "description": "The name of the server jarfile to run the server with.",
            "env_variable": "SERVER_JARFILE",
            "default_value": "sourbycraft-server.jar",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|string|max:64"
        }
    ]
}
