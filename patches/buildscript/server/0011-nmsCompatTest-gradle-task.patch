From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Thu, 4 Jun 2026 01:31:31 +0700
Subject: [PATCH] nmsCompatTest gradle task


diff --git a/build.gradle.kts b/build.gradle.kts
index 0045619527ab525f5b8d690fa5f6f6e55f5c726a..04f07ddb54db8d580af7f229bd28345017b92a16 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -461,3 +461,58 @@ afterEvaluate {
     }
 }
 // SourbyCraft end - work around strange paperweight madness
+
+// SourbyCraft v12 — NMS-compat smoke harness task. Opt-in: `-PrunNmsCompat=true`.
+// Single-jar (mojmap) per 2026-06-04 spec revision.
+val runNmsCompat = providers.gradleProperty("runNmsCompat").map { it.toBoolean() }.getOrElse(false)
+
+if (runNmsCompat) {
+    tasks.register<JavaExec>("nmsCompatTest") {
+        group = "verification"
+        description = "Run NMS-compat smoke harness against the mojmap paperclip jar"
+        dependsOn(":assembleReleaseArtifacts", ":test-harness:sanity-harness-plugin:jar")
+        classpath = sourceSets["test"].runtimeClasspath
+        mainClass.set("dev.iyanz.sourbycraft.nms.CompatHarness")
+
+        val bootScript = rootProject.file("test-harness/scripts/boot-mojmap.sh")
+        val resultJson = rootProject.file("test-harness/TestServer-mojmap/nms-compat-result.json")
+        val pidFile = rootProject.file("test-harness/TestServer-mojmap/.server.pid")
+        val junitXml = layout.buildDirectory.file("test-results/nms-compat/mojmap.xml").get().asFile
+
+        doFirst {
+            val proc = ProcessBuilder(bootScript.absolutePath).inheritIO().start()
+            val exit = proc.waitFor()
+            if (exit != 0) {
+                throw GradleException("boot-mojmap.sh failed with exit $exit")
+            }
+            Thread.sleep(3000)  // sanity-harness 20-tick (~1s) delayed task
+        }
+        args("mojmap", resultJson.absolutePath, junitXml.absolutePath)
+        doLast {
+            if (pidFile.exists()) {
+                val pid = pidFile.readText().trim()
+                ProcessBuilder("kill", "-TERM", pid).start().waitFor()
+                var elapsed = 0L
+                while (elapsed < 60_000L) {
+                    val check = ProcessBuilder("ps", "-p", pid).start()
+                    if (check.waitFor() != 0) break
+                    Thread.sleep(2000); elapsed += 2000
+                }
+            }
+            if (!resultJson.exists()) {
+                throw GradleException("nmsCompatTest: missing $resultJson")
+            }
+            val plugins = listOf("Citizens", "NBTAPI", "DecentHolograms", "FastAsyncWorldEdit")
+            val json = resultJson.readText()
+            val failed = mutableListOf<String>()
+            for (p in plugins) {
+                val ok = Regex("\"plugin\"\\s*:\\s*\"$p\"[^}]*\"sanity_passed\"\\s*:\\s*true").containsMatchIn(json)
+                if (!ok) failed.add(p)
+            }
+            if (failed.isNotEmpty()) {
+                throw GradleException("nmsCompatTest: invariant violated — plugins failed on mojmap: $failed")
+            }
+            logger.lifecycle("nmsCompatTest: invariant met — every target plugin green on mojmap")
+        }
+    }
+}
