From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Wed, 13 May 2026 13:51:04 +0700
Subject: [PATCH] feat: version format vN-DEV/REL/EXP with GMT+7 build time


diff --git a/build.gradle.kts b/build.gradle.kts
index c1239082f87bdb005fad6184b4d80cde747b325b..0e32a7f6edb465310583ec0704fb8fa7d6886101 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -2,6 +2,9 @@ import io.papermc.fill.model.BuildChannel
 import io.papermc.paperweight.attribute.DevBundleOutput
 import io.papermc.paperweight.util.*
 import java.time.Instant
+import java.time.ZonedDateTime
+import java.time.ZoneId
+import java.time.format.DateTimeFormatter
 
 plugins {
     `java-library`
@@ -247,11 +250,18 @@ tasks.jar {
         val git = Git(rootProject.layout.projectDirectory.path)
         val mcVersion = rootProject.providers.gradleProperty("mcVersion").get()
         val build = System.getenv("BUILD_NUMBER") ?: null
-        val buildTime = providers.environmentVariable("BUILD_STARTED_AT").map(Instant::parse).orElse(Instant.EPOCH).get()
+        val releaseVersion = rootProject.providers.gradleProperty("releaseVersion").get()
+        val now = ZonedDateTime.now(ZoneId.of("Asia/Jakarta"))
+        val buildTimeIso = now.toInstant().toString()
         val gitHash = git.exec(providers, "rev-parse", "--short=7", "HEAD").get().trim()
-        val implementationVersion = "$mcVersion-${build ?: "DEV"}-$gitHash"
-        val date = git.exec(providers, "show", "-s", "--format=%ci", gitHash).get().trim()
         val gitBranch = git.exec(providers, "rev-parse", "--abbrev-ref", "HEAD").get().trim()
+        val suffix = when {
+            gitBranch.contains("experimental") || gitBranch.contains("feat") -> "EXP"
+            gitBranch.contains("-dev") || gitBranch.contains("develop") -> "DEV"
+            else -> "REL"
+        }
+        val implementationVersion = "v$releaseVersion-$suffix"
+        val date = git.exec(providers, "show", "-s", "--format=%ci", gitHash).get().trim()
         attributes(
             "Main-Class" to "org.bukkit.craftbukkit.Main",
             "Implementation-Title" to "SourbyCraft", // SourbyCraft - branding
@@ -263,7 +273,7 @@ tasks.jar {
             "Brand-Id" to "sourbycraft:sourbycraft", // SourbyCraft - branding
             "Brand-Name" to "SourbyCraft", // SourbyCraft - branding
             "Build-Number" to (build ?: ""),
-            "Build-Time" to buildTime.toString(),
+            "Build-Time" to buildTimeIso,
             "Git-Branch" to gitBranch,
             "Git-Commit" to gitHash,
         )
