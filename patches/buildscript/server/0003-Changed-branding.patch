From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: iyanz <boooky10@gmail.com>
Date: Wed, 22 Dec 2021 15:05:23 +0100
Subject: [PATCH] Changed branding


diff --git a/build.gradle.kts b/build.gradle.kts
index 80ec4cd9eb50290c84f3af5226ea454b555ba68c..39a5da5fd6074159e7979e81ffb4f2eb5cceb181 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -227,14 +227,14 @@ tasks.jar {
         val gitBranch = git.exec(providers, "rev-parse", "--abbrev-ref", "HEAD").get().trim()
         attributes(
             "Main-Class" to "org.bukkit.craftbukkit.Main",
-            "Implementation-Title" to "Paper",
+            "Implementation-Title" to "SourbyCraft", // SourbyCraft - branding
             "Implementation-Version" to implementationVersion,
             "Implementation-Vendor" to date,
-            "Specification-Title" to "Paper",
+            "Specification-Title" to "SourbyCraft", // SourbyCraft - branding
             "Specification-Version" to project.version,
-            "Specification-Vendor" to "Paper Team",
-            "Brand-Id" to "papermc:paper",
-            "Brand-Name" to "Paper",
+            "Specification-Vendor" to "SourbyCraft", // SourbyCraft - branding
+            "Brand-Id" to "sourbycraft:sourbycraft", // SourbyCraft - branding
+            "Brand-Name" to "SourbyCraft", // SourbyCraft - branding
             "Build-Number" to (build ?: ""),
             "Build-Time" to buildTime.toString(),
             "Git-Branch" to gitBranch,
