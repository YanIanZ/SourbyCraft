From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Thu, 4 Jun 2026 12:44:00 +0700
Subject: [PATCH] test task maxHeapSize 2G to prevent OOM


diff --git a/build.gradle.kts b/build.gradle.kts
index 0f43ef868d114425b0c6ab0e44e0386c866bb217..60004b9bff33651c2049b3ad84536560f3063cdb 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -336,6 +336,10 @@ tasks.test {
         excludeTags("Slow")
     }
 
+    // SourbyCraft: Paper test suite OOMs under default 512M when forkEvery=1 spawns
+    // heap-heavy reflection tests (Mockito + ASM + classgraph). Bump to 2G.
+    maxHeapSize = "2G"
+
     // Configure mockito agent that is needed in newer java versions
     val provider = objects.newInstance<MockitoAgentProvider>()
     provider.fileCollection.from(mockitoAgent)
