From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Fri, 5 Jun 2026 22:16:54 +0700
Subject: [PATCH] p1TierSmokeTest gradle task


diff --git a/build.gradle.kts b/build.gradle.kts
index b0b75a509a6e537d7e2ce8b65502a133801d1a86..a04b52f87fc91872d04b7a76da92d806c883b9f4 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -548,3 +548,17 @@ if (runP0KnobSmoke) {
         commandLine("bash", rootProject.file("test-harness/scripts/p0-knob-smoke.sh").absolutePath)
     }
 }
+
+// SourbyCraft v12 — perf-engine P1 tier sensor boot smoke.
+// Opt-in via -PrunP1TierSmoke=true to keep the regular build fast.
+val runP1TierSmoke = providers.gradleProperty("runP1TierSmoke").map { it.toBoolean() }.getOrElse(false)
+
+if (runP1TierSmoke) {
+    tasks.register<Exec>("p1TierSmokeTest") {
+        group = "verification"
+        description = "Boot SourbyCraft jar with perf-engine P1 tier sensor scenarios; assert via boot.log + RCON"
+        dependsOn(":assembleReleaseArtifacts")
+        workingDir = rootProject.rootDir
+        commandLine("bash", rootProject.file("test-harness/scripts/p1-tier-smoke.sh").absolutePath)
+    }
+}
