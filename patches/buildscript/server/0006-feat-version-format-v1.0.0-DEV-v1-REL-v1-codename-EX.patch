From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Wed, 13 May 2026 16:55:32 +0700
Subject: [PATCH] feat: version format v1.0.0-DEV/v1-REL/v1<codename>-EXP


diff --git a/build.gradle.kts b/build.gradle.kts
index 81cf27833b78b210f517d5ca4921c4504403d21f..2946f93bede93e5b4a08846abbbdb57516e73e2e 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -250,7 +250,9 @@ tasks.jar {
         val git = Git(rootProject.layout.projectDirectory.path)
         val mcVersion = rootProject.providers.gradleProperty("mcVersion").get()
         val build = System.getenv("BUILD_NUMBER") ?: null
-        val releaseVersion = rootProject.providers.gradleProperty("releaseVersion").get()
+        val releaseVersionFull = rootProject.providers.gradleProperty("releaseVersion").get()
+        val releaseMajor = releaseVersionFull.split(".")[0]
+        val codename = rootProject.providers.gradleProperty("codename").getOrElse("dev")
         val now = ZonedDateTime.now(ZoneId.of("Asia/Jakarta"))
         val buildTimeIso = now.toInstant().toString()
         val gitHash = git.exec(providers, "rev-parse", "--short=7", "HEAD").get().trim()
@@ -260,7 +262,11 @@ tasks.jar {
             gitBranch.contains("-dev") || gitBranch.contains("develop") -> "DEV"
             else -> "REL"
         }
-        val implementationVersion = "v$releaseVersion-$suffix"
+        val implementationVersion = when {
+            suffix == "EXP" -> "$releaseMajor-EXP"
+            suffix == "REL" -> "$releaseMajor-REL"
+            else -> "$releaseVersionFull-DEV"
+        }
         val date = git.exec(providers, "show", "-s", "--format=%ci", gitHash).get().trim()
         attributes(
             "Main-Class" to "org.bukkit.craftbukkit.Main",
