From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <superwhisz@gmail.com>
Date: Fri, 19 Jun 2026 04:31:32 +0700
Subject: [PATCH] feat: release/* branch produces REL artifacts


diff --git a/build.gradle.kts b/build.gradle.kts
index 6fd8c84095af5dd2857a8ee080074ee8cded4971..78e1e130edc40ce31a105a1262369fc0fe3d3840 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -235,8 +235,13 @@ tasks.jar {
         val buildTimeIso = now.toInstant().toString()
         val gitHash = git.exec(providers, "rev-parse", "--short=7", "HEAD").get().trim()
         val gitBranch = git.exec(providers, "rev-parse", "--abbrev-ref", "HEAD").get().trim()
+        // Branch -> release suffix mapping. `release/*` branches always produce REL
+        // artifacts so the manifest version + jar filename match the GitHub release
+        // tag operators consume. Experimental / dev branches keep their EXP / DEV
+        // suffixes so feature work doesn't get mislabelled as REL.
         val suffix = when {
             gitBranch.contains("experimental") || gitBranch.contains("feat") -> "EXP"
+            gitBranch.startsWith("release/") -> "REL"
             gitBranch.contains("-dev") || gitBranch.contains("develop") -> "DEV"
             codename == "dev" -> "DEV"
             else -> "REL"
