From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Wed, 27 May 2026 10:44:16 +0700
Subject: [PATCH] fix: enable ByteBuddy experimental mode for Java 25+ NMS
 entity mocking

Mockito 5.14.1 uses ByteBuddy which officially supports up to Java 23.
Add -Dnet.bytebuddy.experimental=true to test JVM args so that NMS
entity classes (Entity, LivingEntity, ItemEntity, ExperienceOrb,
AbstractArrow) can be instrumented for mocking in unit tests on Java 25.

diff --git a/build.gradle.kts b/build.gradle.kts
index 8aa099bc43c2abb74469864ef06a818240b6791d..0045619527ab525f5b8d690fa5f6f6e55f5c726a 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -340,6 +340,8 @@ tasks.test {
     val provider = objects.newInstance<MockitoAgentProvider>()
     provider.fileCollection.from(mockitoAgent)
     jvmArgumentProviders.add(provider)
+    // SourbyCraft: enable ByteBuddy experimental mode for Java 25+ (NMS entity mocking)
+    jvmArgs("-Dnet.bytebuddy.experimental=true")
 }
 
 val generatedDir: java.nio.file.Path = layout.projectDirectory.dir("../paper-server/src/generated/java").asFile.toPath()
