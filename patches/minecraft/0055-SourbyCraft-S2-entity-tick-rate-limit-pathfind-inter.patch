From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Sun, 5 Jul 2026 05:20:59 +0700
Subject: [PATCH] SourbyCraft S2: entity tick-rate limit, pathfind interval,
 durability freeze, communication-command gates


diff --git a/io/papermc/paper/entity/activation/ActivationRange.java b/io/papermc/paper/entity/activation/ActivationRange.java
index 829f7685904fd741e00403647ae76d32275c34a3..f4673f9529d781d93a9644ddd83620f733b3b747 100644
--- a/io/papermc/paper/entity/activation/ActivationRange.java
+++ b/io/papermc/paper/entity/activation/ActivationRange.java
@@ -309,6 +309,13 @@ public final class ActivationRange {
         // Should this entity tick?
         if (!isActive) {
             if ((MinecraftServer.currentTick - entity.activatedTick - 1) % 20 == 0) {
+                // SourbyCraft S2 - entity.tick-rate-limit: stretch inactive-entity cadence to entity.tick-rate
+                if (dev.iyanz.sourbycraft.SourbyCraftConfig.entityTickRateLimit) {
+                    final int rate = dev.iyanz.sourbycraft.perf.knob.Knobs.ENTITY_TICK_RATE.get();
+                    if (rate > 0 && rate < 20 && (entity.tickCount % Math.max(1, 20 / rate)) != 0) {
+                        return false; // skip this inactive tick grant
+                    }
+                }
                 // Check immunities every 20 ticks.
                 final int immunity = checkEntityImmunities(entity);
                 if (immunity >= 0) {
