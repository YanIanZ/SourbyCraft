diff --git a/net/minecraft/world/entity/ai/navigation/PathNavigation.java b/net/minecraft/world/entity/ai/navigation/PathNavigation.java
index 862224dfc003bf02ee0d7c1d804549210d6c8ffa..e2591523c5ff13cec92918de86b704d74e61d61d 100644
--- a/net/minecraft/world/entity/ai/navigation/PathNavigation.java
+++ b/net/minecraft/world/entity/ai/navigation/PathNavigation.java
@@ -55,6 +55,7 @@ public abstract class PathNavigation {
     public final PathFinder pathFinder;
     private boolean isStuck;
     private float requiredPathLength = 16.0F;
+    private int sourbyLastRecompute = Integer.MIN_VALUE / 2; // half-min: `tick - last` must never overflow int (MIN_VALUE would wrap negative and jam the gate shut)
 
     public PathNavigation(final Mob mob, final Level level) {
         this.mob = mob;
@@ -99,6 +100,12 @@ public abstract class PathNavigation {
     }
 
     public void recomputePath() {
+        // SourbyCraft S2 - entity.mob-pathfind-interval: floor between path recomputes
+        final int sourbyInterval = dev.iyanz.sourbycraft.SourbyCraftConfig.mobPathfindInterval;
+        if (sourbyInterval > 1 && this.tick - this.sourbyLastRecompute < sourbyInterval) {
+            return;
+        }
+        this.sourbyLastRecompute = this.tick;
         if (this.level.getGameTime() - this.timeLastRecompute <= 20L || !this.canUpdatePath()) {
             this.hasDelayedRecomputation = true;
         } else if (this.targetPos != null) {
