+    // SourbyCraft start - drop stack consolidation
+    public static void tryMergeDropStacks(java.util.List<ItemEntity> items) {
+        if (!dev.iyanz.sourbycraft.SourbyCraftConfig.itemMergeOptimize || items.size() <= 1) return;
+        for (int destIdx = 0; destIdx < items.size(); destIdx++) {
+            ItemEntity destEntity = items.get(destIdx);
+            if (destEntity == null) continue;
+            ItemStack destStack = destEntity.getItem();
+            if (destStack.isEmpty()) continue;
+            int cap = dev.iyanz.sourbycraft.SourbyCraftConfig.unlimitedDropStack
+                ? dev.iyanz.sourbycraft.SourbyCraftConfig.dropStackCap
+                : destStack.getMaxStackSize();
+            int destCount = destStack.getCount();
+            if (destCount >= cap) continue;
+            for (int origIdx = destIdx + 1; origIdx < items.size(); origIdx++) {
+                ItemEntity origEntity = items.get(origIdx);
+                if (origEntity == null) continue;
+                ItemStack origStack = origEntity.getItem();
+                if (origStack.isEmpty() || !ItemStack.isSameItemSameComponents(destStack, origStack)) continue;
+                int origCount = origStack.getCount();
+                int canMerge = Math.min(cap - destCount, origCount);
+                if (canMerge <= 0) break;
+                int totalAfter = destCount + canMerge;
+                net.minecraft.world.phys.Vec3 destVel = destEntity.getDeltaMovement();
+                net.minecraft.world.phys.Vec3 origVel = origEntity.getDeltaMovement();
+                destEntity.setDeltaMovement(
+                    (destVel.x * destCount + origVel.x * canMerge) / totalAfter,
+                    (destVel.y * destCount + origVel.y * canMerge) / totalAfter,
+                    (destVel.z * destCount + origVel.z * canMerge) / totalAfter
+                );
+                ItemStack merged = merge(destStack, origStack, cap);
+                destEntity.setItem(merged);
+                destCount = merged.getCount();
+                if (destEntity.ownerUUID == null) {
+                    destEntity.ownerUUID = origEntity.ownerUUID;
+                } else if (origEntity.ownerUUID != null && !origEntity.ownerUUID.equals(destEntity.ownerUUID)) {
+                    if (origCount > (destCount - canMerge)) destEntity.ownerUUID = origEntity.ownerUUID;
+                }
+                destEntity.pickupDelay = Math.max(destEntity.pickupDelay, origEntity.pickupDelay);
+                destEntity.age = Math.min(destEntity.age, origEntity.age);
+                if (origStack.isEmpty()) {
+                    origEntity.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.MERGE);
+                    items.set(origIdx, null);
+                }
+            }
+        }
+    }
+    // SourbyCraft end
+
