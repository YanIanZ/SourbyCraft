From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Sun, 31 May 2026 21:05:09 +0700
Subject: [PATCH] SourbyCraft v11.0 PvP server tuning


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index e5bb746535018b9bd5290d3247da1222dd9a8928..ae8b565bf80d0c7b67b7d76e152a9420caa0b1fa 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1771,6 +1771,24 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             catch (Throwable t) { /* ignore — manager not started or world iteration failed */ }
         }
         // SourbyCraft end - v9.19 wildstacker periodic tick
+        // SourbyCraft start - v11.0 PvP one-shot network tuning (apply view/simulation distance caps after worlds loaded)
+        if (this.tickCount == 20 && dev.iyanz.sourbycraft.SourbyCraftConfig.pvpEnabled) {
+            try {
+                int vdCap = dev.iyanz.sourbycraft.SourbyCraftConfig.pvpViewDistanceCap;
+                int sdCap = dev.iyanz.sourbycraft.SourbyCraftConfig.pvpSimulationDistanceCap;
+                for (net.minecraft.server.level.ServerLevel lvl : this.levels.values()) {
+                    if (vdCap > 0 && lvl.getChunkSource().chunkMap.serverViewDistance > vdCap) {
+                        LOGGER.info("[SourbyCraft:PvP] Capping view distance for {} -> {}", lvl.dimension(), vdCap);
+                        lvl.getChunkSource().setViewDistance(vdCap);
+                    }
+                    if (sdCap > 0) {
+                        LOGGER.info("[SourbyCraft:PvP] Capping simulation distance for {} -> {}", lvl.dimension(), sdCap);
+                        lvl.getChunkSource().setSimulationDistance(sdCap);
+                    }
+                }
+            } catch (Throwable t) { LOGGER.warn("[SourbyCraft:PvP] view/sim distance cap failed: {}", t.toString()); }
+        }
+        // SourbyCraft end - v11.0 PvP one-shot network tuning
         // SourbyCraft start - v9.23 BossBar ticker (NMS-driven, no Bukkit scheduler / plugin required)
         try { dev.iyanz.sourbycraft.command.BossBarTicker.tick(); }
         catch (Throwable t) { /* ignore */ }
diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 810104c881534931253b086be22a4c72752e4060..fca9f37692c70f53364535d19a70ea670daf124b 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -2107,13 +2107,25 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
                 z = (this.random.nextDouble() - this.random.nextDouble()) * 0.01;
             }
 
-            Vec3 vec3 = new Vec3(x, 0.0, z).normalize().scale(strength);
+            // SourbyCraft v11.0 — PvP knockback formula override (1.8-style configurable friction + bonuses)
+            double scKbStrength = strength;
+            double scKbFriction = 2.0;
+            double scKbMaxY = 0.4;
+            if (dev.iyanz.sourbycraft.SourbyCraftConfig.pvpEnabled) {
+                scKbFriction = Math.max(0.0, dev.iyanz.sourbycraft.SourbyCraftConfig.pvpKnockbackFriction);
+                scKbMaxY = dev.iyanz.sourbycraft.SourbyCraftConfig.pvpKnockbackVertical;
+            }
+            Vec3 vec3 = new Vec3(x, 0.0, z).normalize().scale(scKbStrength);
+            double scDmX = scKbFriction > 0.0 ? deltaMovement.x / scKbFriction : 0.0;
+            double scDmZ = scKbFriction > 0.0 ? deltaMovement.z / scKbFriction : 0.0;
+            double scDmY = scKbFriction > 0.0 ? deltaMovement.y / scKbFriction : 0.0;
             // Paper start - knockback events
             Vec3 finalVelocity = new Vec3(
-                deltaMovement.x / 2.0 - vec3.x,
-                this.onGround() ? Math.min(0.4, deltaMovement.y / 2.0 + strength) : deltaMovement.y,
-                deltaMovement.z / 2.0 - vec3.z
+                scDmX - vec3.x,
+                this.onGround() ? Math.min(scKbMaxY, scDmY + scKbStrength) : deltaMovement.y,
+                scDmZ - vec3.z
             );
+            // SourbyCraft end
             Vec3 diff = finalVelocity.subtract(deltaMovement);
             io.papermc.paper.event.entity.EntityKnockbackEvent event = CraftEventFactory.callEntityKnockbackEvent((org.bukkit.craftbukkit.entity.CraftLivingEntity) this.getBukkitEntity(), attacker, attacker, eventCause, strength, diff);
             // Paper end - knockback events
diff --git a/net/minecraft/world/entity/player/Player.java b/net/minecraft/world/entity/player/Player.java
index e4240fa38fb8513c7e320a4b30e6dcbb7e015310..59f038f60454a3dac6d0e40f928e53bc69977c36 100644
--- a/net/minecraft/world/entity/player/Player.java
+++ b/net/minecraft/world/entity/player/Player.java
@@ -1065,7 +1065,13 @@ public abstract class Player extends Avatar implements ContainerUser {
                     Vec3 deltaMovement = target.getDeltaMovement();
                     boolean flag3 = target.hurtOrSimulate(damageSource, f2);
                     if (flag3) {
-                        this.causeExtraKnockback(target, this.getKnockback(target, damageSource) + (flag1 ? 0.5F : 0.0F), deltaMovement);
+                        // SourbyCraft v11.0 — PvP sprint-attack extra KB configurable (vanilla 0.5)
+                        float scExtraKb = (flag1
+                            ? (dev.iyanz.sourbycraft.SourbyCraftConfig.pvpEnabled
+                                ? (float) dev.iyanz.sourbycraft.SourbyCraftConfig.pvpKnockbackExtraHorizontal
+                                : 0.5F)
+                            : 0.0F);
+                        this.causeExtraKnockback(target, this.getKnockback(target, damageSource) + scExtraKb, deltaMovement);
                         if (isSweepAttack) {
                             this.doSweepAttack(target, f, damageSource, attackStrengthScale);
                         }
@@ -1961,6 +1967,10 @@ public abstract class Player extends Avatar implements ContainerUser {
     }
 
     public float getAttackStrengthScale(float adjustTicks) {
+        // SourbyCraft v11.0 — PvP no-cooldown: always return full attack strength
+        if (dev.iyanz.sourbycraft.SourbyCraftConfig.pvpEnabled && dev.iyanz.sourbycraft.SourbyCraftConfig.pvpNoAttackCooldown) {
+            return 1.0F;
+        }
         return Mth.clamp((this.attackStrengthTicker + adjustTicks) / this.getCurrentItemAttackStrengthDelay(), 0.0F, 1.0F);
     }
 
