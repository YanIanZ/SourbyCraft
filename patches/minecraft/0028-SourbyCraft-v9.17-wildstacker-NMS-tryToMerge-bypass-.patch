From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Wed, 27 May 2026 23:31:17 +0700
Subject: [PATCH] SourbyCraft v9.17 wildstacker NMS tryToMerge bypass
 maxStackSize cap to 99

Raise isMergable/areMergable/merge caps from item.getMaxStackSize() (64)
to ABSOLUTE_MAX_STACK_SIZE (99) when wildstacker is enabled. Vanilla
tick-driven mergeWithNeighbours now consolidates same-type items into
stacks up to 99. After-merge hook calls WildstackerManager.onMerged()
to refresh floating hologram.

diff --git a/net/minecraft/world/entity/item/ItemEntity.java b/net/minecraft/world/entity/item/ItemEntity.java
index e82bb8f2d2b0e771dc371fd7e709116e1f5f204f..ad466b9ae5a95b0aecc6d0c4c0d0372c2f2d4885 100644
--- a/net/minecraft/world/entity/item/ItemEntity.java
+++ b/net/minecraft/world/entity/item/ItemEntity.java
@@ -267,7 +267,11 @@ public class ItemEntity extends Entity implements TraceableEntity {
 
     private boolean isMergable() {
         ItemStack item = this.getItem();
-        return this.isAlive() && this.pickupDelay != 32767 && this.age != -32768 && this.age < this.despawnRate && item.getCount() < item.getMaxStackSize(); // Paper - Alternative item-despawn-rate
+        // SourbyCraft - raise merge eligibility cap to ABSOLUTE_MAX_STACK_SIZE (99) when wildstacker enabled
+        int mergeCap = dev.iyanz.sourbycraft.SourbyCraftConfig.wildstackerEnabled
+            ? net.minecraft.world.item.Item.ABSOLUTE_MAX_STACK_SIZE
+            : item.getMaxStackSize();
+        return this.isAlive() && this.pickupDelay != 32767 && this.age != -32768 && this.age < this.despawnRate && item.getCount() < mergeCap; // Paper - Alternative item-despawn-rate
     }
 
     private void tryToMerge(ItemEntity itemEntity) {
@@ -283,7 +287,11 @@ public class ItemEntity extends Entity implements TraceableEntity {
     }
 
     public static boolean areMergable(ItemStack destinationStack, ItemStack originStack) {
-        return originStack.getCount() + destinationStack.getCount() <= originStack.getMaxStackSize()
+        // SourbyCraft - raise merge cap to ABSOLUTE_MAX_STACK_SIZE (99) when wildstacker enabled
+        int cap = dev.iyanz.sourbycraft.SourbyCraftConfig.wildstackerEnabled
+            ? net.minecraft.world.item.Item.ABSOLUTE_MAX_STACK_SIZE
+            : originStack.getMaxStackSize();
+        return originStack.getCount() + destinationStack.getCount() <= cap
             && ItemStack.isSameItemSameComponents(destinationStack, originStack);
     }
 
@@ -295,7 +303,11 @@ public class ItemEntity extends Entity implements TraceableEntity {
     }
 
     private static void merge(ItemEntity destinationEntity, ItemStack destinationStack, ItemStack originStack) {
-        ItemStack itemStack = merge(destinationStack, originStack, 64);
+        // SourbyCraft - use ABSOLUTE_MAX_STACK_SIZE (99) as merge amount cap when wildstacker enabled
+        int mergeAmount = dev.iyanz.sourbycraft.SourbyCraftConfig.wildstackerEnabled
+            ? net.minecraft.world.item.Item.ABSOLUTE_MAX_STACK_SIZE
+            : 64;
+        ItemStack itemStack = merge(destinationStack, originStack, mergeAmount);
         destinationEntity.setItem(itemStack);
     }
 
@@ -311,6 +323,11 @@ public class ItemEntity extends Entity implements TraceableEntity {
         if (originStack.isEmpty()) {
             originEntity.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.MERGE); // CraftBukkit - add Bukkit remove cause
         }
+        // SourbyCraft - notify hologram manager after NMS merge
+        try {
+            dev.iyanz.sourbycraft.wildstacker.WildstackerManager.onMerged(
+                (org.bukkit.entity.Item) destinationEntity.getBukkitEntity());
+        } catch (Throwable t) { /* manager not started or entity not an Item; ignore */ }
     }
 
     @Override
