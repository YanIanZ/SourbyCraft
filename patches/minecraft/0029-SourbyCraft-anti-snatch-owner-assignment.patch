From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Tue, 20 May 2026 00:00:00 +0700
Subject: [PATCH] SourbyCraft anti-snatch owner assignment on drop


diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index ac18e512b8fce848c8c13bc5ff9e93f85e026609..9ebc86e0f69ff822524dc47bf31f4afbb5a49b61 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -2708,6 +2708,12 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
     public ItemEntity drop(ItemStack droppedItem, boolean dropAround, boolean traceItem, boolean callEvent, java.util.function.@Nullable Consumer<org.bukkit.entity.Item> entityOperation) { // Paper - Extend dropItem API
         ItemEntity itemEntity = super.drop(droppedItem, dropAround, traceItem, callEvent, entityOperation); // Paper - Extend dropItem API
         ItemStack itemStack = itemEntity != null ? itemEntity.getItem() : ItemStack.EMPTY; // Paper - move up
+        // SourbyCraft start - anti-snatch
+        if (itemEntity != null && dev.iyanz.sourbycraft.SourbyCraftConfig.ownerProtectionEnabled) {
+            itemEntity.ownerUUID = this.getUUID();
+            itemEntity.pickupDelay = Math.min(dev.iyanz.sourbycraft.SourbyCraftConfig.ownerProtectionTime, 1638) * 20;
+        }
+        // SourbyCraft end
         if (traceItem) {
             if (!itemStack.isEmpty()) {
                 this.awardStat(Stats.ITEM_DROPPED.get(itemStack.getItem()), itemStack.getCount()); // Paper - use size from dropped item
diff --git a/net/minecraft/server/level/ServerPlayerGameMode.java b/net/minecraft/server/level/ServerPlayerGameMode.java
index 84d19d79e77cec6a5d64f59fbcce703e467b2407..9a196072ba7aa9dff6efc7a8d91e6e2c55c37774 100644
--- a/net/minecraft/server/level/ServerPlayerGameMode.java
+++ b/net/minecraft/server/level/ServerPlayerGameMode.java
@@ -415,6 +415,21 @@ public class ServerPlayerGameMode {
                 // CraftBukkit start
                 java.util.List<net.minecraft.world.entity.item.ItemEntity> itemsToDrop = this.level.captureDrops; // Paper - capture all item additions to the world
                 this.level.captureDrops = null; // Paper - capture all item additions to the world; Remove this earlier so that we can actually drop stuff
+                // SourbyCraft start - drop consolidation + anti-snatch
+                if (itemsToDrop != null && !itemsToDrop.isEmpty()) {
+                    if (dev.iyanz.sourbycraft.SourbyCraftConfig.itemMergeOptimize) {
+                        net.minecraft.world.entity.item.ItemEntity.tryMergeDropStacks(itemsToDrop);
+                        itemsToDrop.removeIf(e -> e == null);
+                    }
+                    if (dev.iyanz.sourbycraft.SourbyCraftConfig.ownerProtectionEnabled) {
+                        for (net.minecraft.world.entity.item.ItemEntity item : itemsToDrop) {
+                            if (item != null) {
+                                item.ownerUUID = this.player.getUUID();
+                                item.pickupDelay = Math.min(dev.iyanz.sourbycraft.SourbyCraftConfig.ownerProtectionTime, 1638) * 20;
+                            }
+                        }
+                    }
+                }
+                // SourbyCraft end
                 if (event.isDropItems()) {
                     org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockDropItemEvent(bblock, state, this.player, itemsToDrop); // Paper - capture all item additions to the world
                 }
