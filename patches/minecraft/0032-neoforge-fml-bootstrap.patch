From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SourbyCraft <dev@iyanz.dev>
Date: Thu, 15 May 2026 09:00:00 +0700
Subject: [PATCH] NeoForge FML bootstrap hook — auto-scan mods folder on server start


diff --git a/net/minecraft/server/dedicated/DedicatedServer.java b/net/minecraft/server/dedicated/DedicatedServer.java
--- a/net/minecraft/server/dedicated/DedicatedServer.java
+++ b/net/minecraft/server/dedicated/DedicatedServer.java
@@ -274,6 +274,11 @@
+        gg.pufferfish.pufferfish.PufferfishConfig.load((java.io.File) options.valueOf("pufferfish-settings")); // Pufferfish // SourbyCraft - configurable pufferfish config location
+        gg.pufferfish.pufferfish.PufferfishCommand.init(); // Pufferfish
+        dev.iyanz.sourbycraft.SourbyCraftConfig.init((java.io.File) this.options.valueOf("sourbycraft-settings")); // SourbyCraft - config
+        dev.iyanz.sourbycraft.security.SourbyCraftSecurityConfig.init(new java.io.File("sourbycraft-security.yml")); // SourbyCraft - crash prevention
+        dev.iyanz.sourbycraft.mod.FmlBootstrap.init(); // SourbyCraft - NeoForge mod scan
@@ -391,6 +396,11 @@
+            // Pufferfish start - async mob spawning
+            if (gg.pufferfish.pufferfish.PufferfishConfig.enableAsyncMobSpawning) {
+                this.mobSpawnExecutor.start();
+            }
+            // Pufferfish end
