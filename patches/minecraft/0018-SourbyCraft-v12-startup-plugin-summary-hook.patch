From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Sun, 14 Jun 2026 21:10:47 +0700
Subject: [PATCH] SourbyCraft v12 startup plugin summary hook


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 3ae59fbf5d1caf26cff93f42b64ebcfb3f7e868b..66906a24547cf0d5a8383ea4e052b6c20bf3303e 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -194,6 +194,8 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     public static final Logger LOGGER = LogUtils.getLogger();
     public static final net.kyori.adventure.text.logger.slf4j.ComponentLogger COMPONENT_LOGGER = net.kyori.adventure.text.logger.slf4j.ComponentLogger.logger(LOGGER.getName()); // Paper
     public static final String VANILLA_BRAND = "vanilla";
+    // SourbyCraft v12 — boot start nanos, initialized at class load for approximate boot duration
+    private static final long SOURBYCRAFT_BOOT_NANOS = System.nanoTime();
     private static final float AVERAGE_TICK_TIME_SMOOTHING = 0.8F;
     private static final int TICK_STATS_SPAN = 100;
     private static final long OVERLOADED_THRESHOLD_NANOS = 30L * TimeUtil.NANOSECONDS_PER_SECOND / 20L; // CraftBukkit
@@ -646,6 +648,10 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         }
         // Paper end - Configurable player collision; Handle collideRule team for player collision toggle
         this.server.enablePlugins(org.bukkit.plugin.PluginLoadOrder.POSTWORLD);
+        // SourbyCraft v12 — compact startup plugin summary
+        try { dev.iyanz.sourbycraft.brand.StartupPluginLog.printSummary(SOURBYCRAFT_BOOT_NANOS); }
+        catch (Throwable t) { LOGGER.warn("[SourbyCraft] StartupPluginLog failed: {}", t.toString()); }
+        // SourbyCraft v12 end
         this.server.spark.registerCommandBeforePlugins(this.server); // Paper - spark
         this.server.spark.enableAfterPlugins(this.server); // Paper - spark
         io.papermc.paper.command.brigadier.PaperCommands.INSTANCE.setValid(); // Paper - reset invalid state for event fire below
