From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Sat, 14 Jun 2026 15:30:00 +0700
Subject: [PATCH] SourbyCraft: defer POI worldgen updates via scheduleOnMain


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -2380,11 +2380,11 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
         Optional<Holder<PoiType>> newType = PoiTypes.forState(newState);
         if (!Objects.equals(oldType, newType)) {
             BlockPos immutable = pos.immutable();
-            oldType.ifPresent(poiType -> this.getServer().execute(() -> {
+            oldType.ifPresent(poiType -> this.getServer().scheduleOnMain(() -> { // SourbyCraft - defer POI updates via scheduleOnMain (worker threads trip main-thread guard)
                 this.getPoiManager().remove(immutable);
                 this.debugSynchronizers.dropPoi(immutable);
             }));
-            newType.ifPresent(poiType -> this.getServer().execute(() -> {
+            newType.ifPresent(poiType -> this.getServer().scheduleOnMain(() -> { // SourbyCraft - defer POI updates via scheduleOnMain (worker threads trip main-thread guard)
                 // Paper start - Remove stale POIs
                 if (oldType.isEmpty() && this.getPoiManager().exists(pos, _ -> true)) {
                     this.getPoiManager().remove(pos);
