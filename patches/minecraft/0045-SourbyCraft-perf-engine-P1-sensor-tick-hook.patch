From e3bd79a285644b5de32f692b1c501f0797ea3567 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Fri, 5 Jun 2026 22:39:42 +0700
Subject: [PATCH 33/35] SourbyCraft perf-engine P1 sensor tick hook

---
 net/minecraft/server/MinecraftServer.java | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index cc35c62..c322620 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1790,6 +1790,10 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         ProfilerFiller profiler = Profiler.get();
         this.getPlayerList().getPlayers().forEach(playerx -> playerx.connection.suspendFlushing());
         this.server.getScheduler().mainThreadHeartbeat(); // CraftBukkit
+        // SourbyCraft start - perf-engine P1 sensor tick (NMS-driven, main thread)
+        try { dev.iyanz.sourbycraft.perf.sensor.PerfSensor.tick(this); }
+        catch (Throwable t) { /* ignore - never fail tickChildren */ }
+        // SourbyCraft end - perf-engine P1 sensor tick
         // Paper start - optimise Folia entity scheduler
         ((io.papermc.paper.threadedregions.scheduler.FoliaGlobalRegionScheduler)org.bukkit.Bukkit.getGlobalRegionScheduler()).tick();
         for (io.papermc.paper.threadedregions.EntityScheduler scheduler : this.entitySchedulerTickList.getAllSchedulers()) {
