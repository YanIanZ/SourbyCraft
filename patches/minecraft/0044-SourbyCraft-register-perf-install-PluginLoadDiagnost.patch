From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <superwhisz@gmail.com>
Date: Fri, 19 Jun 2026 11:02:07 +0700
Subject: [PATCH] SourbyCraft register /perf + install PluginLoadDiagnostics


diff --git a/net/minecraft/server/dedicated/DedicatedServer.java b/net/minecraft/server/dedicated/DedicatedServer.java
index 8faf41d48c5127a068cdaa4f95458520f49af6a0..205478f5b9264bb7cccf02a33b8f8306e335900e 100644
--- a/net/minecraft/server/dedicated/DedicatedServer.java
+++ b/net/minecraft/server/dedicated/DedicatedServer.java
@@ -253,10 +253,11 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
         com.destroystokyo.paper.VersionHistoryManager.INSTANCE.getClass(); // Paper - load version history now
         dev.iyanz.sourbycraft.SourbyCraftConfig.init(new java.io.File("sourbycraft.yml")); // SourbyCraft - config
         dev.iyanz.sourbycraft.security.SourbyCraftSecurityConfig.init(new java.io.File("sourbycraft-security.yml")); // SourbyCraft - security config
+        dev.iyanz.sourbycraft.brand.PluginLoadDiagnostics.install(); // SourbyCraft - capture plugin load failures for /sys
         // SourbyCraft start - register custom commands at server boot (CraftServer#reload also registers, for /reload paths)
         {
             org.bukkit.command.CommandMap commandMap = this.server.getCommandMap();
-            String[] sourbycraftCommandNames = {"ping", "sys", "plugins", "tps", "tpsbar", "speedtest", "sparkview", "swm", "rambar", "ver"};
+            String[] sourbycraftCommandNames = {"ping", "sys", "plugins", "tps", "tpsbar", "speedtest", "sparkview", "swm", "rambar", "ver", "perf", "perfengine", "tuner"};
             java.util.Map<String, org.bukkit.command.Command> known = ((org.bukkit.command.SimpleCommandMap) commandMap).getKnownCommands();
             for (String n : sourbycraftCommandNames) {
                 known.remove(n.toLowerCase(java.util.Locale.ROOT));
@@ -272,7 +273,8 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
             commandMap.register("sourbycraft", new dev.iyanz.sourbycraft.command.SwmCommand("swm"));
             commandMap.register("sourbycraft", new dev.iyanz.sourbycraft.command.RamBarCommand("rambar"));
             commandMap.register("sourbycraft", new dev.iyanz.sourbycraft.command.VerCommand("ver"));
-            org.slf4j.LoggerFactory.getLogger("SourbyCraft").info("Registered 10 SourbyCraft commands (fallback prefix 'sourbycraft'). Use /sourbycraft:<name> if a name collides with Paper's built-ins.");
+            commandMap.register("sourbycraft", new dev.iyanz.sourbycraft.command.PerfCommand("perf"));
+            org.slf4j.LoggerFactory.getLogger("SourbyCraft").info("Registered 11 SourbyCraft commands (fallback prefix 'sourbycraft'). Use /sourbycraft:<name> if a name collides with Paper's built-ins.");
         }
         // SourbyCraft end - register custom commands at server boot
 
