From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Sat, 16 May 2026 18:12:37 +0700
Subject: [PATCH] Add item stacking, anti-snatch, antixray entity filter


diff --git a/net/minecraft/server/level/ServerEntity.java b/net/minecraft/server/level/ServerEntity.java
index 3a817c92147bb78c60238f3ddc1644b721aed7a2..db5342b179a3d8fd98b65276baea7487307aa53c 100644
--- a/net/minecraft/server/level/ServerEntity.java
+++ b/net/minecraft/server/level/ServerEntity.java
@@ -95,6 +95,13 @@ public class ServerEntity {
     // Paper end - fix desync when a player is added to the tracker
 
     public void sendChanges() {
+        // SourbyCraft start - entity obfuscation filter
+        if (this.level.chunkPacketBlockController instanceof io.papermc.paper.antixray.ChunkPacketBlockControllerAntiXray controller) {
+            this.trackedPlayers.removeIf(conn ->
+                !controller.isEntityVisibleTo(this.entity, conn.getPlayer())
+            );
+        }
+        // SourbyCraft end
         // Paper start - optimise collisions
         if (((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity)this.entity).moonrise$isHardColliding()) {
             this.teleportDelay = 9999;
diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index ac18e512b8fce848c8c13bc5ff9e93f85e026609..9ebc86e0f69ff822524dc47bf31f4afbb5a49b61 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -2708,6 +2708,12 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
     public ItemEntity drop(ItemStack droppedItem, boolean dropAround, boolean traceItem, boolean callEvent, java.util.function.@Nullable Consumer<org.bukkit.entity.Item> entityOperation) { // Paper - Extend dropItem API
         ItemEntity itemEntity = super.drop(droppedItem, dropAround, traceItem, callEvent, entityOperation); // Paper - Extend dropItem API
         ItemStack itemStack = itemEntity != null ? itemEntity.getItem() : ItemStack.EMPTY; // Paper - move up
+        // SourbyCraft start - anti-snatch
+        if (itemEntity != null && dev.iyanz.sourbycraft.SourbyCraftConfig.ownerProtectionEnabled) {
+            itemEntity.ownerUUID = this.getUUID();
+            itemEntity.pickupDelay = Math.min(dev.iyanz.sourbycraft.SourbyCraftConfig.ownerProtectionTime, 1638) * 20;
+        }
+        // SourbyCraft end
         if (traceItem) {
             if (!itemStack.isEmpty()) {
                 this.awardStat(Stats.ITEM_DROPPED.get(itemStack.getItem()), itemStack.getCount()); // Paper - use size from dropped item
diff --git a/net/minecraft/server/level/ServerPlayerGameMode.java b/net/minecraft/server/level/ServerPlayerGameMode.java
index 84d19d79e77cec6a5d64f59fbcce703e467b2407..9a196072ba7aa9dff6efc7a8d91e6e2c55c37774 100644
--- a/net/minecraft/server/level/ServerPlayerGameMode.java
+++ b/net/minecraft/server/level/ServerPlayerGameMode.java
@@ -415,6 +415,14 @@ public class ServerPlayerGameMode {
                 // CraftBukkit start
                 java.util.List<net.minecraft.world.entity.item.ItemEntity> itemsToDrop = this.level.captureDrops; // Paper - capture all item additions to the world
                 this.level.captureDrops = null; // Paper - capture all item additions to the world; Remove this earlier so that we can actually drop stuff
+                // SourbyCraft start - anti-snatch for block break drops
+                if (dev.iyanz.sourbycraft.SourbyCraftConfig.ownerProtectionEnabled) {
+                    for (net.minecraft.world.entity.item.ItemEntity item : itemsToDrop) {
+                        item.ownerUUID = this.player.getUUID();
+                        item.pickupDelay = Math.min(dev.iyanz.sourbycraft.SourbyCraftConfig.ownerProtectionTime, 1638) * 20;
+                    }
+                }
+                // SourbyCraft end
                 if (event.isDropItems()) {
                     org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockDropItemEvent(bblock, state, this.player, itemsToDrop); // Paper - capture all item additions to the world
                 }
diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 810104c881534931253b086be22a4c72752e4060..f5052386153a9ebdd350bba33ca28edf7279fb8d 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -4144,6 +4144,19 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
                 );
             }
 
+            // SourbyCraft start - anti-clip: push items out of blocks
+            if (itemEntity != null && !this.level().isClientSide()) {
+                try {
+                    net.minecraft.world.level.block.state.BlockState blockState = this.level().getBlockState(
+                        net.minecraft.core.BlockPos.containing(itemEntity.getX(), itemEntity.getY(), itemEntity.getZ())
+                    );
+                    if (!blockState.isAir() && !blockState.canBeReplaced()) {
+                        itemEntity.setPos(itemEntity.getX(), Math.ceil(itemEntity.getY()) + 0.5, itemEntity.getZ());
+                    }
+                } catch (Exception ignored) {}
+            }
+            // SourbyCraft end
+
             return itemEntity;
         }
     }
diff --git a/net/minecraft/world/entity/item/ItemEntity.java b/net/minecraft/world/entity/item/ItemEntity.java
index e82bb8f2d2b0e771dc371fd7e709116e1f5f204f..853bbd2dd0e7d7dda5eb8a845b746942b5aa157e 100644
--- a/net/minecraft/world/entity/item/ItemEntity.java
+++ b/net/minecraft/world/entity/item/ItemEntity.java
@@ -48,6 +48,8 @@ public class ItemEntity extends Entity implements TraceableEntity {
     public int age = 0;
     public int pickupDelay = 0;
     public int health = 5;
+    @Nullable
+    public UUID ownerUUID = null; // SourbyCraft - anti-snatch
     public @Nullable EntityReference<Entity> thrower;
     public @Nullable UUID target;
     public final float bobOffs = this.random.nextFloat() * (float) Math.PI * 2.0F;
@@ -267,7 +269,10 @@ public class ItemEntity extends Entity implements TraceableEntity {
 
     private boolean isMergable() {
         ItemStack item = this.getItem();
-        return this.isAlive() && this.pickupDelay != 32767 && this.age != -32768 && this.age < this.despawnRate && item.getCount() < item.getMaxStackSize(); // Paper - Alternative item-despawn-rate
+        // SourbyCraft start - unlimited drop stack (skip cap when enabled)
+        if (!dev.iyanz.sourbycraft.SourbyCraftConfig.unlimitedDropStack && item.getCount() >= item.getMaxStackSize()) return false;
+        // SourbyCraft end
+        return this.isAlive() && this.pickupDelay != 32767 && this.age != -32768 && this.age < this.despawnRate;
     }
 
     private void tryToMerge(ItemEntity itemEntity) {
@@ -283,19 +288,24 @@ public class ItemEntity extends Entity implements TraceableEntity {
     }
 
     public static boolean areMergable(ItemStack destinationStack, ItemStack originStack) {
-        return originStack.getCount() + destinationStack.getCount() <= originStack.getMaxStackSize()
-            && ItemStack.isSameItemSameComponents(destinationStack, originStack);
+        if (!dev.iyanz.sourbycraft.SourbyCraftConfig.unlimitedDropStack) {
+            if (originStack.getCount() + destinationStack.getCount() > originStack.getMaxStackSize()) return false;
+        } else if (dev.iyanz.sourbycraft.SourbyCraftConfig.dropStackCap != Integer.MAX_VALUE) {
+            if (originStack.getCount() + destinationStack.getCount() > dev.iyanz.sourbycraft.SourbyCraftConfig.dropStackCap) return false;
+        }
+        return ItemStack.isSameItemSameComponents(destinationStack, originStack);
     }
 
     public static ItemStack merge(ItemStack destinationStack, ItemStack originStack, int amount) {
-        int min = Math.min(Math.min(destinationStack.getMaxStackSize(), amount) - destinationStack.getCount(), originStack.getCount());
+        int min = Math.min(Math.max(0, amount - destinationStack.getCount()), originStack.getCount()); // SourbyCraft - dynamic cap, guard negative
         ItemStack itemStack = destinationStack.copyWithCount(destinationStack.getCount() + min);
         originStack.shrink(min);
         return itemStack;
     }
 
     private static void merge(ItemEntity destinationEntity, ItemStack destinationStack, ItemStack originStack) {
-        ItemStack itemStack = merge(destinationStack, originStack, 64);
+        int cap = dev.iyanz.sourbycraft.SourbyCraftConfig.unlimitedDropStack ? dev.iyanz.sourbycraft.SourbyCraftConfig.dropStackCap : originStack.getMaxStackSize();
+        ItemStack itemStack = merge(destinationStack, originStack, cap);
         destinationEntity.setItem(itemStack);
     }
 
@@ -306,8 +316,21 @@ public class ItemEntity extends Entity implements TraceableEntity {
         }
         // CraftBukkit end
         merge(destinationEntity, destinationStack, originStack);
+        // SourbyCraft start - save pre-merge counts for owner resolution
+        int destBefore = destinationStack.getCount();
+        int origBefore = originStack.getCount();
+        // SourbyCraft end
         destinationEntity.pickupDelay = Math.max(destinationEntity.pickupDelay, originEntity.pickupDelay);
         destinationEntity.age = Math.min(destinationEntity.age, originEntity.age);
+        // SourbyCraft start - anti-snatch owner merge
+        if (destinationEntity.ownerUUID == null) {
+            destinationEntity.ownerUUID = originEntity.ownerUUID;
+        } else if (originEntity.ownerUUID != null && !originEntity.ownerUUID.equals(destinationEntity.ownerUUID)) {
+            if (origBefore > destBefore) {
+                destinationEntity.ownerUUID = originEntity.ownerUUID;
+            }
+        }
+        // SourbyCraft end
         if (originStack.isEmpty()) {
             originEntity.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.MERGE); // CraftBukkit - add Bukkit remove cause
         }
@@ -364,6 +387,7 @@ public class ItemEntity extends Entity implements TraceableEntity {
         output.putShort("Health", (short)this.health);
         output.putShort("Age", (short)this.age);
         output.putShort("PickupDelay", (short)this.pickupDelay);
+        output.storeNullable("SourbycraftOwner", UUIDUtil.CODEC, this.ownerUUID);
         EntityReference.store(this.thrower, output, "Thrower");
         output.storeNullable("Owner", UUIDUtil.CODEC, this.target);
         if (!this.getItem().isEmpty()) {
@@ -381,6 +405,7 @@ public class ItemEntity extends Entity implements TraceableEntity {
         this.health = input.getShortOr("Health", (short)5);
         this.age = input.getShortOr("Age", (short)0);
         this.pickupDelay = input.getShortOr("PickupDelay", (short)0);
+        this.ownerUUID = input.read("SourbycraftOwner", UUIDUtil.CODEC).orElse(null);
         this.target = input.read("Owner", UUIDUtil.CODEC).orElse(null);
         this.thrower = EntityReference.read(input, "Thrower");
         this.setItem(input.read("Item", ItemStack.CODEC).orElse(ItemStack.EMPTY));
@@ -409,6 +434,15 @@ public class ItemEntity extends Entity implements TraceableEntity {
             int remaining = count - canHold;
             boolean flyAtPlayer = false; // Paper
 
+            // SourbyCraft start - anti-snatch owner protection
+            final boolean ownerBypass = dev.iyanz.sourbycraft.SourbyCraftConfig.ownerProtectionEnabled && this.ownerUUID != null && this.pickupDelay > 0;
+            if (ownerBypass) {
+                if (!entity.getUUID().equals(this.ownerUUID)) {
+                    return; // block non-owner during protection
+                }
+                this.pickupDelay = 0; // owner bypass — allow immediate pickup
+            }
+            // SourbyCraft end
             // Paper start - PlayerAttemptPickupItemEvent
             if (this.pickupDelay <= 0) {
                 org.bukkit.event.player.PlayerAttemptPickupItemEvent attemptEvent = new org.bukkit.event.player.PlayerAttemptPickupItemEvent((org.bukkit.entity.Player) entity.getBukkitEntity(), (org.bukkit.entity.Item) this.getBukkitEntity(), remaining);
@@ -419,7 +453,11 @@ public class ItemEntity extends Entity implements TraceableEntity {
                     if (flyAtPlayer) {
                         entity.take(this, count);
                     }
-
+                    // SourbyCraft start - restore protection on cancel
+                    if (ownerBypass) {
+                        this.pickupDelay = Math.min(dev.iyanz.sourbycraft.SourbyCraftConfig.ownerProtectionTime, 1638) * 20;
+                    }
+                    // SourbyCraft end
                     return;
                 }
             }
