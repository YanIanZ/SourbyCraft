From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Mon, 15 Jun 2026 15:27:00 +0700
Subject: [PATCH] Make entity variant baby_asset_id optional (vanilla 1.21.11
 fallback)


diff --git a/net/minecraft/world/entity/animal/chicken/ChickenVariant.java b/net/minecraft/world/entity/animal/chicken/ChickenVariant.java
index 6eae595d176f591db1c4a18aa433656845e1abee..7b2af90c56189e6f41fa0a39183e387592f26826 100644
--- a/net/minecraft/world/entity/animal/chicken/ChickenVariant.java
+++ b/net/minecraft/world/entity/animal/chicken/ChickenVariant.java
@@ -23,17 +23,17 @@ public record ChickenVariant(
     public static final Codec<ChickenVariant> DIRECT_CODEC = RecordCodecBuilder.create(
         i -> i.group(
                 ModelAndTexture.codec(ChickenVariant.ModelType.CODEC, ChickenVariant.ModelType.NORMAL).forGetter(ChickenVariant::modelAndTexture),
-                ClientAsset.ResourceTexture.CODEC.fieldOf("baby_asset_id").forGetter(ChickenVariant::babyTexture),
+                ClientAsset.ResourceTexture.CODEC.optionalFieldOf("baby_asset_id").forGetter(v -> java.util.Optional.ofNullable(v.babyTexture())),
                 SpawnPrioritySelectors.CODEC.fieldOf("spawn_conditions").forGetter(ChickenVariant::spawnConditions)
             )
-            .apply(i, ChickenVariant::new)
+            .apply(i, (mt, babyOpt, spawn) -> new ChickenVariant(mt, babyOpt.orElse(mt.asset()), spawn)) // SourbyCraft - default baby to adult
     );
     public static final Codec<ChickenVariant> NETWORK_CODEC = RecordCodecBuilder.create(
         i -> i.group(
                 ModelAndTexture.codec(ChickenVariant.ModelType.CODEC, ChickenVariant.ModelType.NORMAL).forGetter(ChickenVariant::modelAndTexture),
-                ClientAsset.ResourceTexture.CODEC.fieldOf("baby_asset_id").forGetter(ChickenVariant::babyTexture)
+                ClientAsset.ResourceTexture.CODEC.optionalFieldOf("baby_asset_id").forGetter(v -> java.util.Optional.ofNullable(v.babyTexture()))
             )
-            .apply(i, ChickenVariant::new)
+            .apply(i, (mt, babyOpt) -> new ChickenVariant(mt, babyOpt.orElse(mt.asset()))) // SourbyCraft - default baby to adult
     );
     public static final Codec<Holder<ChickenVariant>> CODEC = RegistryFixedCodec.create(Registries.CHICKEN_VARIANT);
     public static final StreamCodec<RegistryFriendlyByteBuf, Holder<ChickenVariant>> STREAM_CODEC = ByteBufCodecs.holderRegistry(Registries.CHICKEN_VARIANT);
