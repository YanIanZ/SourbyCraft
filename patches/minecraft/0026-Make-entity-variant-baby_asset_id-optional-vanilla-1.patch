diff --git a/net/minecraft/world/entity/animal/feline/CatVariant.java b/net/minecraft/world/entity/animal/feline/CatVariant.java
index 2b652f855e206fc097028c3657b37f140b40e31e..90e6f78b5f52eea02da22a85ba788b017db9ddd4 100644
--- a/net/minecraft/world/entity/animal/feline/CatVariant.java
+++ b/net/minecraft/world/entity/animal/feline/CatVariant.java
@@ -20,17 +20,17 @@ public record CatVariant(ClientAsset.ResourceTexture adultAssetInfo, ClientAsset
     public static final Codec<CatVariant> DIRECT_CODEC = RecordCodecBuilder.create(
         i -> i.group(
                 ClientAsset.ResourceTexture.DEFAULT_FIELD_CODEC.forGetter(CatVariant::adultAssetInfo),
-                ClientAsset.ResourceTexture.CODEC.fieldOf("baby_asset_id").forGetter(CatVariant::babyAssetInfo),
+                ClientAsset.ResourceTexture.CODEC.optionalFieldOf("baby_asset_id").forGetter(v -> java.util.Optional.ofNullable(v.babyAssetInfo())),
                 SpawnPrioritySelectors.CODEC.fieldOf("spawn_conditions").forGetter(CatVariant::spawnConditions)
             )
-            .apply(i, CatVariant::new)
+            .apply(i, (adult, babyOpt, spawn) -> new CatVariant(adult, babyOpt.orElse(adult), spawn)) // SourbyCraft - default baby to adult when missing (vanilla 1.21.11 JSON lacks baby_asset_id)
     );
     public static final Codec<CatVariant> NETWORK_CODEC = RecordCodecBuilder.create(
         i -> i.group(
                 ClientAsset.ResourceTexture.DEFAULT_FIELD_CODEC.forGetter(CatVariant::adultAssetInfo),
-                ClientAsset.ResourceTexture.CODEC.fieldOf("baby_asset_id").forGetter(CatVariant::babyAssetInfo)
+                ClientAsset.ResourceTexture.CODEC.optionalFieldOf("baby_asset_id").forGetter(v -> java.util.Optional.ofNullable(v.babyAssetInfo()))
             )
-            .apply(i, CatVariant::new)
+            .apply(i, (adult, babyOpt) -> new CatVariant(adult, babyOpt.orElse(adult))) // SourbyCraft - default baby to adult
     );
     public static final Codec<Holder<CatVariant>> CODEC = RegistryFixedCodec.create(Registries.CAT_VARIANT);
     public static final StreamCodec<RegistryFriendlyByteBuf, Holder<CatVariant>> STREAM_CODEC = ByteBufCodecs.holderRegistry(Registries.CAT_VARIANT);
