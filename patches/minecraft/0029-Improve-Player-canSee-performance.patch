Subject: [PATCH] Improve Player#canSee performance


diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index 42ec67c..bec7ae2 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -1376,7 +1376,7 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
                     && ChunkMap.this.isChunkTracked(player, this.entity.chunkPosition().x(), this.entity.chunkPosition().z());
                 // Paper end - Configurable entity tracking range by Y
                 // CraftBukkit start - respect vanish API
-                if (visibleToPlayer && !player.getBukkitEntity().canSee(this.entity.getBukkitEntity())) { // Paper - only consider hits
+                if (visibleToPlayer && !player.getBukkitEntity().canSee(this.entity)) { // Paper - only consider hits // SourbyCraft - improve Player#canSee performance
                     visibleToPlayer = false;
                 }
                 // CraftBukkit end
