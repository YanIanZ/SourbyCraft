From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Mon, 15 Jun 2026 15:30:06 +0700
Subject: [PATCH] SourbyCraft v12 US import particles batch-1 gated emit


diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 06a6d4ca7285cb7b2d25afadfc12720dc3280f18..8805b65cc681b0ff27ef31fca90a70a827042659 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -2211,9 +2211,11 @@ public abstract class Entity
                 );
         }
 
+        final boolean waterSplashOff = dev.iyanz.sourbycraft.SourbyCraftConfig.ymlBool("particles.disableWaterSplashParticles", false); // SourbyCraft - US import
         for (int i = 0; i < 1.0F + this.dimensions.width() * 20.0F; i++) {
             double xo = (this.random.nextDouble() * 2.0 - 1.0) * this.dimensions.width();
             double zo = (this.random.nextDouble() * 2.0 - 1.0) * this.dimensions.width();
+            if (!waterSplashOff) // SourbyCraft - US import
             this.level().addParticle(ParticleTypes.SPLASH, this.getX() + xo, yt + 1.0F, this.getZ() + zo, movement.x, movement.y, movement.z);
         }
 
diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 828381a121ed8c07612bfddd7cf4f19315b21e78..4029568edb4f7b758d8f032ad804cd0989edc6d3 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -1030,6 +1030,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             .filter(MobEffectInstance::isVisible)
             .map(MobEffectInstance::getParticleOptions)
             .toList();
+        if (dev.iyanz.sourbycraft.SourbyCraftConfig.ymlBool("particles.disableEffectParticles", false)) visibleEffectParticles = java.util.List.of(); // SourbyCraft - US import
         this.entityData.set(DATA_EFFECT_PARTICLES, visibleEffectParticles);
         this.entityData.set(DATA_EFFECT_AMBIENCE_ID, areAllEffectsAmbient(this.activeEffects.values()));
     }
diff --git a/net/minecraft/world/entity/player/Player.java b/net/minecraft/world/entity/player/Player.java
index 5d4b3ed09fe10f545d0720b2919f0d6c822d5196..f1651b0567369c5efce25f2ea95939cb8dd8978d 100644
--- a/net/minecraft/world/entity/player/Player.java
+++ b/net/minecraft/world/entity/player/Player.java
@@ -1282,6 +1282,7 @@ public abstract class Player extends Avatar implements ContainerUser {
 
             double dx = -Mth.sin(this.getYRot() * Mth.DEG_TO_RAD);
             double dz = Mth.cos(this.getYRot() * Mth.DEG_TO_RAD);
+            if (!dev.iyanz.sourbycraft.SourbyCraftConfig.ymlBool("particles.disableNewCombatParticles", false)) // SourbyCraft - US import
             serverLevel.sendParticles(ParticleTypes.SWEEP_ATTACK, this.getX() + dx, this.getY(0.5), this.getZ() + dz, 0, dx, 0.0, dz, 0.0);
         }
     }
diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index 9286d9bcf3ec4069e77d3133f3d7bf29b2370c5a..125dad0e695e8a49094ed7db576479b0c33b1667 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -1228,7 +1228,9 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
         }
         // Paper end - BlockDestroyEvent
         if (playEffect && !(blockState.getBlock() instanceof BaseFireBlock)) { // Paper - BlockDestroyEvent
+            if (!dev.iyanz.sourbycraft.SourbyCraftConfig.ymlBool("particles.disableBlockBreakParticles", false)) { // SourbyCraft - US import
             this.levelEvent(LevelEvent.PARTICLES_DESTROY_BLOCK, pos, Block.getId(effectType)); // Paper - BlockDestroyEvent
+            } // SourbyCraft - US import
         }
 
         if (dropResources) {
