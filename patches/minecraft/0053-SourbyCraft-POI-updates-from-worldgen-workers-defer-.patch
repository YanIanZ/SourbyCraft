From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Sat, 6 Jun 2026 20:14:41 +0700
Subject: [PATCH] SourbyCraft: POI updates from worldgen workers defer via
 scheduleOnMain


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index d3d85729cccd089559dac08930b0cebb39f7fcad..229c052ce4d39fdf2ac498efe1f0872c8f73973c 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -2371,11 +2371,14 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
         Optional<Holder<PoiType>> optional1 = PoiTypes.forState(newState);
         if (!Objects.equals(optional, optional1)) {
             BlockPos blockPos = pos.immutable();
-            optional.ifPresent(holder -> this.getServer().execute(() -> {
+            // SourbyCraft 12-EXP - Moonrise treats chunk-gen workers as tick threads, so getServer().execute()
+            // runs inline on the worker and trips PoiManager's strict main-thread guard. Force-defer to main
+            // via scheduleOnMain so POI writes happen on the real server thread.
+            optional.ifPresent(holder -> this.getServer().scheduleOnMain(() -> {
                 this.getPoiManager().remove(blockPos);
                 this.debugSynchronizers.dropPoi(blockPos);
             }));
-            optional1.ifPresent(holder -> this.getServer().execute(() -> {
+            optional1.ifPresent(holder -> this.getServer().scheduleOnMain(() -> {
                 // Paper start - Remove stale POIs
                 if (optional.isEmpty() && this.getPoiManager().exists(blockPos, ignored -> true)) {
                     this.getPoiManager().remove(blockPos);
