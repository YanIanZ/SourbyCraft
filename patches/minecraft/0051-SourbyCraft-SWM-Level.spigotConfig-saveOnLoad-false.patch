From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Sat, 20 Jun 2026 15:19:11 +0700
Subject: [PATCH] SourbyCraft SWM Level.spigotConfig saveOnLoad=false


diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index 22fe9732ffdbcd996ec21225e805a9e27768694d..1ce2889f191f23ac46159a145e2cd510e736b12a 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -850,7 +850,10 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
         this.sectionsCount = this.maxSectionY - this.minSectionY + 1;
         // Paper end - getblock optimisations - cache world height/sections
         final org.bukkit.NamespacedKey worldKey = CraftNamespacedKey.fromMinecraft(dimension.identifier()); // Paper
-        this.spigotConfig = new org.spigotmc.SpigotWorldConfig(bukkitName, worldKey); // Spigot
+        // SourbyCraft - SWM disk-IO opt-out: SpigotWorldConfig.init() saves
+        // spigot.yml on every world load; flag SLI worlds so the save is skipped.
+        // ASP dev/26.2 parity.
+        this.spigotConfig = new org.spigotmc.SpigotWorldConfig(bukkitName, worldKey, !(this instanceof dev.iyanz.sourbycraft.swm.server.SlimeLevelInstance)); // Spigot // SourbyCraft
         this.paperConfig = paperWorldConfigCreator.apply(this.spigotConfig); // Paper - create paper world config
         this.generator = generator;
         this.world = new CraftWorld((ServerLevel) this, worldKey, biomeProvider, environment);
