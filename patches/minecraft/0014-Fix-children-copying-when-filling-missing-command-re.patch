From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Sun, 14 Jun 2026 20:59:56 +0700
Subject: [PATCH] Fix children copying when filling missing command redirects


diff --git a/net/minecraft/commands/Commands.java b/net/minecraft/commands/Commands.java
index d210f991366796d84e947df0a057c1adc62824f8..8951fcd22533f59b69b58b1a7a8d50a5551d785d 100644
--- a/net/minecraft/commands/Commands.java
+++ b/net/minecraft/commands/Commands.java
@@ -539,6 +539,14 @@ public class Commands {
     private static <S> void fillUsableCommands(
         final java.util.Collection<CommandNode<S>> children, final CommandNode<S> target, final S commandFilter, final Map<CommandNode<S>, CommandNode<S>> converted // Paper - Perf: Async command map building; pass copy of children
     ) {
+        // SourbyCraft start - support filling builders
+        fillUsableCommands(children, target::addChild, commandFilter, converted);
+    }
+
+    private static <S> void fillUsableCommands(
+        final java.util.Collection<CommandNode<S>> children, final java.util.function.Consumer<CommandNode<S>> target, final S commandFilter, final Map<CommandNode<S>, CommandNode<S>> converted // Paper - Perf: Async command map building; pass copy of children
+    ) {
+        // SourbyCraft end - support filling builders
         for (CommandNode<S> child : children) { // Paper - Perf: Async command map building; pass copy of children
             // Paper start - Brigadier API
             if (child.clientNode != null) {
@@ -575,10 +583,9 @@ public class Commands {
                     if (redirect.getCommand() != null) {
                         redirectBuilder.executes(redirect.getCommand());
                     }
-                    // Diff copied from LiteralCommand#createBuilder
-                    for (final CommandNode<S> redirectChild : redirect.getChildren()) {
-                        redirectBuilder.then(redirectChild);
-                    }
+                    // SourbyCraft start - don't blindly copy children over
+                    fillUsableCommands(redirect.getChildren(), redirectBuilder::then, commandFilter, converted);
+                    // SourbyCraft end - don't blindly copy children over
 
                     builder = redirectBuilder;
                 }
@@ -589,7 +596,7 @@ public class Commands {
 
                 CommandNode<S> node = builder.build();
                 converted.put(child, node);
-                target.addChild(node);
+                target.accept(node); // SourbyCraft - support filling builders
                 if (!child.getChildren().isEmpty()) {
                     fillUsableCommands(child.getChildren(), node, commandFilter, converted); // Paper - Perf: Async command map building; pass copy of children
                 }
