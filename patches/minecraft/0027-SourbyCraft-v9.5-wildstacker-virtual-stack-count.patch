+    // SourbyCraft start - v9.5 wildstacker helpers
+    public long sourbycraft$effectiveCount() {
+        long n = this.sourbycraftStackCount;
+        return n > 0 ? n : this.getItem().getCount();
+    }
+
+    public void sourbycraft$setStackCount(long count) {
+        if (count <= 0) {
+            this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DESPAWN);
+            return;
+        }
+        this.sourbycraftStackCount = count;
+        sourbycraft$updateDisplayName();
+    }
+
+    private void sourbycraft$updateDisplayName() {
+        long n = this.sourbycraft$effectiveCount();
+        if (n > this.getItem().getMaxStackSize()) {
+            net.minecraft.network.chat.Component displayName = net.minecraft.network.chat.Component.literal("")
+                .append(this.getItem().getItemName())
+                .append(net.minecraft.network.chat.Component.literal(" ×" + n));
+            this.setCustomName(displayName);
+            this.setCustomNameVisible(true);
+        }
+    }
+    // SourbyCraft end - v9.5 wildstacker helpers
