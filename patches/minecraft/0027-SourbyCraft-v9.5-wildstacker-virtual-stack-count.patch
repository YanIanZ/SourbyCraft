@@ -267,10 +271,33 @@ public class ItemEntity extends Entity implements TraceableEntity {
 
     private boolean isMergable() {
         ItemStack item = this.getItem();
+        // SourbyCraft start - v9.5 wildstacker: wildstacker entities are always mergable (physical count can be full)
+        if (dev.iyanz.sourbycraft.SourbyCraftConfig.wildstackerEnabled) {
+            return this.isAlive() && this.pickupDelay != 32767 && this.age != -32768 && this.age < this.despawnRate; // Paper - Alternative item-despawn-rate
+        }
+        // SourbyCraft end - v9.5 wildstacker
         return this.isAlive() && this.pickupDelay != 32767 && this.age != -32768 && this.age < this.despawnRate && item.getCount() < item.getMaxStackSize(); // Paper - Alternative item-despawn-rate
     }
 
     private void tryToMerge(ItemEntity itemEntity) {
+        // SourbyCraft start - v9.5 wildstacker bypass maxStackSize cap
+        if (dev.iyanz.sourbycraft.SourbyCraftConfig.wildstackerEnabled) {
+            ItemStack mineStack = this.getItem();
+            ItemStack theirStack = itemEntity.getItem();
+            if (!Objects.equals(this.target, itemEntity.target)) return;
+            if (!ItemStack.isSameItemSameComponents(mineStack, theirStack)) return;
+            if (!org.bukkit.craftbukkit.event.CraftEventFactory.callItemMergeEvent(itemEntity, this)) return;
+            long combined = this.sourbycraft$effectiveCount() + itemEntity.sourbycraft$effectiveCount();
+            int newPhysicalCount = (int) Math.min(combined, mineStack.getMaxStackSize());
+            mineStack.setCount(newPhysicalCount);
+            this.sourbycraftStackCount = combined;
+            this.pickupDelay = Math.max(this.pickupDelay, itemEntity.pickupDelay);
+            this.age = Math.min(this.age, itemEntity.age);
+            this.sourbycraft$updateDisplayName();
+            itemEntity.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.MERGE);
+            return;
+        }
+        // SourbyCraft end - v9.5 wildstacker
         ItemStack item = this.getItem();
         ItemStack item1 = itemEntity.getItem();
         if (Objects.equals(this.target, itemEntity.target) && areMergable(item, item1)) {
@@ -369,6 +396,11 @@ public class ItemEntity extends Entity implements TraceableEntity {
