+            // SourbyCraft start - v9.5 wildstacker partial pickup
+            if (dev.iyanz.sourbycraft.SourbyCraftConfig.wildstackerEnabled
+                && this.sourbycraftStackCount > 0L
+                && this.sourbycraftStackCount > this.getItem().getCount()
+                && this.pickupDelay == 0
+                && (this.target == null || this.target.equals(entity.getUUID()))) {
+                ItemStack mineStack = this.getItem();
+                int physicalCount = mineStack.getCount();
+                int beforeInv = entity.getInventory().countItem(mineStack.getItem());
+                if (entity.getInventory().add(mineStack.copy())) {
+                    int afterInv = entity.getInventory().countItem(mineStack.getItem());
+                    int actuallyTook = afterInv - beforeInv;
+                    if (actuallyTook > 0) {
+                        long sacRemaining = this.sourbycraftStackCount - actuallyTook;
+                        entity.take(this, actuallyTook);
+                        entity.awardStat(Stats.ITEM_PICKED_UP.get(item1), actuallyTook);
