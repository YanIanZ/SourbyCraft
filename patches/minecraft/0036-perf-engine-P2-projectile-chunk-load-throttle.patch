From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <superwhisz@gmail.com>
Date: Wed, 17 Jun 2026 17:05:00 +0700
Subject: [PATCH] SourbyCraft perf-engine P2 projectile chunk-load throttle

Caps projectile chunk-load fan-out per tick and per-projectile via
the LAG_MACHINE_MAX_PROJECTILE_LOADS_PER_TICK and
LAG_MACHINE_MAX_PROJECTILE_LOADS_PER_PROJECTILE knobs. Counter resets
each server tick from MinecraftServer.tickChildren so the cap is a
rate limit, not a budget.

Projectile.tick() is the chosen hook because every entity-type
chunk-load (arrows, eggs, snowballs, fish hooks, etc.) routes
through it via super.tick(). Over-limit projectiles get discarded
before the chunk-load fans out, blocking the classic snowball /
fish-hook lag-machine pattern.

diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index c12287c..b6c407d 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1805,6 +1805,10 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         try { dev.iyanz.sourbycraft.perf.sensor.PerfSensor.tick(this); }
         catch (Throwable t) { /* ignore - never fail tickChildren */ }
         // SourbyCraft end - perf-engine P1 sensor tick
+        // SourbyCraft start - perf-engine P2 lag-machine: reset per-tick counters
+        try { dev.iyanz.sourbycraft.perf.LagMachineCounters.resetTickCounters(); }
+        catch (Throwable t) { /* never fail tickChildren */ }
+        // SourbyCraft end - perf-engine P2 lag-machine
         // Paper start - optimise Folia entity scheduler
         ((io.papermc.paper.threadedregions.scheduler.FoliaGlobalRegionScheduler)org.bukkit.Bukkit.getGlobalRegionScheduler()).tick();
         for (io.papermc.paper.threadedregions.EntityScheduler scheduler : this.entitySchedulerTickList.getAllSchedulers()) {
diff --git a/net/minecraft/world/entity/projectile/Projectile.java b/net/minecraft/world/entity/projectile/Projectile.java
index 9af4bf7..de1bc08 100644
--- a/net/minecraft/world/entity/projectile/Projectile.java
+++ b/net/minecraft/world/entity/projectile/Projectile.java
@@ -43,6 +43,8 @@ public abstract class Projectile extends Entity implements TraceableEntity {
     public boolean leftOwner = false;
     private boolean leftOwnerChecked;
     public boolean hasBeenShot = false;
+    // SourbyCraft - perf-engine P2 lag-machine: per-projectile chunk-load counter
+    public int sourbyLoadsByProjectile = 0;
     private @Nullable Entity lastDeflectedBy;
     protected boolean hitCancelled = false; // CraftBukkit

@@ -99,6 +101,23 @@ public abstract class Projectile extends Entity implements TraceableEntity {

     @Override
     public void tick() {
+        // SourbyCraft start - perf-engine P2 lag-machine: projectile chunk-load throttle
+        {
+            final int perTickMax = dev.iyanz.sourbycraft.perf.knob.Knobs.LAG_MACHINE_MAX_PROJECTILE_LOADS_PER_TICK.get();
+            final int perProjMax = dev.iyanz.sourbycraft.perf.knob.Knobs.LAG_MACHINE_MAX_PROJECTILE_LOADS_PER_PROJECTILE.get();
+            if (perTickMax > 0 &&
+                dev.iyanz.sourbycraft.perf.LagMachineCounters.projectileChunkLoadsThisTick() >= perTickMax) {
+                this.discard();
+                return;
+            }
+            if (perProjMax > 0 && this.sourbyLoadsByProjectile >= perProjMax) {
+                this.discard();
+                return;
+            }
+            dev.iyanz.sourbycraft.perf.LagMachineCounters.incrementProjectileChunkLoad();
+            this.sourbyLoadsByProjectile++;
+        }
+        // SourbyCraft end - perf-engine P2 lag-machine
         if (!this.hasBeenShot) {
             this.gameEvent(GameEvent.PROJECTILE_SHOOT, this.getOwner());
             this.hasBeenShot = true;
