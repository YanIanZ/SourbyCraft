Subject: [PATCH] sourbycraft File Patches


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index dc65503a2d785d64d37b76b0303f51cf66d9769a..4d9cc8818178f005b1e497c18bd319e2f1e44f89 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -205,6 +205,8 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
     private final PortalForcer portalForcer;
     private final LevelTicks<Block> blockTicks = new LevelTicks<>(this::isPositionTickingWithEntitiesLoaded);
     private final LevelTicks<Fluid> fluidTicks = new LevelTicks<>(this::isPositionTickingWithEntitiesLoaded);
+    // SourbyCraft - fluid anti-flood per-chunk spread counter
+    public final it.unimi.dsi.fastutil.longs.Long2IntOpenHashMap fluidSpreadCounts = new it.unimi.dsi.fastutil.longs.Long2IntOpenHashMap();
     private final PathTypeCache pathTypesByPosCache = new PathTypeCache();
     final Set<Mob> navigatingMobs = new ObjectOpenHashSet<>();
     volatile boolean isUpdatingNavigations;
@@ -747,6 +749,7 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
     }
 
     public void tick(BooleanSupplier hasTimeLeft) {
+        this.fluidSpreadCounts.clear(); // SourbyCraft - reset fluid anti-flood counters
         ProfilerFiller profilerFiller = Profiler.get();
         this.handlingTick = true;
         TickRateManager tickRateManager = this.tickRateManager();
diff --git a/net/minecraft/world/level/material/FlowingFluid.java b/net/minecraft/world/level/material/FlowingFluid.java
index 85e9ec8061fc01d39977f6db314da14b1e7725e1..fdc4916387bbe72ea6c8e2e5cc333936e79c2525 100644
--- a/net/minecraft/world/level/material/FlowingFluid.java
+++ b/net/minecraft/world/level/material/FlowingFluid.java
@@ -45,6 +45,8 @@ public abstract class FlowingFluid extends Fluid {
         return map;
     });
     private final Map<FluidState, VoxelShape> shapes = Maps.newIdentityHashMap();
+    // SourbyCraft - reusable spread map (main-thread only)
+    private final java.util.EnumMap<Direction, FluidState> reusableSpreadMap = new java.util.EnumMap<>(Direction.class);
 
     // Paper start - fluid method optimisations
     private FluidState sourceFalling;
@@ -406,7 +408,15 @@ public abstract class FlowingFluid extends Fluid {
 
     protected Map<Direction, FluidState> getSpread(ServerLevel level, BlockPos pos, BlockState state) {
         int i = 1000;
-        Map<Direction, FluidState> map = Maps.newEnumMap(Direction.class);
+        // SourbyCraft start - reuse spread map
+        Map<Direction, FluidState> map;
+        if (gg.pufferfish.pufferfish.PufferfishConfig.fluidReuseSpreadMap) {
+            map = this.reusableSpreadMap;
+            map.clear();
+        } else {
+            map = Maps.newEnumMap(Direction.class);
+        }
+        // SourbyCraft end
         FlowingFluid.SpreadContext spreadContext = null;
 
         for (Direction direction : Direction.Plane.HORIZONTAL) {
@@ -477,6 +487,33 @@ public abstract class FlowingFluid extends Fluid {
 
     @Override
     public void tick(ServerLevel level, BlockPos pos, BlockState state, FluidState fluidState) {
+        // SourbyCraft start - anti-flood
+        if (gg.pufferfish.pufferfish.PufferfishConfig.fluidAntiFloodEnabled) {
+            long chunkKey = net.minecraft.world.level.ChunkPos.asLong(pos);
+            int count = level.fluidSpreadCounts.addTo(chunkKey, 1) + 1;
+            if (count > gg.pufferfish.pufferfish.PufferfishConfig.fluidAntiFloodMaxPerChunk) {
+                level.scheduleTick(pos, fluidState.getType(), gg.pufferfish.pufferfish.PufferfishConfig.fluidDistanceCutoffDelay);
+                return;
+            }
+        }
+        // SourbyCraft end
+        // SourbyCraft start - distance cutoff
+        if (gg.pufferfish.pufferfish.PufferfishConfig.fluidDistanceCutoffEnabled) {
+            int range = gg.pufferfish.pufferfish.PufferfishConfig.fluidDistanceCutoffRange;
+            double rangeSq = (double) range * range;
+            boolean playerNear = false;
+            for (net.minecraft.server.level.ServerPlayer p : level.players()) {
+                if (p.distanceToSqr(pos.getX() + 0.5, pos.getY() + 0.5, pos.getZ() + 0.5) <= rangeSq) {
+                    playerNear = true;
+                    break;
+                }
+            }
+            if (!playerNear) {
+                level.scheduleTick(pos, fluidState.getType(), gg.pufferfish.pufferfish.PufferfishConfig.fluidDistanceCutoffDelay);
+                return;
+            }
+        }
+        // SourbyCraft end
         if (!fluidState.isSource()) {
             FluidState newLiquid = this.getNewLiquid(level, pos, level.getBlockState(pos));
             int spreadDelay = this.getSpreadDelay(level, pos, fluidState, newLiquid);
diff --git a/net/minecraft/world/level/material/LavaFluid.java b/net/minecraft/world/level/material/LavaFluid.java
index a42878c191445ba4b0d50dd2b789a132d5cf6a3e..0e19112269200b51cc21c26935a92095bb2101de 100644
--- a/net/minecraft/world/level/material/LavaFluid.java
+++ b/net/minecraft/world/level/material/LavaFluid.java
@@ -165,7 +165,9 @@ public abstract class LavaFluid extends FlowingFluid {
 
     @Override
     public int getSlopeFindDistance(LevelReader level) {
-        return isFastLava(level) ? 4 : 2;
+        int base = isFastLava(level) ? 4 : 2; // SourbyCraft
+        int cfg = gg.pufferfish.pufferfish.PufferfishConfig.fluidSlopeFindDistance; // SourbyCraft
+        return cfg == -1 ? base : Math.min(base, cfg); // SourbyCraft
     }
 
     @Override
@@ -190,7 +192,8 @@ public abstract class LavaFluid extends FlowingFluid {
 
     @Override
     public int getTickDelay(LevelReader level) {
-        return isFastLava(level) ? 10 : 30;
+        int base = isFastLava(level) ? 10 : 30; // SourbyCraft
+        return (int) Math.ceil(base * gg.pufferfish.pufferfish.PufferfishConfig.fluidTickDelayMultiplier); // SourbyCraft
     }
 
     @Override
