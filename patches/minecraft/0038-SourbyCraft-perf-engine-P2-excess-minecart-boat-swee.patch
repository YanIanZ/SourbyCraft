+                java.util.List<AbstractMinecart> siblings = this.level().getEntitiesOfClass(AbstractMinecart.class, chunkBox, e -> true);
+                if (siblings.size() > limit) {
+                    int myId = this.getId();
+                    int rank = 0;
+                    for (AbstractMinecart other : siblings) {
