             // re-set mob counts
             for (ServerPlayer player : this.level.players()) {
                 // Paper start - per player mob spawning backoff
@@ -552,10 +560,22 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
                 }
                 // Paper end - per player mob spawning backoff
             }
+            // perPlayerMobSpawns: createState calls updatePlayerMobTypeMap which writes player.mobCounts[] — main-thread only; no async here.
             spawnCookie = NaturalSpawner.createState(chunkCount, this.level.getAllEntities(), this::getFullChunk, null, true);
-        } else {
+        } else if (!dev.iyanz.sourbycraft.SourbyCraftConfig.asyncSpawning) {
