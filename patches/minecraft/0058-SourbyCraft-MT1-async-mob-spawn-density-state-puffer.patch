+            }
         }
+        // SourbyCraft MT1 end - async mob-spawn density state
         // Paper end - Optional per player mob spawns
         this.lastSpawnState = spawnCookie;
         boolean doMobSpawning = this.level.getGameRules().get(GameRules.SPAWN_MOBS) && !this.level.players().isEmpty(); // CraftBukkit
@@ -595,6 +615,58 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
             spawningChunks.clear();
         }
 
+        // SourbyCraft MT1 start - submit next createState off-main (pufferfish async spawning semantics)
+        // Only for non-perPlayer path: perPlayerMobSpawns writes player.mobCounts[] during createState and must stay on main.
+        if (!sourbyUsePerPlayer && dev.iyanz.sourbycraft.SourbyCraftConfig.asyncSpawning) {
+            CompletableFuture<Void> existingTask = this.sourbyAsyncSpawnTask;
+            if (existingTask == null || existingTask.isDone()) {
+                // Snapshot entity list on main thread (the accepted cost: entity copy is far cheaper than the full createState scan).
+                // Entity reads (blockPosition, type, spawnReason) from off-thread are mildly racy with main-thread mutation,
+                // but one-tick-stale mob density is the accepted pufferfish trade-off.
+                final ArrayList<Entity> entitySnapshot = new ArrayList<>();
+                for (Entity e : this.level.getAllEntities()) {
+                    entitySnapshot.add(e);
+                }
+                final int capturedChunkCount = chunkCount;
+                // Capture perPlayerMobSpawns so LocalMobCapCalculator construction is decided on main.
+                // getPlayersCloseForSpawning (called from LocalMobCapCalculator.addMob during createState) reads
+                // NearbyPlayers; this is a READ-only operation against a moonrise structure and is accepted as
+                // mildly racy (same trade-off pufferfish makes) — worst case: one-tick-stale per-player spawn counts.
+                final boolean capturedNotPerPlayer = !this.level.paperConfig().entities.spawning.perPlayerMobSpawns;
+                final ChunkMap capturedChunkMap = this.chunkMap;
+                // getFullChunk reads ConcurrentChainedLong2ReferenceHashTable — thread-safe.
+                final NaturalSpawner.ChunkGetter capturedChunkGetter = this::getFullChunk;
+                final CompletableFuture<Void> task = new CompletableFuture<>();
+                this.sourbyAsyncSpawnTask = task;
+                dev.iyanz.sourbycraft.util.VirtualExecutor.run(() -> {
+                    try {
+                        NaturalSpawner.SpawnState computed = NaturalSpawner.createState(
+                            capturedChunkCount,
+                            entitySnapshot,
+                            capturedChunkGetter,
+                            capturedNotPerPlayer ? new LocalMobCapCalculator(capturedChunkMap) : null,
+                            false
+                        );
+                        this.sourbyAsyncSpawnState = computed;
+                    } catch (Throwable t) {
+                        this.sourbyAsyncSpawnState = null;
+                        long now = System.nanoTime();
+                        if (now - this.sourbyAsyncSpawnFailLog >= 60_000_000_000L) {
+                            this.sourbyAsyncSpawnFailLog = now;
+                            LOGGER.warn("[SourbyCraft] async mob-spawn state computation failed; reverting to sync next tick", t);
+                        }
+                    } finally {
+                        task.complete(null);
+                    }
+                });
+            }
+            // previous task still in flight → keep last state (backpressure, silent).
+            // Note: the cached SpawnState was mutated by this tick's spawn loop (afterSpawn accumulates
+            // mob counts); reusing it makes spawn decisions progressively MORE conservative until a fresh
+            // state lands. Under-spawning while the server is CPU-bound is the accepted pufferfish trade-off.
+        }
+        // SourbyCraft MT1 end - submit next createState off-main
+
         profiler.popPush("tickTickingChunks");
         this.iterateTickingChunksFaster(); // Paper - chunk tick iteration optimizations
         if (doMobSpawning) {
