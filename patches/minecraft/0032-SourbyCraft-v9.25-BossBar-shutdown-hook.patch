From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Thu, 28 May 2026 12:17:11 +0700
Subject: [PATCH] SourbyCraft v9.25 BossBar shutdown hook

Call BossBarTicker.shutdownAll() from MinecraftServer.stopServer()
before playerList.saveAll() so hideBossBar packets are sent while
players are still connected. Prevents bossbar persisting on client
across server restart.

diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 121826d55fd8c423a8ff657ac42a5bf1e9401fa9..08bf4d10e75ca39e3f9e0b6b45445bfb55e8a000 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1030,6 +1030,10 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         if (io.papermc.paper.plugin.PluginInitializerManager.instance().pluginRemapper != null) io.papermc.paper.plugin.PluginInitializerManager.instance().pluginRemapper.shutdown(); // Paper - Plugin remapping
         this.getConnection().stop();
         this.isSaving = true;
+        // SourbyCraft start - v9.25 hide all SourbyCraft bossbars before players disconnect
+        try { dev.iyanz.sourbycraft.command.BossBarTicker.shutdownAll(); }
+        catch (Throwable t) { /* ignore */ }
+        // SourbyCraft end - v9.25 bossbar shutdown
         if (this.playerList != null) {
             LOGGER.info("Saving players");
             this.playerList.saveAll();
