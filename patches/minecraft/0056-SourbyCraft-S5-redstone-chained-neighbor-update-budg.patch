From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Sun, 5 Jul 2026 05:44:50 +0700
Subject: [PATCH] SourbyCraft S5: redstone chained-neighbor-update budget from
 entity.max-redstone-updates-per-tick


diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index 171c05a61c33bedf4997b33bc75a77ac4b95e5a2..24d6a99230ecfd94bfd5dec522b2ad75325de246 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -872,7 +872,11 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
         this.thread = Thread.currentThread();
         this.biomeManager = new BiomeManager(this, biomeZoomSeed);
         this.isDebug = isDebug;
-        this.neighborUpdater = new CollectingNeighborUpdater(this, maxChainedNeighborUpdates);
+        // SourbyCraft S5 - entity.max-redstone-updates-per-tick caps the chained neighbor-update budget
+        this.neighborUpdater = new CollectingNeighborUpdater(this,
+            dev.iyanz.sourbycraft.SourbyCraftConfig.maxRedstoneUpdatesPerTick > 0
+                ? Math.min(maxChainedNeighborUpdates, dev.iyanz.sourbycraft.SourbyCraftConfig.maxRedstoneUpdatesPerTick)
+                : maxChainedNeighborUpdates);
         this.registryAccess = registryAccess;
         this.palettedContainerFactory = PalettedContainerFactory.create(registryAccess);
         this.damageSources = new DamageSources(registryAccess);
