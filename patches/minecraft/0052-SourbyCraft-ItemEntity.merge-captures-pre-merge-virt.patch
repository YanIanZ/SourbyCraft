From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Sat, 6 Jun 2026 19:02:12 +0700
Subject: [PATCH] SourbyCraft: ItemEntity.merge captures pre-merge virtuals for
 Wildstacker


diff --git a/net/minecraft/world/entity/item/ItemEntity.java b/net/minecraft/world/entity/item/ItemEntity.java
index d5931d9baae9f4130feab32ee492b9aec78dd49a..fa457fe8155d381cc2321df35bb9e7e564bfb0a8 100644
--- a/net/minecraft/world/entity/item/ItemEntity.java
+++ b/net/minecraft/world/entity/item/ItemEntity.java
@@ -317,6 +317,16 @@ public class ItemEntity extends Entity implements TraceableEntity {
             return;
         }
         // CraftBukkit end
+        // SourbyCraft - capture pre-merge virtual counts BEFORE vanilla merge + origin discard
+        long preDestVirtual = 0L;
+        long preOriginVirtual = 0L;
+        try {
+            preDestVirtual = dev.iyanz.sourbycraft.wildstacker.WildstackerManager.getVirtualCount(
+                (org.bukkit.entity.Item) destinationEntity.getBukkitEntity());
+            preOriginVirtual = dev.iyanz.sourbycraft.wildstacker.WildstackerManager.getVirtualCount(
+                (org.bukkit.entity.Item) originEntity.getBukkitEntity());
+        } catch (Throwable t) { /* manager not started or entity not an Item; ignore */ }
+        // SourbyCraft end
         merge(destinationEntity, destinationStack, originStack);
         destinationEntity.pickupDelay = Math.max(destinationEntity.pickupDelay, originEntity.pickupDelay);
         destinationEntity.age = Math.min(destinationEntity.age, originEntity.age);
@@ -324,10 +334,11 @@ public class ItemEntity extends Entity implements TraceableEntity {
             originEntity.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.MERGE); // CraftBukkit - add Bukkit remove cause
         }
         // Removed delta movement zeroing to allow water to push items
-        // SourbyCraft - notify hologram manager after NMS merge
+        // SourbyCraft - notify hologram manager after NMS merge (pass pre-merge virtuals so overflow survives)
         try {
             dev.iyanz.sourbycraft.wildstacker.WildstackerManager.onMerged(
-                (org.bukkit.entity.Item) destinationEntity.getBukkitEntity());
+                (org.bukkit.entity.Item) destinationEntity.getBukkitEntity(),
+                preDestVirtual, preOriginVirtual);
         } catch (Throwable t) { /* manager not started or entity not an Item; ignore */ }
     }
 
