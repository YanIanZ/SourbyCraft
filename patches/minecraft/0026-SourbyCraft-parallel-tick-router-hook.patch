From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Wed, 27 May 2026 10:56:19 +0700
Subject: [PATCH] SourbyCraft parallel tick router hook

Hook EntityTickRouter into ServerLevel.tickNonPassenger and add
end-of-tick interact drain. When performance.v9.parallel-item-tick
(or orb/arrow) is on, item / exp orb / arrow entities are routed to
BatchPhysicsTicker. The physics phase is a noop (returns true =>
run interact on main), so behavior is identical to vanilla, but the
routing infrastructure is exercised end-to-end. Task 7 plugs in the
real physics phase (still noop in v9.3; real split deferred to v10).

diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index b3643986245e272cc8965d44083d32a5cbfea989..d3d85729cccd089559dac08930b0cebb39f7fcad 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -892,6 +892,19 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
 
         this.debugSynchronizers.tick(this.server.debugSubscribers());
         profilerFiller.pop();
+        // SourbyCraft start - v9 parallel tick interact drain
+        if (dev.iyanz.sourbycraft.SourbyCraftConfig.v9Enabled) {
+            dev.iyanz.sourbycraft.tick.BatchPhysicsTicker ticker =
+                dev.iyanz.sourbycraft.tick.BatchPhysicsTickers.peek();
+            if (ticker != null) {
+                ticker.drainDiffs(diff -> {
+                    if (diff.needsInteract()) {
+                        try { diff.entity().tick(); } catch (Throwable ignored) {}
+                    }
+                });
+            }
+        }
+        // SourbyCraft end
         this.environmentAttributes().invalidateTickCache();
     }
 
@@ -1359,7 +1372,25 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
     }
     // Paper end - log detailed entity tick information
 
+    // SourbyCraft start - v9 parallel tick router
     public void tickNonPassenger(Entity entity) {
+        if (dev.iyanz.sourbycraft.SourbyCraftConfig.v9Enabled) {
+            dev.iyanz.sourbycraft.tick.BatchPhysicsTicker ticker =
+                dev.iyanz.sourbycraft.tick.BatchPhysicsTickers.get();
+            boolean routed = dev.iyanz.sourbycraft.tick.EntityTickRouter.route(
+                entity, ticker,
+                dev.iyanz.sourbycraft.SourbyCraftConfig.v9ParallelItemTick,
+                dev.iyanz.sourbycraft.SourbyCraftConfig.v9ParallelOrbArrowTick,
+                dev.iyanz.sourbycraft.SourbyCraftConfig.v9ParallelOrbArrowTick,
+                () -> this.sourbycraft$tickInline(entity));
+            if (routed) return;
+            return; // inlineTick already ran inside route()
+        }
+        this.sourbycraft$tickInline(entity);
+    }
+
+    private void sourbycraft$tickInline(Entity entity) {
+    // SourbyCraft end
         // Paper start - log detailed entity tick information
         ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread("Cannot tick an entity off-main");
         try {
