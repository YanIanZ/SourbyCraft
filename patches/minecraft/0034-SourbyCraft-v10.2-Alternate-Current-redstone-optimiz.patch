From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Thu, 28 May 2026 13:17:24 +0700
Subject: [PATCH] SourbyCraft v10.2 Alternate Current redstone optimization
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Hook Level constructor to override paper's redstoneImplementation
to ALTERNATE_CURRENT when SourbyCraftConfig.redstoneAlternateCurrent
is enabled. Delegates to Paper's built-in AC algorithm (O(n) graph
propagation vs vanilla O(n²) flood-fill). Default OFF (experimental).

diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index de9c3d1a5724ee06e1461d8cdb6955945b4a09cc..2a0da2bd09cb42109b7e265e4d9b01c1abcf490a 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -847,6 +847,11 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
         // Paper end - getblock optimisations - cache world height/sections
         this.spigotConfig = new org.spigotmc.SpigotWorldConfig(((net.minecraft.world.level.storage.PrimaryLevelData) levelData).getLevelName()); // Spigot
         this.paperConfig = paperWorldConfigCreator.apply(this.spigotConfig); // Paper - create paper world config
+        // SourbyCraft start - v10.2 Alternate Current redstone optimization
+        if (dev.iyanz.sourbycraft.SourbyCraftConfig.redstoneAlternateCurrent) {
+            this.paperConfig.misc.redstoneImplementation = io.papermc.paper.configuration.WorldConfiguration.Misc.RedstoneImplementation.ALTERNATE_CURRENT;
+        }
+        // SourbyCraft end
         this.sourbycraftConfig = new dev.iyanz.sourbycraft.SourbyCraftWorldConfig((((net.minecraft.world.level.storage.PrimaryLevelData) levelData).getLevelName()), environment); // SourbyCraft - config
         this.generator = generator;
         this.world = new CraftWorld((ServerLevel) this, generator, biomeProvider, environment);
