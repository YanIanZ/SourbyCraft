From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Tue, 20 May 2026 00:00:00 +0700
Subject: [PATCH] SourbyCraft anti-clip and entity drop consolidation


diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 810104c881534931253b086be22a4c72752e4060..f5052386153a9ebdd350bba33ca28edf7279fb8d 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -4144,6 +4144,19 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
                 );
             }
 
+            // SourbyCraft start - anti-clip: push items out of blocks
+            if (itemEntity != null && !this.level().isClientSide()) {
+                try {
+                    net.minecraft.world.level.block.state.BlockState blockState = this.level().getBlockState(
+                        net.minecraft.core.BlockPos.containing(itemEntity.getX(), itemEntity.getY(), itemEntity.getZ())
+                    );
+                    if (!blockState.isAir() && !blockState.canBeReplaced()) {
+                        itemEntity.setPos(itemEntity.getX(), Math.ceil(itemEntity.getY()) + 0.5, itemEntity.getZ());
+                    }
+                } catch (Exception ignored) {}
+            }
+            // SourbyCraft end
+
             return itemEntity;
         }
     }
