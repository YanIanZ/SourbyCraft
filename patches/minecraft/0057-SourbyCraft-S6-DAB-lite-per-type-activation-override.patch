From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Sun, 5 Jul 2026 12:11:17 +0700
Subject: [PATCH] SourbyCraft S6: DAB-lite per-type activation overrides from
 dab.entity-overrides


diff --git a/io/papermc/paper/entity/activation/ActivationRange.java b/io/papermc/paper/entity/activation/ActivationRange.java
index f4673f9529d781d93a9644ddd83620f733b3b747..537d0a968c644b09a753d4670e90f5ad5e371a51 100644
--- a/io/papermc/paper/entity/activation/ActivationRange.java
+++ b/io/papermc/paper/entity/activation/ActivationRange.java
@@ -181,12 +181,43 @@ public final class ActivationRange {
                 entity.activatedTick = MinecraftServer.currentTick;
                 return;
             }
-            if (entity.activationType.boundingBox.intersects(entity.getBoundingBox())) {
+            net.minecraft.world.phys.AABB box = entity.activationType.boundingBox;
+            // SourbyCraft S6 - DAB-lite: dab.entity-overrides activation-dist-mod shrinks this type's effective range (floor ~4 blocks)
+            final int[] sourbyOverride = sourbyDabOverride(entity);
+            if (sourbyOverride != null && sourbyOverride[1] > 0) {
+                final double maxMod = (box.getXsize() - 8.0) / 2.0;
+                final double mod = Math.min((double) sourbyOverride[1], maxMod);
+                if (mod > 0) {
+                    box = box.deflate(mod, 0.0, mod);
+                }
+            }
+            if (box.intersects(entity.getBoundingBox())) {
                 entity.activatedTick = MinecraftServer.currentTick;
             }
         }
     }
 
+    // SourbyCraft S6 start - dab.entity-overrides: per-type {max-tick-freq, activation-dist-mod} (DAB-lite)
+    private static volatile java.util.Map<EntityType<?>, int[]> sourbyDabOverrides;
+
+    private static int[] sourbyDabOverride(final Entity entity) {
+        java.util.Map<EntityType<?>, int[]> map = sourbyDabOverrides;
+        if (map == null) {
+            final java.util.HashMap<EntityType<?>, int[]> built = new java.util.HashMap<>();
+            for (final java.util.Map.Entry<String, int[]> e : dev.iyanz.sourbycraft.SourbyCraftConfig.dabEntityOverrides.entrySet()) {
+                final java.util.Optional<EntityType<?>> type = EntityType.byString(e.getKey());
+                if (type.isPresent()) {
+                    built.put(type.get(), e.getValue());
+                } else {
+                    dev.iyanz.sourbycraft.util.SourbyLogger.warn("dab.entity-overrides: unknown entity type '" + e.getKey() + "'");
+                }
+            }
+            sourbyDabOverrides = map = java.util.Map.copyOf(built);
+        }
+        return map.isEmpty() ? null : map.get(entity.getType());
+    }
+    // SourbyCraft S6 end
+
     /**
      * If an entity is not in range, do some more checks to see if we should
      * give it a shot.
@@ -308,7 +339,13 @@ public final class ActivationRange {
 
         // Should this entity tick?
         if (!isActive) {
-            if ((MinecraftServer.currentTick - entity.activatedTick - 1) % 20 == 0) {
+            // SourbyCraft S6 - DAB-lite: dab.entity-overrides max-tick-freq stretches this type's inactive wakeup cadence (floor 20)
+            int sourbyCadence = 20;
+            final int[] sourbyOverride = sourbyDabOverride(entity);
+            if (sourbyOverride != null && sourbyOverride[0] > 20) {
+                sourbyCadence = sourbyOverride[0];
+            }
+            if ((MinecraftServer.currentTick - entity.activatedTick - 1) % sourbyCadence == 0) {
                 // SourbyCraft S2 - entity.tick-rate-limit: stretch inactive-entity cadence to entity.tick-rate
                 if (dev.iyanz.sourbycraft.SourbyCraftConfig.entityTickRateLimit) {
                     final int rate = dev.iyanz.sourbycraft.perf.knob.Knobs.ENTITY_TICK_RATE.get();
