From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Wed, 27 May 2026 17:56:47 +0700
Subject: [PATCH] SourbyCraft v9.11 wildstacker hologram + LOS guard


diff --git a/net/minecraft/world/entity/item/ItemEntity.java b/net/minecraft/world/entity/item/ItemEntity.java
index 54882b4e89f3e75f0255495c298c87d9bb57c4dc..d5558b9cd5701881fe16a8c9d9675b72cfde5330 100644
--- a/net/minecraft/world/entity/item/ItemEntity.java
+++ b/net/minecraft/world/entity/item/ItemEntity.java
@@ -57,6 +57,9 @@ public class ItemEntity extends Entity implements TraceableEntity {
     /** Virtual stack count for wildstacker merge. When > 0 it is authoritative; 0 means uninitialized → falls back to getItem().getCount(). */
     public long sourbycraftStackCount = 0L;
     // SourbyCraft end - v9.5 wildstacker
+    // SourbyCraft start - v9.11 wildstacker hologram TextDisplay passenger
+    private net.minecraft.world.entity.Display.TextDisplay sourbycraftHologram;
+    // SourbyCraft end - v9.11 wildstacker hologram
     public net.kyori.adventure.util.TriState frictionState = net.kyori.adventure.util.TriState.NOT_SET; // Paper - Friction API
 
     public ItemEntity(EntityType<? extends ItemEntity> type, Level level) {
@@ -286,6 +289,36 @@ public class ItemEntity extends Entity implements TraceableEntity {
             ItemStack theirStack = itemEntity.getItem();
             if (!Objects.equals(this.target, itemEntity.target)) return;
             if (!ItemStack.isSameItemSameComponents(mineStack, theirStack)) return;
+            // SourbyCraft start - v9.11 wildstacker LOS guard (prevents merging through walls/carpet/string)
+            if (dev.iyanz.sourbycraft.SourbyCraftConfig.wildstackerLosCheck) {
+                net.minecraft.world.phys.Vec3 from = new net.minecraft.world.phys.Vec3(
+                    this.getX(), this.getY() + 0.1, this.getZ());
+                net.minecraft.world.phys.Vec3 to = new net.minecraft.world.phys.Vec3(
+                    itemEntity.getX(), itemEntity.getY() + 0.1, itemEntity.getZ());
+                net.minecraft.world.level.ClipContext ctx = new net.minecraft.world.level.ClipContext(
+                    from, to,
+                    net.minecraft.world.level.ClipContext.Block.OUTLINE,
+                    net.minecraft.world.level.ClipContext.Fluid.NONE,
+                    net.minecraft.world.phys.shapes.CollisionContext.empty());
+                net.minecraft.world.phys.BlockHitResult hit = this.level().clip(ctx);
+                if (hit.getType() != net.minecraft.world.phys.HitResult.Type.MISS) {
+                    return; // A block sits between the items — refuse merge.
+                }
+                // Extra-safe: walk blocks along the line; catch non-outline blocks (tripwire string, carpet, snow_layer).
+                int steps = Math.max(2, (int) Math.ceil(from.distanceTo(to)));
+                for (int i = 1; i < steps; i++) {
+                    double t = (double) i / steps;
+                    double bx = from.x + (to.x - from.x) * t;
+                    double by = from.y + (to.y - from.y) * t;
+                    double bz = from.z + (to.z - from.z) * t;
+                    net.minecraft.core.BlockPos bp = net.minecraft.core.BlockPos.containing(bx, by, bz);
+                    net.minecraft.world.level.block.state.BlockState bs = this.level().getBlockState(bp);
+                    if (!bs.isAir()) {
+                        return; // Non-air block between items — refuse merge.
+                    }
+                }
+            }
+            // SourbyCraft end - v9.11 LOS guard
             if (!org.bukkit.craftbukkit.event.CraftEventFactory.callItemMergeEvent(itemEntity, this)) return;
             long combined = this.sourbycraft$effectiveCount() + itemEntity.sourbycraft$effectiveCount();
             int newPhysicalCount = (int) Math.min(combined, mineStack.getMaxStackSize());
@@ -579,8 +612,57 @@ public class ItemEntity extends Entity implements TraceableEntity {
             // SourbyCraft start - v9.5 wildstacker hologram: also set ItemStack CUSTOM_NAME so count shows in hover/inventory tooltip
             this.getItem().set(net.minecraft.core.component.DataComponents.CUSTOM_NAME, displayName);
             // SourbyCraft end - v9.5 wildstacker hologram
+            // SourbyCraft start - v9.11 wildstacker hologram TextDisplay
+            this.sourbycraft$ensureHologram(displayName);
+            // SourbyCraft end - v9.11 wildstacker hologram
+        } else {
+            // SourbyCraft start - v9.11 wildstacker hologram cleanup when count drops to normal
+            this.sourbycraft$removeHologram();
+            // SourbyCraft end - v9.11 wildstacker hologram cleanup
+        }
+    }
+
+    // SourbyCraft start - v9.11 wildstacker hologram TextDisplay passenger
+    private void sourbycraft$ensureHologram(net.minecraft.network.chat.Component text) {
+        if (!dev.iyanz.sourbycraft.SourbyCraftConfig.wildstackerHologram) return;
+        if (this.level().isClientSide()) return;
+        if (this.sourbycraftHologram == null || this.sourbycraftHologram.isRemoved()) {
+            net.minecraft.world.entity.Display.TextDisplay td =
+                new net.minecraft.world.entity.Display.TextDisplay(
+                    net.minecraft.world.entity.EntityType.TEXT_DISPLAY, this.level());
+            td.setPos(this.getX(), this.getY() + 0.55, this.getZ());
+            td.setBillboardConstraints(net.minecraft.world.entity.Display.BillboardConstraints.CENTER);
+            td.getEntityData().set(net.minecraft.world.entity.Display.TextDisplay.DATA_BACKGROUND_COLOR_ID, 0x40000000);
+            td.getEntityData().set(net.minecraft.world.entity.Display.TextDisplay.DATA_LINE_WIDTH_ID, 200);
+            td.setText(text);
+            try {
+                this.level().addFreshEntity(td);
+                td.startRiding(this, true, false);
+                this.sourbycraftHologram = td;
+            } catch (Throwable t) {
+                org.slf4j.LoggerFactory.getLogger("SourbyCraft:WildstackerHologram")
+                    .warn("Failed to spawn hologram for item {}: {}", this.getId(), t.toString());
+            }
+        } else {
+            this.sourbycraftHologram.setText(text);
+        }
+    }
+
+    private void sourbycraft$removeHologram() {
+        if (this.sourbycraftHologram != null && !this.sourbycraftHologram.isRemoved()) {
+            this.sourbycraftHologram.discard(null);
         }
+        this.sourbycraftHologram = null;
     }
+    // SourbyCraft end - v9.11 wildstacker hologram
+
+    @Override
+    public void remove(net.minecraft.world.entity.Entity.RemovalReason reason) {
+        // SourbyCraft - v9.11 cleanup hologram on any removal
+        this.sourbycraft$removeHologram();
+        super.remove(reason);
+    }
+
     // SourbyCraft end - v9.5 wildstacker helpers
 
     @Override
