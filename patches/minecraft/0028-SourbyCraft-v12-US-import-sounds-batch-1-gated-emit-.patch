@@ -239,6 +239,7 @@ public class Parrot extends ShoulderRidingEntity implements FlyingAnimal {
                 Mob mob = mobs.get(random.nextInt(mobs.size()));
                 if (!mob.isSilent()) {
                     SoundEvent soundEvent = getImitatedSound(mob.getType());
+                    if (!dev.iyanz.sourbycraft.SourbyCraftConfig.ymlBool("sounds.disableShoulderEntityAmbientSound", false)) // SourbyCraft - US import
                     level.playSound(null, entity.getX(), entity.getY(), entity.getZ(), soundEvent, entity.getSoundSource(), 0.7F, getPitch(random));
                     return true;
                 }
