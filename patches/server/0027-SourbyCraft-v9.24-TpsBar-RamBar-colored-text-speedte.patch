From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Thu, 28 May 2026 11:27:22 +0700
Subject: [PATCH] SourbyCraft v9.24 TpsBar/RamBar colored text + speedtest
 error log

- TpsBarCommand: Purpur-style HEADER/LABEL/DIM/SUCCESS/PRIMARY/DANGER colors
- RamBarCommand: same color treatment, value changes green->yellow->red
- SpeedtestCommand: error path logs full stack trace via SLF4J

diff --git a/src/main/java/dev/iyanz/sourbycraft/command/RamBarCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/RamBarCommand.java
index d26282e8022c5fd89061840c044d21f545908342..3cdba64b937b3a3b9d33e4dda9f1921f006c1e5b 100644
--- a/src/main/java/dev/iyanz/sourbycraft/command/RamBarCommand.java
+++ b/src/main/java/dev/iyanz/sourbycraft/command/RamBarCommand.java
@@ -73,11 +73,20 @@ public class RamBarCommand extends Command {
                 long total = rt.totalMemory();
                 long used = total - rt.freeMemory();
                 double pct = max == Long.MAX_VALUE ? (double) used / total : (double) used / max;
-                double progress = Math.min(pct, 1.0);
                 String maxLabel = max == Long.MAX_VALUE ? INFINITY : (max / 1048576) + "MB";
-                bar.progress((float) progress);
+                net.kyori.adventure.text.format.TextColor ramColor =
+                    pct < 0.5 ? SourbyCraftColors.SUCCESS :
+                    pct < 0.8 ? SourbyCraftColors.PRIMARY :
+                    SourbyCraftColors.DANGER;
+                bar.progress((float) Math.min(pct, 1.0));
                 bar.color(pct < 0.5 ? BossBar.Color.GREEN : pct < 0.8 ? BossBar.Color.YELLOW : BossBar.Color.RED);
-                bar.name(text(String.format("RAM: %d/%s (%.0f%%)", used / 1048576, maxLabel, pct * 100), SourbyCraftColors.VALUE));
+                bar.name(net.kyori.adventure.text.Component.text()
+                    .append(text("RAM ", SourbyCraftColors.HEADER))
+                    .append(text((used / 1048576) + "MB", ramColor))
+                    .append(text(" / ", SourbyCraftColors.DIM))
+                    .append(text(maxLabel, SourbyCraftColors.VALUE))
+                    .append(text(" (" + String.format("%.0f", pct * 100) + "%)", SourbyCraftColors.DIM))
+                    .build());
             } catch (Exception ignored) {}
         });
 
diff --git a/src/main/java/dev/iyanz/sourbycraft/command/SpeedtestCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/SpeedtestCommand.java
index ce31ae8a41570a7743b77581f1acfef7ca0fcb26..748532b011d51a7386f4822a9064cc4ea2b78370 100644
--- a/src/main/java/dev/iyanz/sourbycraft/command/SpeedtestCommand.java
+++ b/src/main/java/dev/iyanz/sourbycraft/command/SpeedtestCommand.java
@@ -46,7 +46,11 @@ public class SpeedtestCommand extends Command {
                         .append(text(String.format("%.0fms",pm),pm<30?SourbyCraftColors.SUCCESS:SourbyCraftColors.PRIMARY))
                         .append(text(" | "+sv.get("name")+", "+sv.get("location"),SourbyCraftColors.DIM)));
                 });
-            }catch(Exception e){s.sendMessage(text("Failed: "+e.getMessage(),SourbyCraftColors.DANGER));}
+            }catch(Exception e){
+                org.slf4j.LoggerFactory.getLogger("SourbyCraft:Speedtest").error(
+                    "Speedtest process failed: {}", e.toString(), e);
+                s.sendMessage(text("Speedtest failed: "+e.getMessage(),SourbyCraftColors.DANGER));
+            }
         });
         return true;
     }
diff --git a/src/main/java/dev/iyanz/sourbycraft/command/TpsBarCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/TpsBarCommand.java
index e8ee20b0105dbc4a5de81861994716945fd5817f..3fb49b4ea441837023be59798906b5d9db1e4d68 100644
--- a/src/main/java/dev/iyanz/sourbycraft/command/TpsBarCommand.java
+++ b/src/main/java/dev/iyanz/sourbycraft/command/TpsBarCommand.java
@@ -71,8 +71,18 @@ public class TpsBarCommand extends Command {
                 double mspt = Bukkit.getAverageTickTime();
                 double progress = Math.min(tps[0] / 20.0, 1.0);
                 bar.progress((float) progress);
+                net.kyori.adventure.text.format.TextColor tpsColor = tps[0] > 18 ?
+                    SourbyCraftColors.SUCCESS :
+                    (tps[0] > 15 ? SourbyCraftColors.PRIMARY : SourbyCraftColors.DANGER);
                 bar.color(tps[0] > 18 ? BossBar.Color.GREEN : tps[0] > 15 ? BossBar.Color.YELLOW : BossBar.Color.RED);
-                bar.name(text(String.format("TPS: %.1f  MSPT: %.1fms", tps[0], mspt), SourbyCraftColors.VALUE));
+                bar.name(net.kyori.adventure.text.Component.text()
+                    .append(text("TPS ", SourbyCraftColors.HEADER))
+                    .append(text(String.format("%.1f", tps[0]), tpsColor))
+                    .append(text(" │ ", SourbyCraftColors.DIM))
+                    .append(text("MSPT ", SourbyCraftColors.LABEL))
+                    .append(text(String.format("%.1fms", mspt),
+                        mspt < 40 ? SourbyCraftColors.SUCCESS : mspt < 50 ? SourbyCraftColors.PRIMARY : SourbyCraftColors.DANGER))
+                    .build());
             } catch (Exception ignored) {}
         });
 
