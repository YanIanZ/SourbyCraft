From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Mon, 15 Jun 2026 15:45:29 +0700
Subject: [PATCH] Improve Player#canSee performance


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index 2e95fee39..a43c4a3c3 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -2058,7 +2058,14 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
 
     @Override
     public boolean canSee(org.bukkit.entity.Entity entity) {
-        return this.equals(entity) || entity.isVisibleByDefault() ^ this.invertedVisibilityEntities.containsKey(entity.getUniqueId()); // SPIGOT-7312: Can always see self
+        // SourbyCraft start - improve Player#canSee performance
+        return this.canSee(((CraftEntity) entity).getHandle());
+    }
+
+    public boolean canSee(Entity entity) {
+        return this.entity == entity // SPIGOT-7312: Can always see self
+                || entity.visibleByDefault != this.invertedVisibilityEntities.containsKey(entity.getUUID());
+        // SourbyCraft end - improve Player#canSee performance
     }
 
     public boolean canSeePlayer(UUID uuid) {
