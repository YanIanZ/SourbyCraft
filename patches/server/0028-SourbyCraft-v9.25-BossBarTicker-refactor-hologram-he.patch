From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Thu, 28 May 2026 12:17:23 +0700
Subject: [PATCH] SourbyCraft v9.25 BossBarTicker refactor + hologram hex
 colors + cleanup

- BossBarTicker: stores BossBar instance per Tracked entry (3-arg register).
  New shutdownAll() hides all bars before server disconnects players.
  New isRegistered(uuid, bar) / unregister(uuid, bar) overloads.
- TpsBarCommand / RamBarCommand: use 3-arg register(uuid, bar, updater)
  and bar-specific unregister/isRegistered overloads.
- WildstackerManager.tickWorld: cleanup pass removes orphaned hologram
  entries when Item entity is invalid/dead (covers pickup, despawn, etc).
- WildstackerManager.refreshHologram: hex-colored Adventure Component
  via SourbyCraftColors (HEADER/DIM/VALUE) instead of plain text.

diff --git a/src/main/java/dev/iyanz/sourbycraft/command/BossBarTicker.java b/src/main/java/dev/iyanz/sourbycraft/command/BossBarTicker.java
index 53fea87e73b3af9590063cb39f9b5d457e2bb775..a42c6f872134ba321b6c3df81abadab2e08fd140 100644
--- a/src/main/java/dev/iyanz/sourbycraft/command/BossBarTicker.java
+++ b/src/main/java/dev/iyanz/sourbycraft/command/BossBarTicker.java
@@ -1,48 +1,106 @@
 package dev.iyanz.sourbycraft.command;
 
+import net.kyori.adventure.bossbar.BossBar;
 import org.bukkit.Bukkit;
 import org.bukkit.entity.Player;
 
+import java.util.List;
 import java.util.Map;
 import java.util.UUID;
 import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.CopyOnWriteArrayList;
 
 /**
  * NMS-driven BossBar tick driver. Called every 20 ticks from MinecraftServer.tickChildren.
  * Avoids Bukkit scheduler dependency on a plugin instance.
- * SourbyCraft v9.23
+ * SourbyCraft v9.25 — stores BossBar instance per tracked entry for shutdownAll() cleanup.
  */
 public final class BossBarTicker {
 
-    public record Tracked(UUID playerId, Runnable update) {}
+    /** Per-player tracked bossbar entry. */
+    public record Tracked(UUID playerId, BossBar bar, Runnable update) {}
 
-    private static final Map<UUID, Tracked> TICKERS = new ConcurrentHashMap<>();
+    // playerId -> list of tracked entries (supports multiple bars per player: tpsbar + rambar)
+    private static final Map<UUID, List<Tracked>> TICKERS = new ConcurrentHashMap<>();
     private static long tickCounter = 0;
 
-    public static void register(UUID playerId, Runnable update) {
-        TICKERS.put(playerId, new Tracked(playerId, update));
+    /**
+     * Register a bossbar updater for a player.
+     * Replaces any previous entry for the same (playerId, bar) pair.
+     * SourbyCraft v9.25 — 3-arg form stores the BossBar instance.
+     */
+    public static void register(UUID playerId, BossBar bar, Runnable update) {
+        TICKERS.computeIfAbsent(playerId, k -> new CopyOnWriteArrayList<>())
+            .removeIf(t -> t.bar() == bar); // avoid duplicates on re-register
+        TICKERS.get(playerId).add(new Tracked(playerId, bar, update));
     }
 
-    public static void unregister(UUID playerId) {
-        TICKERS.remove(playerId);
+    /**
+     * Unregister a specific bossbar for a player.
+     * Does NOT call hideBossBar — caller is responsible.
+     */
+    public static void unregister(UUID playerId, BossBar bar) {
+        List<Tracked> list = TICKERS.get(playerId);
+        if (list == null) return;
+        list.removeIf(t -> t.bar() == bar);
+        if (list.isEmpty()) TICKERS.remove(playerId);
     }
 
+    /**
+     * Unregister all bossbars for a player and hide them.
+     * Safe to call from any context (e.g. player quit handler).
+     */
+    public static void unregisterAll(UUID playerId) {
+        List<Tracked> list = TICKERS.remove(playerId);
+        if (list == null) return;
+        Player p = Bukkit.getPlayer(playerId);
+        if (p != null) list.forEach(t -> p.hideBossBar(t.bar()));
+    }
+
+    /**
+     * Returns true if the player has any active bossbar registered.
+     */
     public static boolean isRegistered(UUID playerId) {
-        return TICKERS.containsKey(playerId);
+        List<Tracked> list = TICKERS.get(playerId);
+        return list != null && !list.isEmpty();
+    }
+
+    /**
+     * Returns true if a specific BossBar is registered for the player.
+     */
+    public static boolean isRegistered(UUID playerId, BossBar bar) {
+        List<Tracked> list = TICKERS.get(playerId);
+        if (list == null) return false;
+        return list.stream().anyMatch(t -> t.bar() == bar);
+    }
+
+    /**
+     * Hide all registered bossbars for all online players, then clear registry.
+     * Called from MinecraftServer.stopServer to remove bars before client disconnects.
+     * SourbyCraft v9.25 — shutdown hook.
+     */
+    public static void shutdownAll() {
+        TICKERS.forEach((uuid, list) -> {
+            Player p = Bukkit.getPlayer(uuid);
+            if (p != null && p.isOnline()) {
+                list.forEach(t -> { try { p.hideBossBar(t.bar()); } catch (Throwable ignored) {} });
+            }
+        });
+        TICKERS.clear();
     }
 
     /** Called from MinecraftServer.tickChildren NMS hook — fires every server tick. */
     public static void tick() {
         tickCounter++;
         if (tickCounter % 20 != 0) return; // 1 update per second
-        for (Tracked t : TICKERS.values()) {
-            Player p = Bukkit.getPlayer(t.playerId());
+        TICKERS.forEach((uuid, list) -> {
+            Player p = Bukkit.getPlayer(uuid);
             if (p == null || !p.isOnline()) {
-                TICKERS.remove(t.playerId());
-                continue;
+                TICKERS.remove(uuid);
+                return;
             }
-            try { t.update().run(); } catch (Throwable ignored) {}
-        }
+            list.forEach(t -> { try { t.update().run(); } catch (Throwable ignored) {} });
+        });
     }
 
     private BossBarTicker() {}
