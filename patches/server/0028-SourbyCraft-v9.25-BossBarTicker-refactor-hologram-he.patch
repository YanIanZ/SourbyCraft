@@ -48,10 +48,11 @@ public class RamBarCommand extends Command {
 
         UUID uuid = target.getUniqueId();
 
-        if (BossBarTicker.isRegistered(uuid)) {
-            BossBar oldBar = bars.remove(uuid);
-            if (oldBar != null) target.hideBossBar(oldBar);
-            BossBarTicker.unregister(uuid);
+        BossBar existingBar = bars.get(uuid);
+        if (existingBar != null && BossBarTicker.isRegistered(uuid, existingBar)) {
+            bars.remove(uuid);
+            target.hideBossBar(existingBar);
+            BossBarTicker.unregister(uuid, existingBar);
             target.sendMessage(text("RAM Bar hidden", SourbyCraftColors.VALUE));
             return true;
         }
@@ -60,11 +61,11 @@ public class RamBarCommand extends Command {
         bars.put(uuid, bar);
         target.showBossBar(bar);
 
-        BossBarTicker.register(uuid, () -> {
+        BossBarTicker.register(uuid, bar, () -> {
             if (!target.isOnline()) {
                 BossBar b = bars.remove(uuid);
                 if (b != null) target.hideBossBar(b);
-                BossBarTicker.unregister(uuid);
+                BossBarTicker.unregister(uuid, b != null ? b : bar);
                 return;
             }
             try {
