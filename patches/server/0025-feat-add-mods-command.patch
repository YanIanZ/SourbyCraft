Subject: [PATCH] feat: add /mods command


diff --git a/src/main/java/dev/iyanz/sourbycraft/command/ModsCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/ModsCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..08d4d1170a117043c29a09b8699d0619e2ff43df
--- /dev/null
+++ b/src/main/java/dev/iyanz/sourbycraft/command/ModsCommand.java
@@ -0,0 +1,44 @@
+package dev.iyanz.sourbycraft.command;
+
+import dev.iyanz.sourbycraft.SourbyCraftColors;
+import dev.iyanz.sourbycraft.mod.ModScanner;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import java.util.List;
+import static net.kyori.adventure.text.Component.text;
+
+public class ModsCommand extends Command {
+    public ModsCommand(String name) {
+        super(name);
+        this.description = "Lists mods in the mods/ folder";
+        this.usageMessage = "/mods";
+        this.setPermission("sourbycraft.command.mods");
+    }
+    @Override
+    public boolean execute(CommandSender sender, String alias, String[] args) {
+        if (!this.testPermission(sender)) return true;
+        List<ModScanner.ModInfo> mods = ModScanner.scan();
+        if (mods.isEmpty()) {
+            sender.sendMessage(text("No mods found in mods/ folder", SourbyCraftColors.DIM));
+            return true;
+        }
+        String displayName = args.length > 0 ? args[0] : null;
+        if (displayName != null) {
+            mods.stream().filter(m -> m.name().toLowerCase().contains(displayName)).findFirst().ifPresentOrElse(
+                m -> sender.sendMessage(text()
+                    .append(text(m.name() + " v" + m.version(), SourbyCraftColors.VALUE))
+                    .append(text(" [" + m.id() + "]", SourbyCraftColors.DIM))),
+                () -> sender.sendMessage(text("Mod not found: " + displayName, SourbyCraftColors.DANGER))
+            );
+        } else {
+            sender.sendMessage(text("Mods (" + mods.size() + "):", SourbyCraftColors.HEADER));
+            for (ModScanner.ModInfo m : mods) {
+                sender.sendMessage(text()
+                    .append(text("  " + m.name(), SourbyCraftColors.VALUE))
+                    .append(text(" v" + m.version(), SourbyCraftColors.DIM))
+                    .append(text(" [" + m.id() + "]", SourbyCraftColors.DIM)));
+            }
+        }
+        return true;
+    }
+}
