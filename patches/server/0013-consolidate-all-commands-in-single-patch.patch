@@ -0,0 +1,23 @@
+package dev.iyanz.sourbycraft.command;
+import dev.iyanz.sourbycraft.SourbyCraftColors;
+import dev.iyanz.sourbycraft.util.BarUtil;
+import net.kyori.adventure.bossbar.BossBar;
+import org.bukkit.Bukkit;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.bukkit.entity.Player;
+import static net.kyori.adventure.text.Component.text;
+public class RamBarCommand extends Command {
+    private static BossBar bar;
+    public RamBarCommand(String n){super(n);this.description="BossBar RAM";this.usageMessage="/rambar";this.setPermission("sourbycraft.command.rambar");}
+    public boolean execute(CommandSender s,String a,String[] args){
+        if(!(s instanceof Player p)){s.sendMessage("Players only");return true;}
+        if(!testPermission(s))return true;
+        if(bar==null)bar=BossBar.bossBar(text("RAM",SourbyCraftColors.HEADER),0f,BossBar.Color.GREEN,BossBar.Overlay.PROGRESS);
+        Runtime rt=Runtime.getRuntime();long max=rt.maxMemory(),total=rt.totalMemory(),used=total-rt.freeMemory();double pct=max==Long.MAX_VALUE?(double)used/total:(double)used/max;String lbl=max==Long.MAX_VALUE?BarUtil.INFINITY:(max/1048576)+"MB";
+        bar.progress((float)Math.min(pct,1.0));bar.color(pct<0.5?BossBar.Color.GREEN:pct<0.8?BossBar.Color.YELLOW:BossBar.Color.RED);
+        bar.name(text(String.format("RAM: %d/%s (%.0f%%)",used/1048576,lbl,pct*100),SourbyCraftColors.VALUE));
+        p.showBossBar(bar);Bukkit.getScheduler().runTaskLater(Bukkit.getPluginManager().getPlugins()[0],()->p.hideBossBar(bar),200L);
+        return true;
+    }
+}
diff --git a/src/main/java/dev/iyanz/sourbycraft/command/SpeedtestCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/SpeedtestCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..21f830043d3ac899d30696d81b649fd12209ba9e
--- /dev/null
+++ b/src/main/java/dev/iyanz/sourbycraft/command/SpeedtestCommand.java
@@ -0,0 +1,26 @@
+package dev.iyanz.sourbycraft.command;
+import dev.iyanz.sourbycraft.SourbyCraftColors;
+import dev.iyanz.sourbycraft.util.BarUtil;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import java.io.*;
+import java.nio.file.*;
+import static net.kyori.adventure.text.Component.text;
+public class SpeedtestCommand extends Command {
+    private static final Path BIN=Paths.get("plugins/sourbycraft/speedtest-cli");
+    public SpeedtestCommand(String n){super(n);this.description="Ookla speedtest";this.usageMessage="/speedtest";this.setPermission("sourbycraft.command.speedtest");}
+    public boolean execute(CommandSender s,String a,String[] args){
+        if(!testPermission(s))return true;
+        if(!Files.exists(BIN)){try{Files.createDirectories(BIN.getParent());try(InputStream in=getClass().getClassLoader().getResourceAsStream("speedtest")){if(in!=null){Files.copy(in,BIN,StandardCopyOption.REPLACE_EXISTING);BIN.toFile().setExecutable(true);}}}catch(IOException e){}}
+        if(!Files.exists(BIN)){s.sendMessage(text("Speedtest unavailable",SourbyCraftColors.DANGER));return true;}
+        s.sendMessage(text("Running...",SourbyCraftColors.LABEL));
+        try{Process p=new ProcessBuilder(BIN.toString(),"--format=json","--accept-license","--accept-gdpr").redirectErrorStream(true).start();String o=new String(p.getInputStream().readAllBytes());p.waitFor();
+        var g=new com.google.gson.Gson();var r=g.fromJson(o,java.util.Map.class);var dl=(java.util.Map)r.get("download");var ul=(java.util.Map)r.get("upload");var ping=(java.util.Map)r.get("ping");var sv=(java.util.Map)r.get("server");
+        double dm=((Number)dl.get("bandwidth")).doubleValue()*8/1000000,um=((Number)ul.get("bandwidth")).doubleValue()*8/1000000,pm=((Number)ping.get("latency")).doubleValue();
+        s.sendMessage(text().append(text("DL: ",SourbyCraftColors.LABEL)).append(BarUtil.coloredBar(Math.min(dm/100,100),20)).append(text(String.format(" %.1f Mbps",dm),SourbyCraftColors.SUCCESS)));
+        s.sendMessage(text().append(text("UL: ",SourbyCraftColors.LABEL)).append(BarUtil.coloredBar(Math.min(um/50,100),20)).append(text(String.format(" %.1f Mbps",um),SourbyCraftColors.SUCCESS)));
+        s.sendMessage(text().append(text("Ping: ",SourbyCraftColors.LABEL)).append(text(String.format("%.0fms",pm),pm<30?SourbyCraftColors.SUCCESS:SourbyCraftColors.PRIMARY)).append(text(" | "+sv.get("name")+", "+sv.get("location"),SourbyCraftColors.DIM)));
+        }catch(Exception e){s.sendMessage(text("Failed: "+e.getMessage(),SourbyCraftColors.DANGER));}
+        return true;
+    }
+}
diff --git a/src/main/java/dev/iyanz/sourbycraft/command/SwmCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/SwmCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..08a665afc2aac744a97675682a6dcf1adbdd8da6
--- /dev/null
+++ b/src/main/java/dev/iyanz/sourbycraft/command/SwmCommand.java
@@ -0,0 +1,20 @@
+package dev.iyanz.sourbycraft.command;
+import dev.iyanz.sourbycraft.SourbyCraftColors;
+import dev.iyanz.sourbycraft.swm.SlimeWorldLoader;
+import dev.iyanz.sourbycraft.swm.SwmInstaller;
+import org.bukkit.Bukkit;
+import org.bukkit.WorldCreator;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import static net.kyori.adventure.text.Component.text;
+public class SwmCommand extends Command {
+    public SwmCommand(String n){super(n);this.description="SWM control";this.usageMessage="/swm <list|load|status>";this.setPermission("sourbycraft.command.swm");}
+    public boolean execute(CommandSender s,String a,String[] args){
+        if(!testPermission(s))return true;String sub=args.length>0?args[0].toLowerCase():"status";
+        switch(sub){
+            case "list":var w=SlimeWorldLoader.discoverWorlds();if(w.isEmpty()){s.sendMessage(text("No slime worlds",SourbyCraftColors.DIM));return true;}s.sendMessage(text("Slime Worlds ("+w.size()+"):",SourbyCraftColors.HEADER));for(var x:w)s.sendMessage(text().append(text("  "+x.worldName(),Bukkit.getWorld(x.worldName())!=null?SourbyCraftColors.SUCCESS:SourbyCraftColors.VALUE)).append(text(" v"+x.version(),SourbyCraftColors.DIM)).append(text(Bukkit.getWorld(x.worldName())!=null?" [LOADED]":"",SourbyCraftColors.SUCCESS)));break;
+            case "load":if(args.length<2){s.sendMessage(text("/swm load <world>",SourbyCraftColors.DIM));return true;}String nm=args[1];if(Bukkit.getWorld(nm)!=null){s.sendMessage(text("Already loaded",SourbyCraftColors.WARNING));return true;}s.sendMessage(text("Loading "+nm+"...",SourbyCraftColors.LABEL));Bukkit.getScheduler().runTask(Bukkit.getPluginManager().getPlugins()[0],()->{Bukkit.createWorld(WorldCreator.name(nm));s.sendMessage(text(nm+" loaded",SourbyCraftColors.SUCCESS));});break;
+            default:boolean in=SwmInstaller.isInstalled();s.sendMessage(text().append(text("SWM: ",SourbyCraftColors.LABEL)).append(text(in?"Installed":"Not installed",in?SourbyCraftColors.SUCCESS:SourbyCraftColors.DANGER)).append(text(" v"+dev.iyanz.sourbycraft.SourbyCraftConfig.swmVersion,SourbyCraftColors.DIM)));s.sendMessage(text().append(text("Worlds: ",SourbyCraftColors.LABEL)).append(text(SlimeWorldLoader.discoverWorlds().size()+" found",SourbyCraftColors.VALUE)));
+        }return true;
+    }
+}
diff --git a/src/main/java/dev/iyanz/sourbycraft/command/SysCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/SysCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..dffe689f526701490720938f6ce75d4a994e0f34
--- /dev/null
+++ b/src/main/java/dev/iyanz/sourbycraft/command/SysCommand.java
@@ -0,0 +1,30 @@
+package dev.iyanz.sourbycraft.command;
+import dev.iyanz.sourbycraft.SourbyCraftColors;
+import dev.iyanz.sourbycraft.util.BarUtil;
+import dev.iyanz.sourbycraft.swm.SwmInstaller;
+import org.bukkit.Bukkit;
+import org.bukkit.World;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import java.lang.management.ManagementFactory;
+import java.text.DecimalFormat;
+import java.util.Arrays;
+import static net.kyori.adventure.text.Component.text;
+public class SysCommand extends Command {
+    private static final DecimalFormat FMT = new DecimalFormat("########0.0");
+    public SysCommand(String name) { super(name); this.description="Server specs"; this.usageMessage="/sys"; this.setPermission("sourbycraft.command.sys"); }
+    public boolean execute(CommandSender s, String a, String[] args) {
+        if(!testPermission(s)) return true;
+        long u=ManagementFactory.getRuntimeMXBean().getUptime(),d=u/86400000,h=(u%86400000)/3600000,m=(u%3600000)/60000;
+        s.sendMessage(text().append(text("Uptime: ",SourbyCraftColors.LABEL)).append(text(d+"d "+h+"h "+m+"m",SourbyCraftColors.VALUE)));
+        try{oshi.SystemInfo si=new oshi.SystemInfo();var cpu=si.getHardware().getProcessor();s.sendMessage(text().append(text("CPU: ",SourbyCraftColors.LABEL)).append(text(cpu.getProcessorIdentifier().getName().trim()+" | "+cpu.getPhysicalProcessorCount()+"c/"+cpu.getLogicalProcessorCount()+"t | "+FMT.format(cpu.getSystemCpuLoad(1000)*100)+"%",SourbyCraftColors.VALUE)));}catch(NoClassDefFoundError e){}
+        Runtime rt=Runtime.getRuntime();long maxM=rt.maxMemory(),usedM=rt.totalMemory()-rt.freeMemory();double pct=maxM==Long.MAX_VALUE?(double)usedM/rt.totalMemory()*100:(double)usedM/maxM*100;String lbl=maxM==Long.MAX_VALUE?BarUtil.INFINITY:(maxM/1048576)+"MB";
+        s.sendMessage(text().append(text("RAM: ",SourbyCraftColors.LABEL)).append(BarUtil.coloredBar(pct,20)).append(text(" "+FMT.format(pct)+"% "+(usedM/1048576)+"/"+lbl,SourbyCraftColors.VALUE)));
+        s.sendMessage(text().append(text("Java: ",SourbyCraftColors.LABEL)).append(text(System.getProperty("java.version")+" ("+System.getProperty("java.vm.name")+")",SourbyCraftColors.VALUE)));
+        int rec=Math.max(3,(Runtime.getRuntime().availableProcessors()*3)/Math.max(1,Bukkit.getWorlds().size()));
+        for(World w:Bukkit.getWorlds()) s.sendMessage(text().append(text(w.getName()+": ",SourbyCraftColors.LABEL)).append(text(w.getLoadedChunks().length+" chunks",SourbyCraftColors.DIM)).append(text(" ~"+rec,SourbyCraftColors.SUCCESS)));
+        var pl=Bukkit.getPluginManager().getPlugins(); s.sendMessage(text().append(text("Plugins ("+pl.length+"): ",SourbyCraftColors.HEADER)).append(text(Arrays.stream(pl).map(p->p.getName()).reduce((a,b)->a+", "+b).orElse("none"),SourbyCraftColors.VALUE)));
+        s.sendMessage(text().append(text("SWM: ",SourbyCraftColors.LABEL)).append(text(SwmInstaller.isInstalled()?"Installed":"Not installed",SwmInstaller.isInstalled()?SourbyCraftColors.SUCCESS:SourbyCraftColors.DIM)));
+        return true;
+    }
+}
