From: Yan <Yan>
Date: Sat, 20 Jun 2026 19:52:54 +0700
Subject: [PATCH] =?UTF-8?q?SourbyCraft=20revert=20plugin-prewarm=20block?=
 =?UTF-8?q?=20=E2=80=94=20restore=20fire-and-forget=20(8s=20block=20added?=
 =?UTF-8?q?=20wall-clock)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit


diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index 73b7a92ae743dd6d39b1052b1dd528b365e9fa0c..d1e3e8e942be24e34f399b53cfa598e5d1e33d05 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -699,21 +699,13 @@ public final class CraftServer implements Server {
                         });
                     }
                     prewarm.shutdown();
-                    // BLOCK briefly until prewarm finishes so Paper's subsequent
-                    // sequential jar scan hits warm caches. 8s cap so a slow
-                    // disk doesn't block boot indefinitely; in practice 200
-                    // jars finish in 1-3s on virtual threads.
-                    try {
-                        boolean done = prewarm.awaitTermination(8, java.util.concurrent.TimeUnit.SECONDS);
-                        long elapsed = (System.nanoTime() - prewarmStart) / 1_000_000L;
-                        long mb = totalBytes.get() / (1024 * 1024);
-                        org.slf4j.LoggerFactory.getLogger("SourbyCraft").info(
-                            "[plugin-prewarm] " + jars.length + " jars, " + totalClasses.get() + " classes, "
-                                + mb + " MB decompressed in " + elapsed + "ms"
-                                + (done ? "" : " (timeout — continuing without full warm)"));
-                    } catch (InterruptedException ie) {
-                        Thread.currentThread().interrupt();
-                    }
+                    // Fire-and-forget. The block-up-to-8s variant added direct
+                    // wall-clock to boot — user-reported ran SLOWER than vanilla
+                    // even with all perf knobs ON. Race prewarm against Paper
+                    // scan instead — cache hits land naturally when prewarm
+                    // happens to win the race; misses cost no extra time.
+                    org.slf4j.LoggerFactory.getLogger("SourbyCraft").info(
+                        "[plugin-prewarm] dispatched " + jars.length + " jar(s) to virtual-thread pool (async, non-blocking)");
                 }
             }
         } catch (Throwable t) {
