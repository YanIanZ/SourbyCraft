From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Fri, 15 May 2026 01:29:34 +0700
Subject: [PATCH] fix: handle null parameterType in
 PaperReflection.parameterDescriptor

Prevents NPE when plugin reflection finds methods with
unresolvable/synthetic parameter types. Fixes PacketEvents
v2.12.1 compatibility with SourbyCraft.

diff --git a/src/main/java/io/papermc/paper/pluginremap/reflect/PaperReflection.java b/src/main/java/io/papermc/paper/pluginremap/reflect/PaperReflection.java
index 92bc8e4933ff13764fa2ac7f3729216332e202c9..260180ea61f9226054ea5c02c871a86403e33410 100644
--- a/src/main/java/io/papermc/paper/pluginremap/reflect/PaperReflection.java
+++ b/src/main/java/io/papermc/paper/pluginremap/reflect/PaperReflection.java
@@ -147,7 +147,9 @@ public final class PaperReflection extends AbstractDefaultRulesReflectionProxy i
         final StringBuilder builder = new StringBuilder();
         builder.append('(');
         for (final Class<?> parameterType : parameterTypes) {
-            builder.append(parameterType.descriptorString());
+            if (parameterType != null) {
+                builder.append(parameterType.descriptorString());
+            }
         }
         builder.append(')');
         return builder.toString();
