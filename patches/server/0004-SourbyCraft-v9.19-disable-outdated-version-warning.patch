From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Mon, 15 Jun 2026 15:45:30 +0700
Subject: [PATCH] SourbyCraft v9.19 disable outdated version warning


diff --git a/src/main/java/com/destroystokyo/paper/PaperVersionFetcher.java b/src/main/java/com/destroystokyo/paper/PaperVersionFetcher.java
index 602d3ce2c..252653b7c 100644
--- a/src/main/java/com/destroystokyo/paper/PaperVersionFetcher.java
+++ b/src/main/java/com/destroystokyo/paper/PaperVersionFetcher.java
@@ -65,6 +65,13 @@ public class PaperVersionFetcher implements VersionFetcher {
     }
 
     public static void getUpdateStatusStartupMessage() {
+        // SourbyCraft start - disable version check; SourbyCraft tag names don't match Paper's
+        // release format so the GitHub compare always reports a false-positive "outdated" warning.
+        // v9.19: suppress entirely — no network request, no warning.
+    }
+    @SuppressWarnings("unused")
+    private static void getUpdateStatusStartupMessage_disabled() {
+        // SourbyCraft end - disable version check
         int distance = DISTANCE_ERROR;
 
         final OptionalInt buildNumber = BUILD_INFO.buildNumber();
