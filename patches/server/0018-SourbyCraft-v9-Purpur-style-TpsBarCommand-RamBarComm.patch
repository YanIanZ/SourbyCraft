+    private static final Map<UUID, BossBar> bars = new ConcurrentHashMap<>();
+    private static final Map<UUID, Integer> tasks = new ConcurrentHashMap<>();
+    private static final String INFINITY = "∞";
+
+    public RamBarCommand(String n) {
+        super(n);
+        this.description = "Toggle RAM BossBar";
+        this.usageMessage = "/rambar [player]";
+        this.setPermission("sourbycraft.command.rambar");
+    }
+
+    @Override
+    public boolean execute(CommandSender sender, String label, String[] args) {
+        if (!testPermission(sender)) return true;
+        Player target;
+        if (args.length > 0) {
+            if (!sender.hasPermission("sourbycraft.command.rambar.others")) {
+                sender.sendMessage("No permission to toggle rambar for others");
+                return true;
+            }
+            target = Bukkit.getPlayer(args[0]);
+            if (target == null) {
+                sender.sendMessage("Player not found: " + args[0]);
+                return true;
+            }
+        } else if (sender instanceof Player p) {
+            target = p;
+        } else {
+            sender.sendMessage("Usage: /rambar <player>");
+            return true;
+        }
+
+        UUID uuid = target.getUniqueId();
+        BossBar oldBar = bars.remove(uuid);
+        Integer taskId = tasks.remove(uuid);
+
+        if (oldBar != null) {
+            target.hideBossBar(oldBar);
+            if (taskId != null) Bukkit.getScheduler().cancelTask(taskId);
+            target.sendMessage(text("RAM Bar hidden", SourbyCraftColors.VALUE));
+            return true;
+        }
+
+        final BossBar bar = BossBar.bossBar(text("RAM", SourbyCraftColors.HEADER), 0f, BossBar.Color.GREEN, BossBar.Overlay.PROGRESS);
+        bars.put(uuid, bar);
+
+        int task = Bukkit.getScheduler().scheduleSyncRepeatingTask(Bukkit.getPluginManager().getPlugins()[0], () -> {
+            if (!target.isOnline()) {
+                BossBar b = bars.remove(uuid);
+                Integer tid = tasks.remove(uuid);
+                if (b != null) target.hideBossBar(b);
+                if (tid != null) Bukkit.getScheduler().cancelTask(tid);
+                return;
+            }
+            try {
+                Runtime rt = Runtime.getRuntime();
+                long max = rt.maxMemory();
+                long total = rt.totalMemory();
+                long used = total - rt.freeMemory();
+                double pct = max == Long.MAX_VALUE ? (double) used / total : (double) used / max;
+                double progress = Math.min(pct, 1.0);
+                String maxLabel = max == Long.MAX_VALUE ? INFINITY : (max / 1048576) + "MB";
+                bar.progress((float) progress);
+                bar.color(pct < 0.5 ? BossBar.Color.GREEN : pct < 0.8 ? BossBar.Color.YELLOW : BossBar.Color.RED);
+                bar.name(text(String.format("RAM: %d/%s (%.0f%%)", used / 1048576, maxLabel, pct * 100), SourbyCraftColors.VALUE));
+            } catch (Exception ignored) {}
+        }, 0L, 20L);
+        tasks.put(uuid, task);
+
+        target.showBossBar(bar);
+        target.sendMessage(text("RAM Bar shown", SourbyCraftColors.VALUE));
         return true;
     }
 }
