From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Mon, 6 Jul 2026 03:58:24 +0700
Subject: [PATCH] SourbyCraft 26.2: antixray default-on resource-pack-proof +
 SWM /swm removal (survival)


diff --git a/src/main/java/io/papermc/paper/configuration/WorldConfiguration.java b/src/main/java/io/papermc/paper/configuration/WorldConfiguration.java
index d384e9d92a85a8de29ba7910626052e8d1c3a4f0..9fc8fbcb83f04e7de348b130b4934525bbb7770c 100644
--- a/src/main/java/io/papermc/paper/configuration/WorldConfiguration.java
+++ b/src/main/java/io/papermc/paper/configuration/WorldConfiguration.java
@@ -95,9 +95,14 @@ public class WorldConfiguration extends ConfigurationPart {
         public AntiXray antiXray;
 
         public class AntiXray extends ConfigurationPart {
-            public boolean enabled = false;
+            // SourbyCraft 26.2: anti-xray ON by default. HIDE (engine-mode 1) rewrites enclosed ores to
+            // stone/deepslate IN THE CHUNK PACKET, so the real ore data never reaches the client — a
+            // transparent-block ("x-ray") resource pack sees the replacement stone, not ore. Cave-exposed
+            // ores are handled by the SourbyCraft raytrace layer (antixray.raytrace). maxBlockHeight 320
+            // covers ores at every altitude (copper→y112, mountain emerald, deepslate→-64); vanilla 64 leaked them.
+            public boolean enabled = true;
             public EngineMode engineMode = EngineMode.HIDE;
-            public int maxBlockHeight = 64;
+            public int maxBlockHeight = 320;
             public int updateRadius = 2;
             public boolean lavaObscures = false;
             public boolean usePermission = false;
@@ -213,7 +218,7 @@ public class WorldConfiguration extends ConfigurationPart {
                 // SourbyCraft start - populate despawn time for existing entities on reload
                 net.minecraft.server.MinecraftServer.getServer().getAllLevels().forEach(level ->
                         level.getAllEntities().forEach(entity ->
-                                entity.despawnTime = entity.getType() == EntityType.PLAYER ? -1 :
+                                entity.despawnTime = entity.getType() == net.minecraft.world.entity.EntityTypes.PLAYER ? -1 : // SourbyCraft - MC 26.2 split EntityType class / EntityTypes constants
                                         this.despawnTime.getOrDefault(entity.getType(), IntOr.Disabled.DISABLED).or(-1)));
                 // SourbyCraft end - populate despawn time for existing entities on reload
             }
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index 13e4f566738f557ab4cfd083eec88a773df2ee28..8aadb87b2ba0ed999c573c29116a412083114352 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -1246,7 +1246,7 @@ public final class CraftServer implements Server {
         this.commandMap.register("sourbycraft", new dev.iyanz.sourbycraft.command.TpsBarCommand("tpsbar"));
         this.commandMap.register("sourbycraft", new dev.iyanz.sourbycraft.command.SpeedtestCommand("speedtest"));
         this.commandMap.register("sourbycraft", new dev.iyanz.sourbycraft.command.SparkviewCommand("sparkview"));
-        this.commandMap.register("sourbycraft", new dev.iyanz.sourbycraft.command.SwmCommand("swm"));
+        // SourbyCraft - 26.2 survival: /swm command removed with SWM
         this.commandMap.register("sourbycraft", new dev.iyanz.sourbycraft.command.RamBarCommand("rambar"));
         this.commandMap.register("sourbycraft", new dev.iyanz.sourbycraft.command.VerCommand("ver"));
         org.slf4j.LoggerFactory.getLogger("SourbyCraft").info("Registered 10 SourbyCraft commands (fallback prefix 'sourbycraft'). Use /sourbycraft:<name> if a name collides with Paper's built-ins (/tps, /ping, /version, /plugins).");
@@ -1587,15 +1587,7 @@ public final class CraftServer implements Server {
 
             handle.getChunkSource().close(save);
             io.papermc.paper.FeatureHooks.closeEntityManager(handle, save); // SPIGOT-6722: close entityManager // Paper - chunk system
-
-            // SourbyCraft start - SWM temp-dir cleanup on world unload (ASP dev/26.2 parity).
-            // Without this the temp LevelStorageAccess dir accumulates dead SWM worlds
-            // across the JVM lifetime — a long-uptime server that loads/unloads SS2
-            // islands fills /tmp with orphan dimension folders.
-            if (handle instanceof dev.iyanz.sourbycraft.swm.server.SlimeLevelInstance sli) {
-                sli.deleteTempFiles();
-            }
-            // SourbyCraft end
+            // SourbyCraft - 26.2 survival: SWM temp-dir cleanup removed with SWM (vanilla region worlds).
         } catch (Exception ex) {
             this.getLogger().log(Level.SEVERE, null, ex);
         }
