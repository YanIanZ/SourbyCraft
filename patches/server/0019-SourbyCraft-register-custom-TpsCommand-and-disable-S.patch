From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Wed, 27 May 2026 17:09:43 +0700
Subject: [PATCH] SourbyCraft register custom TpsCommand and disable Spigot
 default /tps

- Add TpsCommand("tps") to both CraftServer registration blocks
- Empty SpigotConfig.tpsCommand() body so Spigot doesn't override it

diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index 78125d92fc15095e74b71fbbd361d56e771584b5..7b92482f3cc3d005d5aa6b0d779d238d2a97971d 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -423,6 +423,7 @@ public final class CraftServer implements Server {
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.SysCommand("sys"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.PluginsCommand("plugins"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.TpsBarCommand("tpsbar"));
+        this.commandMap.register("", new dev.iyanz.sourbycraft.command.TpsCommand("tps"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.SpeedtestCommand("speedtest"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.ModsCommand("mods"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.RamBarCommand("rambar"));
@@ -1042,6 +1043,7 @@ public final class CraftServer implements Server {
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.SysCommand("sys"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.PluginsCommand("plugins"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.TpsBarCommand("tpsbar"));
+        this.commandMap.register("", new dev.iyanz.sourbycraft.command.TpsCommand("tps"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.SpeedtestCommand("speedtest"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.SwmCommand("swm"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.ModsCommand("mods"));
diff --git a/src/main/java/org/spigotmc/SpigotConfig.java b/src/main/java/org/spigotmc/SpigotConfig.java
index 97d81401484b2063c7d0ae2762eb216f24287eaf..dfe194d24e0e192128592cce192f55d3daf7c54c 100644
--- a/src/main/java/org/spigotmc/SpigotConfig.java
+++ b/src/main/java/org/spigotmc/SpigotConfig.java
@@ -229,7 +229,7 @@ public class SpigotConfig {
     }
 
     private static void tpsCommand() {
-        SpigotConfig.commands.put("tps", new TicksPerSecondCommand("tps"));
+        // SourbyCraft - default tps command disabled; custom TpsCommand registered in CraftServer
     }
 
     public static int playerSample;
