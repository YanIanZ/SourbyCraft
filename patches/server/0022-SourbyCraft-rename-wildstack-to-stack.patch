From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Wed, 27 May 2026 23:02:05 +0700
Subject: [PATCH] SourbyCraft rename /wildstack to /stack


diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index 4f33130632c90a9b442f1f834271c7b75f5fd762..90e45481f56393b3918ff1bf2fb0b40e3fa81ae2 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -428,7 +428,7 @@ public final class CraftServer implements Server {
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.ModsCommand("mods"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.RamBarCommand("rambar"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.VerCommand("ver"));
-        this.commandMap.register("", new dev.iyanz.sourbycraft.command.WildstackerDebugCommand("wildstack"));
+        this.commandMap.register("", new dev.iyanz.sourbycraft.command.WildstackerDebugCommand("stack"));
         // SourbyCraft end
 
         CraftRegistry.setMinecraftRegistry(console.registryAccess());
@@ -1050,7 +1050,7 @@ public final class CraftServer implements Server {
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.ModsCommand("mods"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.RamBarCommand("rambar"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.VerCommand("ver"));
-        this.commandMap.register("", new dev.iyanz.sourbycraft.command.WildstackerDebugCommand("wildstack"));
+        this.commandMap.register("", new dev.iyanz.sourbycraft.command.WildstackerDebugCommand("stack"));
         // SourbyCraft end
         this.overrideAllCommandBlockCommands = this.commandsConfiguration.getStringList("command-block-overrides").contains("*");
         this.ignoreVanillaPermissions = this.commandsConfiguration.getBoolean("ignore-vanilla-permissions");
