From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Tue, 2 Jun 2026 20:03:06 +0700
Subject: [PATCH] SourbyCraft v12: /ver shows variant + tagline


diff --git a/src/main/java/dev/iyanz/sourbycraft/command/VerCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/VerCommand.java
index 4197a1896d87392b7a4b5846d2bd01d7d1af50ab..dddca61306d27d9405a30ad59fef7251d5d82813 100644
--- a/src/main/java/dev/iyanz/sourbycraft/command/VerCommand.java
+++ b/src/main/java/dev/iyanz/sourbycraft/command/VerCommand.java
@@ -1,5 +1,6 @@
 package dev.iyanz.sourbycraft.command;
 import dev.iyanz.sourbycraft.SourbyCraftColors;
+import dev.iyanz.sourbycraft.brand.BuildInfo;
 import io.papermc.paper.ServerBuildInfo;
 import org.bukkit.Bukkit;
 import org.bukkit.command.Command;
@@ -17,6 +18,9 @@ public class VerCommand extends Command {
         long u=ManagementFactory.getRuntimeMXBean().getUptime(),d=u/86400000,h=(u%86400000)/3600000,m=(u%3600000)/60000;
         s.sendMessage(text().append(text("Uptime: ",SourbyCraftColors.LABEL)).append(text(d+"d "+h+"h "+m+"m",SourbyCraftColors.VALUE)));
         s.sendMessage(text().append(text("Git: ",SourbyCraftColors.LABEL)).append(text(bi.gitBranch().orElse("?")+"@"+bi.gitCommit().orElse("?"),SourbyCraftColors.DIM)));
+        // SourbyCraft v12 - variant + tagline
+        BuildInfo sbi=BuildInfo.load();
+        s.sendMessage(text().append(text("Variant: ",SourbyCraftColors.LABEL)).append(text(sbi.isPvp()?"PVP":"NORMAL",sbi.isPvp()?SourbyCraftColors.DANGER:SourbyCraftColors.SUCCESS)).append(text(" · ",SourbyCraftColors.DIM)).append(text("\""+sbi.tagline()+"\"",SourbyCraftColors.VALUE)));
         return true;
     }
 }
