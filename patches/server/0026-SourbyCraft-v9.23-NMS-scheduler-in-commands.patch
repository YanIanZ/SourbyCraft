From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Thu, 28 May 2026 11:05:07 +0700
Subject: [PATCH] SourbyCraft v9.23 NMS scheduler in commands

Replace Bukkit scheduler with NMS-native alternatives so all commands
work without a plugin instance:
- PingCommand: VirtualExecutor.run() for geo lookup, NMS execute() to return to main thread
- SpeedtestCommand: VirtualExecutor.run() for speedtest subprocess, NMS execute() for results
- SwmCommand: MinecraftServer.getServer().execute() for world load (sync next-tick)
- TpsBarCommand/RamBarCommand: BossBarTicker (NMS-driven per-player repeating tick)
- BossBarTicker: new static tick driver, hooked from MinecraftServer.tickChildren every 20t

diff --git a/src/main/java/dev/iyanz/sourbycraft/command/BossBarTicker.java b/src/main/java/dev/iyanz/sourbycraft/command/BossBarTicker.java
new file mode 100644
index 0000000000000000000000000000000000000000..53fea87e73b3af9590063cb39f9b5d457e2bb775
--- /dev/null
+++ b/src/main/java/dev/iyanz/sourbycraft/command/BossBarTicker.java
@@ -0,0 +1,49 @@
+package dev.iyanz.sourbycraft.command;
+
+import org.bukkit.Bukkit;
+import org.bukkit.entity.Player;
+
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * NMS-driven BossBar tick driver. Called every 20 ticks from MinecraftServer.tickChildren.
+ * Avoids Bukkit scheduler dependency on a plugin instance.
+ * SourbyCraft v9.23
+ */
+public final class BossBarTicker {
+
+    public record Tracked(UUID playerId, Runnable update) {}
+
+    private static final Map<UUID, Tracked> TICKERS = new ConcurrentHashMap<>();
+    private static long tickCounter = 0;
+
+    public static void register(UUID playerId, Runnable update) {
+        TICKERS.put(playerId, new Tracked(playerId, update));
+    }
+
+    public static void unregister(UUID playerId) {
+        TICKERS.remove(playerId);
+    }
+
+    public static boolean isRegistered(UUID playerId) {
+        return TICKERS.containsKey(playerId);
+    }
+
+    /** Called from MinecraftServer.tickChildren NMS hook — fires every server tick. */
+    public static void tick() {
+        tickCounter++;
+        if (tickCounter % 20 != 0) return; // 1 update per second
+        for (Tracked t : TICKERS.values()) {
+            Player p = Bukkit.getPlayer(t.playerId());
+            if (p == null || !p.isOnline()) {
+                TICKERS.remove(t.playerId());
+                continue;
+            }
+            try { t.update().run(); } catch (Throwable ignored) {}
+        }
+    }
+
+    private BossBarTicker() {}
+}
