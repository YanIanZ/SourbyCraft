Subject: [PATCH] feat: add /tpsbar command


diff --git a/src/main/java/dev/iyanz/sourbycraft/command/TpsBarCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/TpsBarCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..ee8aaf433da0e53036c5d3155d04d6663c63a47a
--- /dev/null
+++ b/src/main/java/dev/iyanz/sourbycraft/command/TpsBarCommand.java
@@ -0,0 +1,43 @@
+package dev.iyanz.sourbycraft.command;
+
+import dev.iyanz.sourbycraft.SourbyCraftColors;
+import dev.iyanz.sourbycraft.util.BarUtil;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import static net.kyori.adventure.text.Component.text;
+
+public class TpsBarCommand extends Command {
+    public TpsBarCommand(String name) {
+        super(name);
+        this.description = "Shows TPS and RAM visual bars";
+        this.usageMessage = "/tpsbar";
+        this.setPermission("sourbycraft.command.tpsbar");
+    }
+
+    @Override
+    public boolean execute(CommandSender sender, String alias, String[] args) {
+        if (!this.testPermission(sender)) return true;
+
+        double[] tps = org.bukkit.Bukkit.getTPS();
+        sender.sendMessage(text()
+            .append(text("TPS:  ", SourbyCraftColors.LABEL))
+            .append(BarUtil.coloredBar(Math.min(tps[0] * 5, 100), 20))
+            .append(text(" " + tps[0], tps[0] > 18 ? SourbyCraftColors.SUCCESS : SourbyCraftColors.DANGER)));
+
+        double mspt = org.bukkit.Bukkit.getAverageTickTime();
+        sender.sendMessage(text()
+            .append(text("MSPT: ", SourbyCraftColors.LABEL))
+            .append(BarUtil.coloredBar(Math.max(0, 100 - mspt * 2), 20))
+            .append(text(" " + mspt + "ms", mspt < 40 ? SourbyCraftColors.SUCCESS : SourbyCraftColors.DANGER)));
+
+        Runtime rt = Runtime.getRuntime();
+        long max = rt.maxMemory(), used = rt.totalMemory() - rt.freeMemory();
+        double pct = max == Long.MAX_VALUE ? (double) used / rt.totalMemory() * 100 : (double) used / max * 100;
+        sender.sendMessage(text()
+            .append(text("RAM:  ", SourbyCraftColors.LABEL))
+            .append(BarUtil.coloredBar(pct, 20))
+            .append(text(" " + (used / 1048576) + "/" + (max == Long.MAX_VALUE ? BarUtil.INFINITY : (max / 1048576) + "MB"), SourbyCraftColors.VALUE)));
+
+        return true;
+    }
+}
diff --git a/src/main/java/io/papermc/paper/util/Holderable.java b/src/main/java/io/papermc/paper/util/Holderable.java
index a1927b6bcea6d7bd2b5949887e78d02ef8be38da..8c2ee35f3e0bde55734c3b62f0b23b14497769b7 100644
