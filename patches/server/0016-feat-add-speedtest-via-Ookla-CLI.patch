+package dev.iyanz.sourbycraft;
+
+import net.kyori.adventure.text.format.TextColor;
+
+public final class SourbyCraftColors {
+    private SourbyCraftColors() {}
+
+    public static final TextColor HEADER = TextColor.color(0x55FFFF);
+    public static final TextColor VALUE = TextColor.color(0xAAAAAA);
+    public static final TextColor LABEL = TextColor.color(0xFFFFFF);
+    public static final TextColor DIM = TextColor.color(0x555555);
+    public static final TextColor SUCCESS = TextColor.color(0x55FF55);
+    public static final TextColor PRIMARY = TextColor.color(0x5555FF);
+    public static final TextColor WARNING = TextColor.color(0xFFAA00);
+    public static final TextColor DANGER = TextColor.color(0xFF5555);
+}
diff --git a/src/main/java/dev/iyanz/sourbycraft/command/PluginsCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/PluginsCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..0b4c2294d3c16497d0beb3e0cce395cdcc60a11a
--- /dev/null
+++ b/src/main/java/dev/iyanz/sourbycraft/command/PluginsCommand.java
@@ -0,0 +1,30 @@
+package dev.iyanz.sourbycraft.command;
+
+import dev.iyanz.sourbycraft.SourbyCraftColors;
+import org.bukkit.Bukkit;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+
+import static net.kyori.adventure.text.Component.text;
+
+public class PluginsCommand extends Command {
+    public PluginsCommand(String name) {
+        super(name);
+        this.description = "Lists all active plugins";
+        this.usageMessage = "/plugins";
+        this.setPermission("sourbycraft.command.plugins");
+    }
+
+    @Override
+    public boolean execute(CommandSender sender, String alias, String[] args) {
+        if (!this.testPermission(sender)) return true;
+        var plugins = Bukkit.getPluginManager().getPlugins();
+        String list = java.util.Arrays.stream(plugins)
+            .map(p -> p.getName() + " v" + p.getDescription().getVersion())
+            .reduce((a, b) -> a + ", " + b).orElse("none");
+        sender.sendMessage(text()
+            .append(text("Plugins (" + plugins.length + "): ", SourbyCraftColors.HEADER))
+            .append(text(list, SourbyCraftColors.VALUE)));
+        return true;
+    }
+}
diff --git a/src/main/java/dev/iyanz/sourbycraft/command/SpeedtestCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/SpeedtestCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..b19355d657dadbc92225a59c0099a601650b109e
--- /dev/null
+++ b/src/main/java/dev/iyanz/sourbycraft/command/SpeedtestCommand.java
@@ -0,0 +1,84 @@
+package dev.iyanz.sourbycraft.command;
+
+import dev.iyanz.sourbycraft.SourbyCraftColors;
+import dev.iyanz.sourbycraft.util.BarUtil;
+import net.kyori.adventure.text.Component;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+
+import java.io.*;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+
+import static net.kyori.adventure.text.Component.text;
+
+public class SpeedtestCommand extends Command {
+
+    private static final Path SPEEDTEST_BIN = Paths.get("plugins/sourbycraft/speedtest");
+
+    public SpeedtestCommand(String name) {
+        super(name);
+        this.description = "Runs network speed test via Ookla";
+        this.usageMessage = "/speedtest";
+        this.setPermission("sourbycraft.command.speedtest");
+    }
+
+    @Override
+    public boolean execute(CommandSender sender, String alias, String[] args) {
+        if (!this.testPermission(sender)) return true;
+
+        if (!Files.exists(SPEEDTEST_BIN)) {
+            try {
+                Files.createDirectories(SPEEDTEST_BIN.getParent());
+                try (InputStream in = getClass().getClassLoader().getResourceAsStream("speedtest")) {
+                    if (in == null) {
+                        sender.sendMessage(text("Speedtest binary not found. Place 'speedtest' binary at plugins/sourbycraft/speedtest", SourbyCraftColors.DANGER));
+                        return true;
+                    }
+                    Files.copy(in, SPEEDTEST_BIN);
+                    SPEEDTEST_BIN.toFile().setExecutable(true);
+                }
+            } catch (IOException e) {
+                sender.sendMessage(text("Speedtest: " + e.getMessage(), SourbyCraftColors.DANGER));
+                return true;
+            }
+        }
+
+        sender.sendMessage(text("Running speedtest...", SourbyCraftColors.LABEL));
+
+        try {
+            Process proc = new ProcessBuilder(SPEEDTEST_BIN.toString(), "--format=json", "--accept-license", "--accept-gdpr")
+                .redirectErrorStream(true).start();
+            String output = new String(proc.getInputStream().readAllBytes());
+            proc.waitFor();
+
+            var gson = new com.google.gson.Gson();
+            var result = gson.fromJson(output, java.util.Map.class);
+            var dl = (java.util.Map) result.get("download");
+            var ul = (java.util.Map) result.get("upload");
+            var ping = (java.util.Map) result.get("ping");
+            var server = (java.util.Map) result.get("server");
+
+            double dlMbps = ((Number) dl.get("bandwidth")).doubleValue() * 8 / 1000000;
+            double ulMbps = ((Number) ul.get("bandwidth")).doubleValue() * 8 / 1000000;
+            double pingMs = ((Number) ping.get("latency")).doubleValue();
+
+            sender.sendMessage(text()
+                .append(text("Download: ", SourbyCraftColors.LABEL))
+                .append(BarUtil.coloredBar(Math.min(dlMbps / 5, 100), 20))
+                .append(text(" " + String.format("%.1f Mbps", dlMbps), SourbyCraftColors.SUCCESS)));
+            sender.sendMessage(text()
+                .append(text("Upload:   ", SourbyCraftColors.LABEL))
+                .append(BarUtil.coloredBar(Math.min(ulMbps / 3, 100), 20))
+                .append(text(" " + String.format("%.1f Mbps", ulMbps), SourbyCraftColors.SUCCESS)));
+            sender.sendMessage(text()
+                .append(text("Ping:     ", SourbyCraftColors.LABEL))
+                .append(text(String.format("%.0fms", pingMs), pingMs < 30 ? SourbyCraftColors.SUCCESS : SourbyCraftColors.PRIMARY))
+                .append(text(" | " + server.get("name") + ", " + server.get("location"), SourbyCraftColors.DIM)));
+        } catch (Exception e) {
+            sender.sendMessage(text("Speedtest failed: " + e.getMessage(), SourbyCraftColors.DANGER));
+        }
+        return true;
+    }
+}
diff --git a/src/main/java/dev/iyanz/sourbycraft/command/SysCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/SysCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..9aedfff7e73ab72abc3b722d2e8f5f176cb1236a
--- /dev/null
+++ b/src/main/java/dev/iyanz/sourbycraft/command/SysCommand.java
@@ -0,0 +1,92 @@
+package dev.iyanz.sourbycraft.command;
+
+import dev.iyanz.sourbycraft.SourbyCraftColors;
+import dev.iyanz.sourbycraft.util.BarUtil;
+import net.kyori.adventure.text.Component;
+import oshi.SystemInfo;
+import oshi.hardware.CentralProcessor;
+import org.bukkit.Bukkit;
+import org.bukkit.World;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.bukkit.plugin.Plugin;
+
+import java.lang.management.ManagementFactory;
+import java.text.DecimalFormat;
+import java.util.Arrays;
+
+import static net.kyori.adventure.text.Component.space;
+import static net.kyori.adventure.text.Component.text;
+
+public class SysCommand extends Command {
+
+    private static final DecimalFormat FMT = new DecimalFormat("########0.0");
+
+    public SysCommand(String name) {
+        super(name);
+        this.description = "Displays full server specifications";
+        this.usageMessage = "/sys";
+        this.setPermission("sourbycraft.command.sys");
+    }
+
+    @Override
+    public boolean execute(CommandSender sender, String alias, String[] args) {
+        if (!this.testPermission(sender)) return true;
+
+        long uptime = ManagementFactory.getRuntimeMXBean().getUptime();
+        long d = uptime / 86400000, h = (uptime % 86400000) / 3600000, m = (uptime % 3600000) / 60000;
+        sender.sendMessage(text()
+            .append(text("SourbyCraft ", SourbyCraftColors.HEADER))
+            .append(text(Bukkit.getVersion(), SourbyCraftColors.VALUE))
+            .append(text(" | Uptime: " + d + "d " + h + "h " + m + "m", SourbyCraftColors.DIM)));
+
+        try {
+            SystemInfo si = new SystemInfo();
+            CentralProcessor cpu = si.getHardware().getProcessor();
+            String name = cpu.getProcessorIdentifier().getName().trim();
+            int phys = cpu.getPhysicalProcessorCount();
+            int log = cpu.getLogicalProcessorCount();
+            double load = cpu.getSystemCpuLoad(1000) * 100;
+            sender.sendMessage(text()
+                .append(text("CPU: ", SourbyCraftColors.LABEL))
+                .append(text(name + " | " + phys + "c/" + log + "t | " + FMT.format(load) + "%", SourbyCraftColors.VALUE)));
+        } catch (NoClassDefFoundError e) {
+            sender.sendMessage(text("CPU: " + Runtime.getRuntime().availableProcessors() + " logical cores", SourbyCraftColors.DIM));
+        }
+
+        Runtime rt = Runtime.getRuntime();
+        long maxMem = rt.maxMemory();
+        long totalMem = rt.totalMemory();
+        long usedMem = totalMem - rt.freeMemory();
+        double memPct = maxMem == Long.MAX_VALUE ? (double) usedMem / totalMem * 100 : (double) usedMem / maxMem * 100;
+        String memLabel = maxMem == Long.MAX_VALUE ? BarUtil.INFINITY : (maxMem / 1048576) + " MB";
+        sender.sendMessage(text()
+            .append(text("RAM: ", SourbyCraftColors.LABEL))
+            .append(BarUtil.coloredBar(memPct, 20))
+            .append(space())
+            .append(text(FMT.format(memPct) + "% " + (usedMem / 1048576) + "/" + memLabel, SourbyCraftColors.VALUE)));
+
+        sender.sendMessage(text()
+            .append(text("Java: ", SourbyCraftColors.LABEL))
+            .append(text(System.getProperty("java.version") + " (" + System.getProperty("java.vm.name") + ")", SourbyCraftColors.VALUE)));
+
+        int worlds = Bukkit.getWorlds().size();
+        int rec = Math.max(3, (Runtime.getRuntime().availableProcessors() * 3) / Math.max(1, worlds));
+        sender.sendMessage(text("Worlds (" + worlds + "):", SourbyCraftColors.HEADER));
+        for (World w : Bukkit.getWorlds()) {
+            int chunks = w.getLoadedChunks().length;
+            int entities = w.getEntities().size();
+            sender.sendMessage(text()
+                .append(text("  " + w.getName() + ": ", SourbyCraftColors.LABEL))
+                .append(text(chunks + " chunks · " + entities + " entities", SourbyCraftColors.DIM))
+                .append(text(" · ~" + rec + " players", SourbyCraftColors.SUCCESS)));
+        }
+
+        Plugin[] plugins = Bukkit.getPluginManager().getPlugins();
+        sender.sendMessage(text()
+            .append(text("Plugins (" + plugins.length + "): ", SourbyCraftColors.HEADER))
+            .append(text(Arrays.stream(plugins).map(Plugin::getName).reduce((a, b) -> a + ", " + b).orElse("none"), SourbyCraftColors.VALUE)));
+
+        return true;
+    }
+}
diff --git a/src/main/java/dev/iyanz/sourbycraft/util/BarUtil.java b/src/main/java/dev/iyanz/sourbycraft/util/BarUtil.java
new file mode 100644
index 0000000000000000000000000000000000000000..f780c0068e03ef9d3c4d92a916ff35cd89dd48bc
--- /dev/null
+++ b/src/main/java/dev/iyanz/sourbycraft/util/BarUtil.java
@@ -0,0 +1,23 @@
+package dev.iyanz.sourbycraft.util;
+
+import dev.iyanz.sourbycraft.SourbyCraftColors;
+import static net.kyori.adventure.text.Component.text;
+
+public final class BarUtil {
+    private BarUtil() {}
+
+    public static net.kyori.adventure.text.Component coloredBar(double percent, int maxLen) {
+        if (percent < 0) percent = 0;
+        if (percent > 100) percent = 100;
+        int filled = (int) Math.round(percent / 100.0 * maxLen);
+        int empty = maxLen - filled;
+
+        net.kyori.adventure.text.format.TextColor color = percent > 66 ? SourbyCraftColors.SUCCESS
+            : percent > 33 ? SourbyCraftColors.WARNING : SourbyCraftColors.DANGER;
+
+        return text()
+            .append(text("\u2588".repeat(filled), color))
+            .append(text("\u2591".repeat(empty), SourbyCraftColors.DIM))
+            .build();
+    }
+}
