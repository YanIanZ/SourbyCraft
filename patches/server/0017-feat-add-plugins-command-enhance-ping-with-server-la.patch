From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Wed, 13 May 2026 17:40:56 +0700
Subject: [PATCH] feat: add /plugins command, enhance /ping with server latency


diff --git a/src/main/java/dev/iyanz/sourbycraft/command/PingCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/PingCommand.java
index 720e808f8e2d44bdc70de3bfaa51425c5c519029..b8af9b9399ab1cebc5fa0a68d5c4c68a7020a600 100644
--- a/src/main/java/dev/iyanz/sourbycraft/command/PingCommand.java
+++ b/src/main/java/dev/iyanz/sourbycraft/command/PingCommand.java
@@ -1,6 +1,7 @@
 package dev.iyanz.sourbycraft.command;
 
 import dev.iyanz.sourbycraft.SourbyCraftColors;
+import dev.iyanz.sourbycraft.util.BarUtil;
 import net.kyori.adventure.text.Component;
 import net.kyori.adventure.text.format.TextColor;
 import org.bukkit.Bukkit;
@@ -48,6 +49,12 @@ public class PingCommand extends Command {
             .append(text(ping + "ms ", pingColor))
             .append(text(bar, SourbyCraftColors.DIM)));
 
+        int serverPing = target.getPing();
+        sender.sendMessage(text()
+            .append(text("Latency: ", SourbyCraftColors.LABEL))
+            .append(BarUtil.coloredBar(Math.min((200 - serverPing) / 2.0, 100), 20))
+            .append(text(" " + serverPing + "ms", serverPing < 50 ? SourbyCraftColors.SUCCESS : SourbyCraftColors.PRIMARY)));
+
         String clientBrand = target.getClientBrandName() != null ? target.getClientBrandName() : "vanilla";
         sender.sendMessage(text()
             .append(text("Client: ", SourbyCraftColors.LABEL))
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index ae841d1e5f4f6715cb38ab070f11208867642b04..f6b53ce3ccad17aa9a0d310e6c84ec7a623af60a 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -1027,7 +1027,9 @@ public final class CraftServer implements Server {
         io.papermc.paper.command.PaperCommands.registerCommands(this.console); // Paper
         this.spark.registerCommandBeforePlugins(this); // Paper - spark
         this.commandMap.register("ping", "SourbyCraft", new dev.iyanz.sourbycraft.command.PingCommand("ping")); // SourbyCraft - ping command
+        this.commandMap.register("plugins", "SourbyCraft", new dev.iyanz.sourbycraft.command.PluginsCommand("plugins")); // SourbyCraft - plugins command
         this.commandMap.register("speedtest", "SourbyCraft", new dev.iyanz.sourbycraft.command.SpeedtestCommand("speedtest")); // SourbyCraft - speedtest command
+        this.commandMap.register("sys", "SourbyCraft", new dev.iyanz.sourbycraft.command.SysCommand("sys")); // SourbyCraft - sys command
         this.overrideAllCommandBlockCommands = this.commandsConfiguration.getStringList("command-block-overrides").contains("*");
         this.ignoreVanillaPermissions = this.commandsConfiguration.getBoolean("ignore-vanilla-permissions");
 
