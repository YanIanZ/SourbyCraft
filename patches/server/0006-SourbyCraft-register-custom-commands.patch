From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <superwhisz@gmail.com>
Date: Wed, 17 Jun 2026 14:20:00 +0700
Subject: [PATCH] SourbyCraft: register custom commands

Hooks the CraftServer command registration path to install
ping/sys/plugins/tpsbar/speedtest/swm/rambar/ver. Sources live in
sourbycraft-server/src/main/java/dev/iyanz/sourbycraft/command/ and
get compiled into the paper-server jar via the sourbycraft-server
dependency on classpath.

diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index 187885f20e709cad2b23f4a60ec57f6c278cdcb2..cf6e4d50d5b4040b3d07bd33fa4808cfeb1bdeae 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -1033,6 +1033,16 @@ public final class CraftServer implements Server {
         org.spigotmc.SpigotConfig.registerCommands(); // Spigot
         io.papermc.paper.command.PaperCommands.registerCommands(this.console); // Paper
         this.spark.registerCommandBeforePlugins(this); // Paper - spark
+        // SourbyCraft start - register commands
+        this.commandMap.register("", new dev.iyanz.sourbycraft.command.PingCommand("ping"));
+        this.commandMap.register("", new dev.iyanz.sourbycraft.command.SysCommand("sys"));
+        this.commandMap.register("", new dev.iyanz.sourbycraft.command.PluginsCommand("plugins"));
+        this.commandMap.register("", new dev.iyanz.sourbycraft.command.TpsBarCommand("tpsbar"));
+        this.commandMap.register("", new dev.iyanz.sourbycraft.command.SpeedtestCommand("speedtest"));
+        this.commandMap.register("", new dev.iyanz.sourbycraft.command.SwmCommand("swm"));
+        this.commandMap.register("", new dev.iyanz.sourbycraft.command.RamBarCommand("rambar"));
+        this.commandMap.register("", new dev.iyanz.sourbycraft.command.VerCommand("ver"));
+        // SourbyCraft end - register commands
         this.overrideAllCommandBlockCommands = this.commandsConfiguration.getStringList("command-block-overrides").contains("*");
         this.ignoreVanillaPermissions = this.commandsConfiguration.getBoolean("ignore-vanilla-permissions");
 
