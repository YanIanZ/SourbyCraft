From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Thu, 28 May 2026 12:46:16 +0700
Subject: [PATCH] SourbyCraft v10.0 KbCommand register + KnockbackManager
 reload

- Register /kb command in initial and reload command maps
- Restart KnockbackManager on /reload (start() is idempotent for
  the initial call; reload re-registers but multipliers persist in-memory)

diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index 90e45481f56393b3918ff1bf2fb0b40e3fa81ae2..555ef8316910d001873b8f46e46e42bae68e55e2 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -429,6 +429,7 @@ public final class CraftServer implements Server {
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.RamBarCommand("rambar"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.VerCommand("ver"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.WildstackerDebugCommand("stack"));
+        this.commandMap.register("", new dev.iyanz.sourbycraft.command.KbCommand("kb"));
         // SourbyCraft end
 
         CraftRegistry.setMinecraftRegistry(console.registryAccess());
@@ -1051,6 +1052,7 @@ public final class CraftServer implements Server {
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.RamBarCommand("rambar"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.VerCommand("ver"));
         this.commandMap.register("", new dev.iyanz.sourbycraft.command.WildstackerDebugCommand("stack"));
+        this.commandMap.register("", new dev.iyanz.sourbycraft.command.KbCommand("kb"));
         // SourbyCraft end
         this.overrideAllCommandBlockCommands = this.commandsConfiguration.getStringList("command-block-overrides").contains("*");
         this.ignoreVanillaPermissions = this.commandsConfiguration.getBoolean("ignore-vanilla-permissions");
@@ -1085,6 +1087,10 @@ public final class CraftServer implements Server {
         try { dev.iyanz.sourbycraft.wildstacker.WildstackerManager.start(); }
         catch (Throwable t) { this.getLogger().warning("[SourbyCraft] WildstackerManager restart failed: " + t); }
         // SourbyCraft end - v9.12 wildstacker manager
+        // SourbyCraft start - v10.0 knockback manager reload
+        try { dev.iyanz.sourbycraft.combat.KnockbackManager.start(); }
+        catch (Throwable t) { this.getLogger().warning("[SourbyCraft] KnockbackManager restart failed: " + t); }
+        // SourbyCraft end - v10.0 knockback manager
         this.spark.registerCommandAfterPlugins(this); // Paper - spark
         if (io.papermc.paper.plugin.PluginInitializerManager.instance().pluginRemapper != null) io.papermc.paper.plugin.PluginInitializerManager.instance().pluginRemapper.pluginsEnabled(); // Paper - Remap plugins
         // Paper start - brigadier command API
