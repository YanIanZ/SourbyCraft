From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Wed, 27 May 2026 18:59:07 +0700
Subject: [PATCH] SourbyCraft v9.12 wildstacker manager restart on reload

Shutdown and restart WildstackerManager in CraftServer.reload() after
POSTWORLD plugins are enabled to ensure clean listener/task re-registration.

diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index 7b92482f3cc3d005d5aa6b0d779d238d2a97971d..215e561b79452a36acd62b24af92884601a9d295 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -1078,6 +1078,11 @@ public final class CraftServer implements Server {
         this.loadPlugins();
         this.enablePlugins(PluginLoadOrder.STARTUP);
         this.enablePlugins(PluginLoadOrder.POSTWORLD);
+        // SourbyCraft start - v9.12 wildstacker manager restart on reload
+        dev.iyanz.sourbycraft.wildstacker.WildstackerManager.shutdown();
+        try { dev.iyanz.sourbycraft.wildstacker.WildstackerManager.start(); }
+        catch (Throwable t) { this.getLogger().warning("[SourbyCraft] WildstackerManager restart failed: " + t); }
+        // SourbyCraft end - v9.12 wildstacker manager
         this.spark.registerCommandAfterPlugins(this); // Paper - spark
         if (io.papermc.paper.plugin.PluginInitializerManager.instance().pluginRemapper != null) io.papermc.paper.plugin.PluginInitializerManager.instance().pluginRemapper.pluginsEnabled(); // Paper - Remap plugins
         // Paper start - brigadier command API
