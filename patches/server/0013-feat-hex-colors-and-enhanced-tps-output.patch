Subject: [PATCH] feat: hex colors and enhanced /tps output


diff --git a/src/main/java/io/papermc/paper/util/Holderable.java b/src/main/java/io/papermc/paper/util/Holderable.java
index a1927b6bcea6d7bd2b5949887e78d02ef8be38da..8c2ee35f3e0bde55734c3b62f0b23b14497769b7 100644
--- a/src/main/java/io/papermc/paper/util/Holderable.java
+++ b/src/main/java/io/papermc/paper/util/Holderable.java
@@ -37,7 +37,7 @@ public interface Holderable<M> extends Handleable<M> {
                 }
                 yield registry.get(Key.key(string));
             }
-            case JsonObjectWrapper(final JsonObject element) -> {
+            case JsonObjectWrapper(JsonObject element) -> {
                 if (!(registry instanceof final CraftRegistry<?, ?> craftRegistry) || !craftRegistry.supportsDirectHolders()) {
                     throw new IllegalArgumentException("Cannot deserialize direct holders for " + registry);
                 }
diff --git a/src/main/java/org/spigotmc/TicksPerSecondCommand.java b/src/main/java/org/spigotmc/TicksPerSecondCommand.java
index 2756ca738b99792495f4fe6128b75e03f73936f1..a0ca422165351ff2a15a3289a72289a482be33f2 100644
--- a/src/main/java/org/spigotmc/TicksPerSecondCommand.java
+++ b/src/main/java/org/spigotmc/TicksPerSecondCommand.java
@@ -1,9 +1,8 @@
 package org.spigotmc;
 
+import dev.iyanz.sourbycraft.SourbyCraftColors;
 import net.kyori.adventure.text.Component;
 import net.kyori.adventure.text.JoinConfiguration;
-import net.kyori.adventure.text.TextComponent;
-import net.kyori.adventure.text.format.NamedTextColor;
 import net.kyori.adventure.text.format.TextColor;
 import org.bukkit.command.Command;
 import org.bukkit.command.CommandSender;
@@ -13,10 +12,9 @@ import static net.kyori.adventure.text.Component.text;
 
 public class TicksPerSecondCommand extends Command {
 
-    private boolean hasShownMemoryWarning; // Paper
-    private static final ThreadLocal<DecimalFormat> ONE_DECIMAL_PLACES = ThreadLocal.withInitial(() -> {
-        return new DecimalFormat("########0.0");
-    });
+    private boolean hasShownMemoryWarning;
+    private static final ThreadLocal<DecimalFormat> ONE_DECIMAL_PLACES = ThreadLocal.withInitial(() ->
+        new DecimalFormat("########0.0"));
 
     public TicksPerSecondCommand(String name) {
         super(name);
@@ -25,51 +23,84 @@ public class TicksPerSecondCommand extends Command {
         this.setPermission("bukkit.command.tps");
     }
 
-    // Paper start
     private static final Component WARN_MSG = text()
-        .append(text("Warning: ", NamedTextColor.RED))
-        .append(text("Memory usage on modern garbage collectors is not a stable value and it is perfectly normal to see it reach max. Please do not pay it much attention.", NamedTextColor.GOLD))
+        .append(text("Warning: ", SourbyCraftColors.DANGER))
+        .append(text("Memory usage on modern garbage collectors is not a stable value.", SourbyCraftColors.DIM))
         .build();
-    // Paper end
 
     @Override
     public boolean execute(CommandSender sender, String currentAlias, String[] args) {
-        if (!this.testPermission(sender)) {
-            return true;
-        }
+        if (!this.testPermission(sender)) return true;
 
-        // Paper start - Further improve tick handling
         double[] tps = org.bukkit.Bukkit.getTPS();
         Component[] tpsAvg = new Component[tps.length];
-
         for (int i = 0; i < tps.length; i++) {
-            tpsAvg[i] = TicksPerSecondCommand.format(tps[i]);
+            tpsAvg[i] = formatTps(tps[i]);
+        }
+        sender.sendMessage(text()
+            .append(text("TPS (1m, 5m, 15m): ", SourbyCraftColors.LABEL))
+            .append(Component.join(JoinConfiguration.commas(true), tpsAvg)));
+
+        double mspt = org.bukkit.Bukkit.getAverageTickTime();
+        TextColor msptColor = mspt < 40 ? SourbyCraftColors.SUCCESS : mspt < 50 ? SourbyCraftColors.PRIMARY : SourbyCraftColors.DANGER;
+        sender.sendMessage(text()
+            .append(text("MSPT: ", SourbyCraftColors.LABEL))
+            .append(text(ONE_DECIMAL_PLACES.get().format(mspt) + "ms", msptColor)));
+
+        try {
+            oshi.SystemInfo si = new oshi.SystemInfo();
+            oshi.hardware.CentralProcessor cpu = si.getHardware().getProcessor();
+            String cpuName = cpu.getProcessorIdentifier().getName().trim();
+            int phys = cpu.getPhysicalProcessorCount();
+            int log = cpu.getLogicalProcessorCount();
+            double load = cpu.getSystemCpuLoad(1000) * 100;
+            sender.sendMessage(text()
+                .append(text("CPU: ", SourbyCraftColors.LABEL))
+                .append(text(cpuName + " | " + phys + "c/" + log + "t | " + ONE_DECIMAL_PLACES.get().format(load) + "% load", SourbyCraftColors.VALUE)));
+        } catch (NoClassDefFoundError e) {
+            sender.sendMessage(text()
+                .append(text("CPU: ", SourbyCraftColors.LABEL))
+                .append(text("oshi not available", SourbyCraftColors.DIM)));
         }
 
-        TextComponent.Builder builder = text();
-        builder.append(text("TPS from last 1m, 5m, 15m: ", NamedTextColor.GOLD));
-        builder.append(Component.join(JoinConfiguration.commas(true), tpsAvg));
-        sender.sendMessage(builder.asComponent());
+        long collections = 0, gcTime = 0;
+        StringBuilder gcNames = new StringBuilder();
+        for (java.lang.management.GarbageCollectorMXBean gc : java.lang.management.ManagementFactory.getGarbageCollectorMXBeans()) {
+            collections += gc.getCollectionCount();
+            gcTime += gc.getCollectionTime();
+            if (gcNames.length() > 0) gcNames.append(" + ");
+            gcNames.append(gc.getName());
+        }
+        sender.sendMessage(text()
+            .append(text("GC: ", SourbyCraftColors.LABEL))
+            .append(text(gcNames + " | " + collections + " collections, " + gcTime + "ms", SourbyCraftColors.VALUE)));
+
+        int players = org.bukkit.Bukkit.getOnlinePlayers().size();
+        int maxPlayers = org.bukkit.Bukkit.getMaxPlayers();
+        sender.sendMessage(text()
+            .append(text("Players: ", SourbyCraftColors.LABEL))
+            .append(text(players + "/" + maxPlayers, SourbyCraftColors.VALUE)));
+
         if (args.length > 0 && args[0].equals("mem") && sender.hasPermission("bukkit.command.tpsmemory")) {
+            Runtime rt = Runtime.getRuntime();
+            long used = (rt.totalMemory() - rt.freeMemory()) / (1024 * 1024);
+            long total = rt.totalMemory() / (1024 * 1024);
+            long max = rt.maxMemory() / (1024 * 1024);
+            TextColor memColor = used > total * 0.85 ? SourbyCraftColors.DANGER : SourbyCraftColors.VALUE;
             sender.sendMessage(text()
-                .append(text("Current Memory Usage: ", NamedTextColor.GOLD))
-                .append(text(((Runtime.getRuntime().totalMemory() - Runtime.getRuntime().freeMemory()) / (1024 * 1024)) + "/" + (Runtime.getRuntime().totalMemory() / (1024 * 1024)) + " mb (Max: " + (Runtime.getRuntime().maxMemory() / (1024 * 1024)) + " mb)", NamedTextColor.GREEN))
-            );
+                .append(text("Memory: ", SourbyCraftColors.LABEL))
+                .append(text(used + "/" + total + " MB (Max: " + max + " MB)", memColor)));
             if (!this.hasShownMemoryWarning) {
                 sender.sendMessage(WARN_MSG);
                 this.hasShownMemoryWarning = true;
             }
         }
-        // Paper end
 
         return true;
     }
 
-    private static Component format(double tps) { // Paper - Made static
-        // Paper start
-        TextColor color = ((tps > 18.0) ? NamedTextColor.GREEN : (tps > 16.0) ? NamedTextColor.YELLOW : NamedTextColor.RED);
-        String amount = ONE_DECIMAL_PLACES.get().format(tps); // Paper - only print * at 21, we commonly peak to 20.02 as the tick sleep is not accurate enough, stop the noise
-        return text(amount, color);
-        // Paper end
+    private static Component formatTps(double tps) {
+        TextColor color = tps > 18.0 ? SourbyCraftColors.SUCCESS : tps > 16.0 ? SourbyCraftColors.PRIMARY : SourbyCraftColors.DANGER;
+        return text(ONE_DECIMAL_PLACES.get().format(tps), color);
     }
 }
