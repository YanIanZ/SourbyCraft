From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Thu, 14 May 2026 16:58:07 +0700
Subject: [PATCH] fix: remove SwmInstaller refs, fix variable shadowing


diff --git a/src/main/java/dev/iyanz/sourbycraft/command/SwmCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/SwmCommand.java
index 08a665afc2aac744a97675682a6dcf1adbdd8da6..5c12e17f6860a87b024ebfaa8ac603329343e8bb 100644
--- a/src/main/java/dev/iyanz/sourbycraft/command/SwmCommand.java
+++ b/src/main/java/dev/iyanz/sourbycraft/command/SwmCommand.java
@@ -1,7 +1,7 @@
 package dev.iyanz.sourbycraft.command;
 import dev.iyanz.sourbycraft.SourbyCraftColors;
 import dev.iyanz.sourbycraft.swm.SlimeWorldLoader;
-import dev.iyanz.sourbycraft.swm.SwmInstaller;
+// removed
 import org.bukkit.Bukkit;
 import org.bukkit.WorldCreator;
 import org.bukkit.command.Command;
@@ -14,7 +14,7 @@ public class SwmCommand extends Command {
         switch(sub){
             case "list":var w=SlimeWorldLoader.discoverWorlds();if(w.isEmpty()){s.sendMessage(text("No slime worlds",SourbyCraftColors.DIM));return true;}s.sendMessage(text("Slime Worlds ("+w.size()+"):",SourbyCraftColors.HEADER));for(var x:w)s.sendMessage(text().append(text("  "+x.worldName(),Bukkit.getWorld(x.worldName())!=null?SourbyCraftColors.SUCCESS:SourbyCraftColors.VALUE)).append(text(" v"+x.version(),SourbyCraftColors.DIM)).append(text(Bukkit.getWorld(x.worldName())!=null?" [LOADED]":"",SourbyCraftColors.SUCCESS)));break;
             case "load":if(args.length<2){s.sendMessage(text("/swm load <world>",SourbyCraftColors.DIM));return true;}String nm=args[1];if(Bukkit.getWorld(nm)!=null){s.sendMessage(text("Already loaded",SourbyCraftColors.WARNING));return true;}s.sendMessage(text("Loading "+nm+"...",SourbyCraftColors.LABEL));Bukkit.getScheduler().runTask(Bukkit.getPluginManager().getPlugins()[0],()->{Bukkit.createWorld(WorldCreator.name(nm));s.sendMessage(text(nm+" loaded",SourbyCraftColors.SUCCESS));});break;
-            default:boolean in=SwmInstaller.isInstalled();s.sendMessage(text().append(text("SWM: ",SourbyCraftColors.LABEL)).append(text(in?"Installed":"Not installed",in?SourbyCraftColors.SUCCESS:SourbyCraftColors.DANGER)).append(text(" v"+dev.iyanz.sourbycraft.SourbyCraftConfig.swmVersion,SourbyCraftColors.DIM)));s.sendMessage(text().append(text("Worlds: ",SourbyCraftColors.LABEL)).append(text(SlimeWorldLoader.discoverWorlds().size()+" found",SourbyCraftColors.VALUE)));
+            default:s.sendMessage(text().append(text("Slime worlds: ",SourbyCraftColors.LABEL)).append(text(SlimeWorldLoader.discoverWorlds().size()+" found",SourbyCraftColors.VALUE)));
         }return true;
     }
 }
diff --git a/src/main/java/dev/iyanz/sourbycraft/command/SysCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/SysCommand.java
index dffe689f526701490720938f6ce75d4a994e0f34..3417729cfc5134e3d01eaaeeb5b51385d8916c40 100644
--- a/src/main/java/dev/iyanz/sourbycraft/command/SysCommand.java
+++ b/src/main/java/dev/iyanz/sourbycraft/command/SysCommand.java
@@ -1,7 +1,7 @@
 package dev.iyanz.sourbycraft.command;
 import dev.iyanz.sourbycraft.SourbyCraftColors;
 import dev.iyanz.sourbycraft.util.BarUtil;
-import dev.iyanz.sourbycraft.swm.SwmInstaller;
+// SwmInstaller removed
 import org.bukkit.Bukkit;
 import org.bukkit.World;
 import org.bukkit.command.Command;
@@ -13,7 +13,7 @@ import static net.kyori.adventure.text.Component.text;
 public class SysCommand extends Command {
     private static final DecimalFormat FMT = new DecimalFormat("########0.0");
     public SysCommand(String name) { super(name); this.description="Server specs"; this.usageMessage="/sys"; this.setPermission("sourbycraft.command.sys"); }
-    public boolean execute(CommandSender s, String a, String[] args) {
+    public boolean execute(CommandSender s, String alias, String[] args) {
         if(!testPermission(s)) return true;
         long u=ManagementFactory.getRuntimeMXBean().getUptime(),d=u/86400000,h=(u%86400000)/3600000,m=(u%3600000)/60000;
         s.sendMessage(text().append(text("Uptime: ",SourbyCraftColors.LABEL)).append(text(d+"d "+h+"h "+m+"m",SourbyCraftColors.VALUE)));
@@ -23,8 +23,8 @@ public class SysCommand extends Command {
         s.sendMessage(text().append(text("Java: ",SourbyCraftColors.LABEL)).append(text(System.getProperty("java.version")+" ("+System.getProperty("java.vm.name")+")",SourbyCraftColors.VALUE)));
         int rec=Math.max(3,(Runtime.getRuntime().availableProcessors()*3)/Math.max(1,Bukkit.getWorlds().size()));
         for(World w:Bukkit.getWorlds()) s.sendMessage(text().append(text(w.getName()+": ",SourbyCraftColors.LABEL)).append(text(w.getLoadedChunks().length+" chunks",SourbyCraftColors.DIM)).append(text(" ~"+rec,SourbyCraftColors.SUCCESS)));
-        var pl=Bukkit.getPluginManager().getPlugins(); s.sendMessage(text().append(text("Plugins ("+pl.length+"): ",SourbyCraftColors.HEADER)).append(text(Arrays.stream(pl).map(p->p.getName()).reduce((a,b)->a+", "+b).orElse("none"),SourbyCraftColors.VALUE)));
-        s.sendMessage(text().append(text("SWM: ",SourbyCraftColors.LABEL)).append(text(SwmInstaller.isInstalled()?"Installed":"Not installed",SwmInstaller.isInstalled()?SourbyCraftColors.SUCCESS:SourbyCraftColors.DIM)));
+        var pl=Bukkit.getPluginManager().getPlugins(); s.sendMessage(text().append(text("Plugins ("+pl.length+"): ",SourbyCraftColors.HEADER)).append(text(Arrays.stream(pl).map(p->p.getName()).reduce((_a,b)->_a+", "+b).orElse("none"),SourbyCraftColors.VALUE)));
+        
         return true;
     }
 }
diff --git a/src/main/java/io/papermc/paper/util/Holderable.java b/src/main/java/io/papermc/paper/util/Holderable.java
index a1927b6bcea6d7bd2b5949887e78d02ef8be38da..8c2ee35f3e0bde55734c3b62f0b23b14497769b7 100644
--- a/src/main/java/io/papermc/paper/util/Holderable.java
+++ b/src/main/java/io/papermc/paper/util/Holderable.java
@@ -37,7 +37,7 @@ public interface Holderable<M> extends Handleable<M> {
                 }
                 yield registry.get(Key.key(string));
             }
-            case JsonObjectWrapper(final JsonObject element) -> {
+            case JsonObjectWrapper(JsonObject element) -> {
                 if (!(registry instanceof final CraftRegistry<?, ?> craftRegistry) || !craftRegistry.supportsDirectHolders()) {
                     throw new IllegalArgumentException("Cannot deserialize direct holders for " + registry);
                 }
