Subject: [PATCH] feat: improved /swm with load and loaded status


diff --git a/src/main/java/dev/iyanz/sourbycraft/command/SwmCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/SwmCommand.java
index 77d1996342ff58d35f2e5559d74c69afeab78a63..736399ba8ce76f7e98dcee34ac096b5602b5dc8c 100644
--- a/src/main/java/dev/iyanz/sourbycraft/command/SwmCommand.java
+++ b/src/main/java/dev/iyanz/sourbycraft/command/SwmCommand.java
@@ -3,17 +3,18 @@ package dev.iyanz.sourbycraft.command;
 import dev.iyanz.sourbycraft.SourbyCraftColors;
 import dev.iyanz.sourbycraft.swm.SlimeWorldLoader;
 import dev.iyanz.sourbycraft.swm.SwmInstaller;
-import dev.iyanz.sourbycraft.util.BarUtil;
+import org.bukkit.Bukkit;
+import org.bukkit.World;
+import org.bukkit.WorldCreator;
 import org.bukkit.command.Command;
 import org.bukkit.command.CommandSender;
-
 import static net.kyori.adventure.text.Component.text;
 
 public class SwmCommand extends Command {
     public SwmCommand(String name) {
         super(name);
-        this.description = "SlimeWorldManager commands";
-        this.usageMessage = "/swm <list|info|status>";
+        this.description = "SlimeWorldManager — manage slime worlds";
+        this.usageMessage = "/swm <list|load|status>";
         this.setPermission("sourbycraft.command.swm");
     }
 
@@ -27,26 +28,56 @@ public class SwmCommand extends Command {
                 var worlds = SlimeWorldLoader.discoverWorlds();
                 if (worlds.isEmpty()) {
                     sender.sendMessage(text("No slime worlds found in slime_worlds/", SourbyCraftColors.DIM));
-                } else {
-                    sender.sendMessage(text("Slime Worlds (" + worlds.size() + "):", SourbyCraftColors.HEADER));
-                    for (var w : worlds) {
-                        sender.sendMessage(text()
-                            .append(text("  " + w.worldName(), SourbyCraftColors.VALUE))
-                            .append(text(" v" + w.version(), SourbyCraftColors.DIM)));
-                    }
+                    return true;
+                }
+                sender.sendMessage(text("Slime Worlds (" + worlds.size() + "):", SourbyCraftColors.HEADER));
+                for (var w : worlds) {
+                    boolean loaded = Bukkit.getWorld(w.worldName()) != null;
+                    sender.sendMessage(text()
+                        .append(text("  " + w.worldName(), loaded ? SourbyCraftColors.SUCCESS : SourbyCraftColors.VALUE))
+                        .append(text(" v" + w.version(), SourbyCraftColors.DIM))
+                        .append(text(loaded ? " [LOADED]" : "", SourbyCraftColors.SUCCESS)));
+                }
+            }
+            case "load" -> {
+                if (args.length < 2) {
+                    sender.sendMessage(text("Usage: /swm load <world>", SourbyCraftColors.DIM));
+                    return true;
                 }
+                String name = args[1];
+                if (Bukkit.getWorld(name) != null) {
+                    sender.sendMessage(text(name + " is already loaded", SourbyCraftColors.WARNING));
+                    return true;
+                }
+                var worlds = SlimeWorldLoader.discoverWorlds();
+                var found = worlds.stream().filter(w -> w.worldName().equals(name)).findFirst();
+                if (found.isEmpty()) {
+                    sender.sendMessage(text("Slime world '" + name + "' not found", SourbyCraftColors.DANGER));
+                    return true;
+                }
+                sender.sendMessage(text("Loading slime world: " + name + "...", SourbyCraftColors.LABEL));
+                Bukkit.getScheduler().runTask(Bukkit.getPluginManager().getPlugins()[0], () -> {
+                    World w = Bukkit.createWorld(WorldCreator.name(name));
+                    sender.sendMessage(text()
+                        .append(text("Loaded: ", SourbyCraftColors.SUCCESS))
+                        .append(text(w != null ? w.getName() : "FAILED", w != null ? SourbyCraftColors.VALUE : SourbyCraftColors.DANGER)));
+                });
             }
             case "status" -> {
                 boolean installed = SwmInstaller.isInstalled();
                 sender.sendMessage(text()
-                    .append(text("SWM Status: ", SourbyCraftColors.LABEL))
+                    .append(text("SWM: ", SourbyCraftColors.LABEL))
                     .append(text(installed ? "Installed" : "Not installed", installed ? SourbyCraftColors.SUCCESS : SourbyCraftColors.DANGER)));
                 var worlds = SlimeWorldLoader.discoverWorlds();
+                int loaded = (int) worlds.stream().filter(w -> Bukkit.getWorld(w.worldName()) != null).count();
                 sender.sendMessage(text()
                     .append(text("Slime worlds: ", SourbyCraftColors.LABEL))
-                    .append(text(String.valueOf(worlds.size()), SourbyCraftColors.VALUE)));
+                    .append(text(worlds.size() + " found, " + loaded + " loaded", SourbyCraftColors.VALUE)));
+                sender.sendMessage(text()
+                    .append(text("Version: ", SourbyCraftColors.DIM))
+                    .append(text("v" + dev.iyanz.sourbycraft.SourbyCraftConfig.swmVersion, SourbyCraftColors.DIM)));
             }
-            default -> sender.sendMessage(text("Usage: /swm <list|status>", SourbyCraftColors.DIM));
+            default -> sender.sendMessage(text("/swm <list|load <world>|status>", SourbyCraftColors.DIM));
         }
         return true;
     }
