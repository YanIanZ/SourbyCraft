From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Sat, 20 Jun 2026 19:27:48 +0700
Subject: [PATCH] SourbyCraft fast-boot triad: bStats kill-switch +
 update-check kill + DB driver pre-init


diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index bc838edc5edc3b3a91656cc23ff67ea28a707b0c..73b7a92ae743dd6d39b1052b1dd528b365e9fa0c 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -550,6 +550,86 @@ public final class CraftServer implements Server {
     }
 
     public void loadPlugins() {
+        // SourbyCraft fast-boot triad — runs BEFORE plugin scan. Default: ALL ON.
+        // Disable per-knob via `fast-boot.{bstats,update-checks,db-warm}: false`.
+        try {
+            // (1) bStats kill-switch. Writes plugins/bStats/config.yml with
+            // enabled=false if file missing. ~50ms × 30 plugins = ~1.5s saved
+            // (each bStats Submitter does HTTP POST + scheduler init).
+            if (dev.iyanz.sourbycraft.SourbyCraftConfig.ymlBool("fast-boot.bstats-disable", true)) {
+                java.io.File bsDir = new java.io.File("plugins/bStats");
+                java.io.File bsCfg = new java.io.File(bsDir, "config.yml");
+                if (!bsCfg.exists()) {
+                    if (bsDir.mkdirs() || bsDir.exists()) {
+                        try (java.io.FileWriter w = new java.io.FileWriter(bsCfg)) {
+                            w.write("# SourbyCraft fast-boot — bStats disabled to skip HTTP POST + scheduler init on plugin enable.\n");
+                            w.write("# To re-enable globally, set `enabled: true` here OR fast-boot.bstats-disable: false in sourbycraft.yml.\n");
+                            w.write("enabled: false\n");
+                            w.write("serverUuid: " + java.util.UUID.randomUUID().toString() + "\n");
+                            w.write("logFailedRequests: false\n");
+                            w.write("logSentData: false\n");
+                            w.write("logResponseStatusText: false\n");
+                        }
+                        org.slf4j.LoggerFactory.getLogger("SourbyCraft").info(
+                            "[fast-boot] bStats globally disabled via plugins/bStats/config.yml");
+                    }
+                }
+            }
+            // (2) Plugin update-check kill-switch. Sets Paper's flag + common
+            // plugin properties. Doesn't catch every plugin (most use custom
+            // libs) but knocks out Paper's own version check + a few that
+            // honor standard properties.
+            if (dev.iyanz.sourbycraft.SourbyCraftConfig.ymlBool("fast-boot.update-checks-disable", true)) {
+                System.setProperty("Paper.disableUpdateChecker", "true");
+                System.setProperty("paper.disablePluginUpdateCheck", "true");
+                System.setProperty("disable.update.check", "true");
+                org.slf4j.LoggerFactory.getLogger("SourbyCraft").info(
+                    "[fast-boot] plugin update-check properties set (Paper + standard); per-plugin tuning still recommended");
+            }
+            // (3) DB driver pre-init. Most slow plugins (PlayerAuctions,
+            // Hikari users, H2 users) bottleneck on first JDBC driver
+            // classload + service-loader scan. Force-load known drivers via
+            // virtual-thread pool BEFORE plugin onEnable.
+            if (dev.iyanz.sourbycraft.SourbyCraftConfig.ymlBool("fast-boot.db-driver-warm", true)) {
+                java.util.concurrent.ExecutorService dbWarm = java.util.concurrent.Executors.newVirtualThreadPerTaskExecutor();
+                String[] drivers = {
+                    "org.sqlite.JDBC",
+                    "org.h2.Driver",
+                    "com.mysql.cj.jdbc.Driver",
+                    "org.postgresql.Driver",
+                    "org.mariadb.jdbc.Driver",
+                    "org.hsqldb.jdbc.JDBCDriver",
+                    // Hikari + supporting classes
+                    "com.zaxxer.hikari.HikariConfig",
+                    "com.zaxxer.hikari.HikariDataSource",
+                    "com.zaxxer.hikari.pool.HikariPool",
+                };
+                final java.util.concurrent.atomic.AtomicInteger loaded = new java.util.concurrent.atomic.AtomicInteger();
+                for (String d : drivers) {
+                    final String driverName = d;
+                    dbWarm.submit(() -> {
+                        try {
+                            Class.forName(driverName, true, this.getClass().getClassLoader());
+                            loaded.incrementAndGet();
+                        } catch (Throwable ignored) {}
+                    });
+                }
+                dbWarm.shutdown();
+                try {
+                    dbWarm.awaitTermination(3, java.util.concurrent.TimeUnit.SECONDS);
+                } catch (InterruptedException ie) {
+                    Thread.currentThread().interrupt();
+                }
+                if (loaded.get() > 0) {
+                    org.slf4j.LoggerFactory.getLogger("SourbyCraft").info(
+                        "[fast-boot] DB drivers warmed (" + loaded.get() + "/" + drivers.length + ")");
+                }
+            }
+        } catch (Throwable t) {
+            org.slf4j.LoggerFactory.getLogger("SourbyCraft").warn(
+                "[fast-boot] error (continuing boot): " + t.getMessage());
+        }
+
         // SourbyCraft v12 — auto-install bundled plugins before plugin scan
         try {
             boolean autoInstall = dev.iyanz.sourbycraft.SourbyCraftConfig.ymlBool("auto-install.enabled", true);
