+    // SourbyCraft start - entity obfuscation
+    private final dev.iyanz.sourbycraft.SourbyCraftWorldConfig sourbycraftWorldConfig;
+
+    public boolean isEntityVisibleTo(net.minecraft.world.entity.Entity entity, net.minecraft.server.level.ServerPlayer player) {
+        if (!sourbycraftWorldConfig.entityObfuscation) return true;
+        if (player.isSpectator()) return true;
+        if (player.getBukkitEntity().hasPermission("paper.antixray.bypass")) return true;
+        if (entity instanceof net.minecraft.world.entity.TamableAnimal tamable && tamable.getOwner() != null && player.getUUID().equals(tamable.getOwner().getUUID())) return true;
+        double distSq = player.distanceToSqr(entity);
+        long range = sourbycraftWorldConfig.entityObfuscationRange;
+        if (distSq > range * range) return true;
+
+        net.minecraft.world.phys.Vec3 eyePos = player.getEyePosition();
+        net.minecraft.world.phys.AABB bb = entity.getBoundingBox();
+        double sizeX = bb.getXsize();
+        double sizeY = bb.getYsize();
+        double sizeZ = bb.getZsize();
+        double maxDim = Math.max(sizeX, Math.max(sizeY, sizeZ));
+
+        if (maxDim < 1.5) {
+            net.minecraft.world.phys.Vec3 target = entity.getEyePosition();
+            return !isBlocked(eyePos, target, player);
+        }
+
+        double mx = (sizeX > 1.0) ? 2 : 0;
+        double my = (sizeY > 1.0) ? 2 : 1;
+        double mz = (sizeZ > 1.0) ? 2 : 0;
+        double precision = 0.25;
+
+        for (int xi = 0; xi <= mx; xi++) {
+            for (int yi = 0; yi <= my; yi++) {
+                for (int zi = 0; zi <= mz; zi++) {
+                    double dx = xi == 0 ? bb.minX + precision : (xi == 2 ? bb.maxX - precision : (bb.minX + bb.maxX) * 0.5);
+                    double dy = yi == 0 ? bb.minY + precision : (yi == 2 ? bb.maxY - precision : (bb.minY + bb.maxY) * 0.5);
+                    double dz = zi == 0 ? bb.minZ + precision : (zi == 2 ? bb.maxZ - precision : (bb.minZ + bb.maxZ) * 0.5);
+                    net.minecraft.world.phys.Vec3 target = new net.minecraft.world.phys.Vec3(dx, dy, dz);
+                    if (!isBlocked(eyePos, target, player)) return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    private boolean isBlocked(net.minecraft.world.phys.Vec3 from, net.minecraft.world.phys.Vec3 to, net.minecraft.server.level.ServerPlayer player) {
+        net.minecraft.world.level.ClipContext ctx = new net.minecraft.world.level.ClipContext(
+            from, to,
+            net.minecraft.world.level.ClipContext.Block.VISUAL,
+            net.minecraft.world.level.ClipContext.Fluid.ANY,
+            player
+        );
+        net.minecraft.world.phys.BlockHitResult hit = player.level().clip(ctx);
+        return hit.getType() == net.minecraft.world.phys.HitResult.Type.BLOCK;
+    }
+
+    public boolean isPositionVisibleTo(net.minecraft.world.phys.Vec3 position, net.minecraft.server.level.ServerPlayer player) {
+        if (player.isSpectator()) return true;
+        if (player.getBukkitEntity().hasPermission("paper.antixray.bypass")) return true;
+        if (player.distanceToSqr(position) > 64.0 * 64.0) return true;
+        net.minecraft.world.phys.Vec3 eyePos = player.getEyePosition();
+        return !isBlocked(eyePos, position, player);
+    }
+    // SourbyCraft end
+
