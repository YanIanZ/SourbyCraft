         this.usageMessage = "/tpsbar";
         this.setPermission("sourbycraft.command.tpsbar");
     }
 
     @Override
     public boolean execute(CommandSender sender, String alias, String[] args) {
+        if (!(sender instanceof Player player)) {
+            sender.sendMessage("This command can only be used by players.");
+            return true;
+        }
         if (!this.testPermission(sender)) return true;
 
-        double[] tps = org.bukkit.Bukkit.getTPS();
-        sender.sendMessage(text()
-            .append(text("TPS:  ", SourbyCraftColors.LABEL))
-            .append(BarUtil.coloredBar(Math.min(tps[0] * 5, 100), 20))
-            .append(text(" " + tps[0], tps[0] > 18 ? SourbyCraftColors.SUCCESS : SourbyCraftColors.DANGER)));
-
-        double mspt = org.bukkit.Bukkit.getAverageTickTime();
-        sender.sendMessage(text()
-            .append(text("MSPT: ", SourbyCraftColors.LABEL))
-            .append(BarUtil.coloredBar(Math.max(0, 100 - mspt * 2), 20))
-            .append(text(" " + mspt + "ms", mspt < 40 ? SourbyCraftColors.SUCCESS : SourbyCraftColors.DANGER)));
+        if (tpsBar == null) {
+            tpsBar = BossBar.bossBar(text("TPS", SourbyCraftColors.HEADER), 1.0f, BossBar.Color.GREEN, BossBar.Overlay.PROGRESS);
+        }
 
+        double[] tps = Bukkit.getTPS();
+        double mspt = Bukkit.getAverageTickTime();
         Runtime rt = Runtime.getRuntime();
         long max = rt.maxMemory(), used = rt.totalMemory() - rt.freeMemory();
-        double pct = max == Long.MAX_VALUE ? (double) used / rt.totalMemory() * 100 : (double) used / max * 100;
-        sender.sendMessage(text()
-            .append(text("RAM:  ", SourbyCraftColors.LABEL))
-            .append(BarUtil.coloredBar(pct, 20))
-            .append(text(" " + (used / 1048576) + "/" + (max == Long.MAX_VALUE ? BarUtil.INFINITY : (max / 1048576) + "MB"), SourbyCraftColors.VALUE)));
+        double memPct = max == Long.MAX_VALUE ? (double) used / rt.totalMemory() * 100 : (double) used / max * 100;
+
+        float progress = (float) Math.clamp(tps[0] / 20.0, 0.0, 1.0);
+        tpsBar.progress(progress);
+        tpsBar.color(tps[0] > 18 ? BossBar.Color.GREEN : tps[0] > 15 ? BossBar.Color.YELLOW : BossBar.Color.RED);
+        tpsBar.name(text("TPS: " + BarUtil.bar(tps[0] * 5, 20) + " " + tps[0] + " | MSPT: " + mspt + "ms | RAM: " + BarUtil.bar(memPct, 20) + " " + (int) memPct + "%", SourbyCraftColors.VALUE));
 
+        player.showBossBar(tpsBar);
+        Bukkit.getScheduler().runTaskLater(Bukkit.getPluginManager().getPlugins()[0], () -> player.hideBossBar(tpsBar), 100L);
