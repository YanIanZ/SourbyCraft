TpsBarCommand, RamBarCommand: replace Bukkit.getPluginManager().getPlugins()[0]
with WildstackerManager.ownerPlugin() — the legacy SimplePluginManager can return
an empty array under Paper's PaperPluginManagerImpl, causing AIOOBE on /tpsbar
and /rambar. New helper bridges both managers with null-safety guard.

SysCommand: add wildstacker config line (enabled/disabled, radius, hologram, los).

diff --git a/src/main/java/dev/iyanz/sourbycraft/command/RamBarCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/RamBarCommand.java
index f80a2f3defe80a0350c9da42775be9146ab9f6a8..1781c58309717cc059eedafd652b74e0f3ad498d 100644
--- a/src/main/java/dev/iyanz/sourbycraft/command/RamBarCommand.java
+++ b/src/main/java/dev/iyanz/sourbycraft/command/RamBarCommand.java
@@ -1,5 +1,6 @@
 package dev.iyanz.sourbycraft.command;
 import dev.iyanz.sourbycraft.SourbyCraftColors;
+import dev.iyanz.sourbycraft.wildstacker.WildstackerManager;
 import net.kyori.adventure.bossbar.BossBar;
 import org.bukkit.Bukkit;
 import org.bukkit.command.Command;
@@ -57,10 +58,16 @@ public class RamBarCommand extends Command {
             return true;
         }
 
+        org.bukkit.plugin.Plugin __owner = WildstackerManager.ownerPlugin();
+        if (__owner == null) {
+            sender.sendMessage("Server not ready (no plugin owner)");
+            return true;
+        }
+
         final BossBar bar = BossBar.bossBar(text("RAM", SourbyCraftColors.HEADER), 0f, BossBar.Color.GREEN, BossBar.Overlay.PROGRESS);
         bars.put(uuid, bar);
 
-        int task = Bukkit.getScheduler().scheduleSyncRepeatingTask(Bukkit.getPluginManager().getPlugins()[0], () -> {
+        int task = Bukkit.getScheduler().scheduleSyncRepeatingTask(__owner, () -> {
             if (!target.isOnline()) {
                 BossBar b = bars.remove(uuid);
                 Integer tid = tasks.remove(uuid);
diff --git a/src/main/java/dev/iyanz/sourbycraft/command/SysCommand.java b/src/main/java/dev/iyanz/sourbycraft/command/SysCommand.java
index 3f44847e981214e975924e44b5fb3c085069be58..e840251bbed9babb3cbd3359237fb1730d058893 100644
--- a/src/main/java/dev/iyanz/sourbycraft/command/SysCommand.java
+++ b/src/main/java/dev/iyanz/sourbycraft/command/SysCommand.java
@@ -1,5 +1,6 @@
 package dev.iyanz.sourbycraft.command;
 import dev.iyanz.sourbycraft.SourbyCraftColors;
+import dev.iyanz.sourbycraft.SourbyCraftConfig;
 import dev.iyanz.sourbycraft.util.BarUtil;
 // SWM v2 built-in
 import org.bukkit.Bukkit;
@@ -24,6 +25,14 @@ public class SysCommand extends Command {
         int rec=Math.max(3,(Runtime.getRuntime().availableProcessors()*3)/Math.max(1,Bukkit.getWorlds().size()));
         for(World w:Bukkit.getWorlds()) s.sendMessage(text().append(text(w.getName()+": ",SourbyCraftColors.LABEL)).append(text(w.getLoadedChunks().length+" chunks",SourbyCraftColors.DIM)).append(text(" ~"+rec,SourbyCraftColors.SUCCESS)));
         var pl=Bukkit.getPluginManager().getPlugins(); s.sendMessage(text().append(text("Plugins ("+pl.length+"): ",SourbyCraftColors.HEADER)).append(text(Arrays.stream(pl).map(p->p.getName()).reduce((x,y)->x+", "+y).orElse("none"),SourbyCraftColors.VALUE)));
+        // SourbyCraft v9.18 - wildstacker status
+        s.sendMessage(text().append(text("Stack: ", SourbyCraftColors.LABEL))
+            .append(text(SourbyCraftConfig.wildstackerEnabled ? "enabled" : "disabled",
+                SourbyCraftConfig.wildstackerEnabled ? SourbyCraftColors.SUCCESS : SourbyCraftColors.DIM))
+            .append(text(" | radius=" + SourbyCraftConfig.itemMergeRadius
+                + " | hologram=" + (SourbyCraftConfig.wildstackerHologram ? "on" : "off")
+                + " | los=" + (SourbyCraftConfig.wildstackerLosCheck ? "on" : "off"),
+                SourbyCraftColors.DIM)));
         s.sendMessage(text().append(text("/swm info",SourbyCraftColors.DIM)));
         return true;
     }
