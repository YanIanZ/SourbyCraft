# Local agent/IDE tooling (each developer keeps their own copy)
CLAUDE.md
opencode.json
.run/
.claude/
.superpowers/
graphify-out/
.worktrees/
docs/superpowers/

# Local patch parking lot: patches that need a rebase or manual port
sourbycraft-server/minecraft-patches/features/.skipped/
sourbycraft-server/paper-patches/.skipped/
sourbyapi/paper-patches/.skipped/

# Private maintainer build-tool checkouts; never archive or cache in public CI.
.private-toolchain/
# Release signing private key (SEC-2): generated outside the repo by scripts/release_signing_key.py; never commit it
sourbycraft-release.key
.env
.env.*

# Build and release artifacts, published via GitHub releases
release/
sourbycraft-server/src/main/resources/GeoLite2-City.mmdb
*.py[cod]
*.log
*.log.gz
*.tmp
*.bak
*.swp
Thumbs.db
local.properties

