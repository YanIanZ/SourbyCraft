TestServer/
/data/
cache/
libraries/
versions/
crash-reports/
eula.txt
server.properties
banned-*.json
ops.json
whitelist.json
usercache.json
world*/
# Source packages and Minecraft source patches named world are source, not server saves.
!/sourbycraft-server/minecraft-patches/sources/net/minecraft/world/
!/sourbyapi/src/**/world/
!/sourbycraft-server/src/**/world/
!**/src/main/java/**/world/
!**/src/main/java/**/world/**
