From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: YanIanZ <iwayanbagusaryadarma@student.telkomuniversity.ac.id>
Date: Wed, 21 Oct 2026 02:14:20 +0700
Subject: [PATCH] SourbyCraft - owned refusal messages and off-region tick time

Server#reload, reloadData, unloadWorld, restart, Datapack#setEnabled, the Bukkit scheduler for non-bridged plugins, the ServerTickManager, MCUtil#ensureMain and /restart throw dev.iyanz.sourbycraft.guards.RegionRefusal messages that keep the legacy prefix and name the supported alternative. Server#getAverageTickTime reports the global tick's figure off any region (as getTPS does), and World#getTickableTileEntityCount sums the regions' published counts instead of throwing.

diff --git a/src/main/java/io/papermc/paper/datapack/PaperDatapack.java b/src/main/java/io/papermc/paper/datapack/PaperDatapack.java
index 113b858e507326a6ebbc4d9b1658fed3cd16b86c..8a04d155e04d9a0b7cbf25225db07f9e6872fdf5 100644
--- a/src/main/java/io/papermc/paper/datapack/PaperDatapack.java
+++ b/src/main/java/io/papermc/paper/datapack/PaperDatapack.java
@@ -30,7 +30,7 @@ public class PaperDatapack extends PaperDiscoveredDatapack implements Datapack {
     public void setEnabled(final boolean enabled) {
         // Canvas start - region threading
         if (true) {
-            throw new UnsupportedOperationException("Unsupported in region threading");
+            throw dev.iyanz.sourbycraft.guards.RegionRefusal.DATAPACK_TOGGLE.error();
         }
         // Canvas end - region threading
         final MinecraftServer server = MinecraftServer.getServer();
diff --git a/src/main/java/io/papermc/paper/util/MCUtil.java b/src/main/java/io/papermc/paper/util/MCUtil.java
index d8f9970242d4935c780ba4982ab0185590f4455a..180c748d48c2f49edfe9e9c7b631cc7afbb6fc2e 100644
--- a/src/main/java/io/papermc/paper/util/MCUtil.java
+++ b/src/main/java/io/papermc/paper/util/MCUtil.java
@@ -126,7 +126,7 @@ public final class MCUtil {
      */
     public static void ensureMain(String reason, Runnable run) {
         if (!isMainThread()) {
-            if (true) throw new UnsupportedOperationException("Unsupported in region threading"); // Folia - region threading
+            if (true) throw dev.iyanz.sourbycraft.guards.RegionRefusal.ENSURE_MAIN.error(); // Folia - region threading - SourbyCraft: owned refusal message
             if (reason != null) {
                 MinecraftServer.LOGGER.warn("Asynchronous " + reason + "!", new IllegalStateException());
             }
@@ -145,7 +145,7 @@ public final class MCUtil {
      */
     public static <T> T ensureMain(String reason, Supplier<T> run) {
         if (!isMainThread()) {
-            if (true) throw new UnsupportedOperationException("Unsupported in region threading"); // Canvas - region threading
+            if (true) throw dev.iyanz.sourbycraft.guards.RegionRefusal.ENSURE_MAIN.error(); // Canvas - region threading - SourbyCraft: owned refusal message
             if (reason != null) {
                 MinecraftServer.LOGGER.warn("Asynchronous " + reason + "! Blocking thread until it returns ", new IllegalStateException());
             }
