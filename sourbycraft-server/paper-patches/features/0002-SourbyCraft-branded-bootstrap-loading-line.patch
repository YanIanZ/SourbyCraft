From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: YanIanZ <iwayanbagusaryadarma@student.telkomuniversity.ac.id>
Date: Thu, 22 Oct 2026 04:57:02 +0700
Subject: [PATCH] SourbyCraft - branded bootstrap loading line


diff --git a/src/main/java/io/papermc/paper/PaperBootstrap.java b/src/main/java/io/papermc/paper/PaperBootstrap.java
index 5d24f049fa88ed619c7793cf57525aca641a6df7..0221f05040b97b12629482949a38e954623792a1 100644
--- a/src/main/java/io/papermc/paper/PaperBootstrap.java
+++ b/src/main/java/io/papermc/paper/PaperBootstrap.java
@@ -36,24 +36,20 @@ public final class PaperBootstrap {
         final String osArch = System.getProperty("os.arch");
 
         final ServerBuildInfo bi = ServerBuildInfo.buildInfo();
-        return List.of(
-            String.format(
-                "Running Java %s (%s %s; %s %s) on %s %s (%s)",
-                javaSpecVersion,
-                javaVmName,
-                javaVmVersion,
-                javaVendor,
-                javaVendorVersion,
-                osName,
-                osVersion,
-                osArch
-            ),
-            String.format(
-                "Loading %s %s for Minecraft %s",
-                bi.brandName(),
-                bi.asString(ServerBuildInfo.StringRepresentation.VERSION_FULL),
-                bi.minecraftVersionId()
-            )
+        // SourbyCraft start - the two launch lines (build identity + runtime) in place of Paper's
+        // "Running Java ..." / "Loading <brand> <version>" pair; text in brand/LaunchLines, never throws.
+        return dev.iyanz.sourbycraft.brand.LaunchLines.bootstrap(
+            bi.brandName(),
+            bi.minecraftVersionId(),
+            javaSpecVersion,
+            javaVmName,
+            javaVmVersion,
+            javaVendor,
+            javaVendorVersion,
+            osName,
+            osVersion,
+            osArch
         );
+        // SourbyCraft end
     }
 }
