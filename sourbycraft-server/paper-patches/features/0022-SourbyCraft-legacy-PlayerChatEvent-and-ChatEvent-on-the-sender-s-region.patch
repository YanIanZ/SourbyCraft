From: YanIanZ <iwayanbagusaryadarma@student.telkomuniversity.ac.id>
Date: Thu, 22 Oct 2026 02:03:18 +0700
Subject: [PATCH] SourbyCraft - legacy PlayerChatEvent and ChatEvent on the
 sender's region

The region-threading base disabled the deprecated synchronous chat
events (their Waitable went to the main-thread queue, which nothing
drains), so legacy chat/format plugins listening only to them never saw
a message. With listeners they fire again in Paper's order, on the
thread that owns the sender: inline when the caller owns the player,
otherwise through the player's entity scheduler while the chat thread
waits, bounded (LegacyChat, 5 s to start, 5 s more to finish). Cancel,
message, format and recipients are honoured as on Paper; a message
whose event could not be delivered in time is dropped.

diff --git a/src/main/java/io/papermc/paper/adventure/ChatProcessor.java b/src/main/java/io/papermc/paper/adventure/ChatProcessor.java
index 794feeef692f123420fd5451c53d5986bae454e9..7b25d5efaf16b1b69bda54258c0a28ff31f89b07 100644
--- a/src/main/java/io/papermc/paper/adventure/ChatProcessor.java
+++ b/src/main/java/io/papermc/paper/adventure/ChatProcessor.java
@@ -83,16 +83,16 @@ public final class ChatProcessor {
             final CraftPlayer player = this.player.getBukkitEntity();
             final AsyncPlayerChatEvent asyncChatEvent = new AsyncPlayerChatEvent(this.async, player, this.craftbukkit$originalMessage, new LazyPlayerSet(this.server));
             this.post(asyncChatEvent);
-            if (false && listenersOnSyncEvent) { // Folia - region threading
+            if (listenersOnSyncEvent) { // SourbyCraft - legacy PlayerChatEvent on the sender's region, bounded wait
                 final PlayerChatEvent chatEvent = new PlayerChatEvent(player, asyncChatEvent.getMessage(), asyncChatEvent.getFormat(), asyncChatEvent.getRecipients());
                 chatEvent.setCancelled(asyncChatEvent.isCancelled()); // propagate cancelled state
-                this.queueIfAsyncOrRunImmediately(new Waitable<>() {
+                if (!this.queueIfAsyncOrRunImmediately(new Waitable<>() { // SourbyCraft - not delivered in time: the message is dropped
                     @Override
                     protected Void evaluate() {
                         ChatProcessor.this.post(chatEvent);
                         return null;
                     }
-                });
+                })) return; // SourbyCraft - not delivered in time: the message is dropped
                 this.readLegacyModifications(chatEvent.getMessage(), chatEvent.getFormat(), chatEvent.getPlayer());
                 this.processModern(
                     this.modernRenderer(chatEvent.getFormat()),
@@ -150,7 +150,7 @@ public final class ChatProcessor {
         ae.setCancelled(cancelled); // propagate cancelled state
         this.post(ae);
         final boolean listenersOnSyncEvent = canYouHearMe(ChatEvent.getHandlerList());
-        if (false && listenersOnSyncEvent) { // Folia - region threading
+        if (listenersOnSyncEvent) { // SourbyCraft - legacy ChatEvent on the sender's region, bounded wait
             this.queueIfAsyncOrRunImmediately(new Waitable<>() {
                 @Override
                 protected Void evaluate() {
@@ -359,11 +359,9 @@ public final class ChatProcessor {
         return String.format(format, legacyDisplayName((CraftPlayer) player), message);
     }
 
-    private void queueIfAsyncOrRunImmediately(final Waitable<Void> waitable) {
-        if (this.async) {
-            this.server.processQueue.add(waitable);
-        } else {
-            waitable.run();
+    private boolean queueIfAsyncOrRunImmediately(final Waitable<Void> waitable) { // SourbyCraft - on the sender's region; false when not delivered in time
+        if (!dev.iyanz.sourbycraft.guards.LegacyChat.onSenderRegion(this.player, this.async, waitable)) { // SourbyCraft - on the sender's region; false when not delivered in time
+            return false; // SourbyCraft - on the sender's region; false when not delivered in time
         }
         try {
             waitable.get();
@@ -372,6 +370,7 @@ public final class ChatProcessor {
         } catch (final ExecutionException e) {
             throw new RuntimeException("Exception processing chat", e.getCause());
         }
+        return true; // SourbyCraft - on the sender's region; false when not delivered in time
     }
 
     private void post(final Event event) {
