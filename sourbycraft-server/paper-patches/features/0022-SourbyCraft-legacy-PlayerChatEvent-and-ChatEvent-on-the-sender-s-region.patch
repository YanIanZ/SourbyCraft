-                        return null;
-                    }
-                });
+                this.onSenderRegion(() -> ChatProcessor.this.post(chatEvent), () -> { // SourbyCraft - legacy PlayerChatEvent on the sender's region; the message continues only after it ran
                 this.readLegacyModifications(chatEvent.getMessage(), chatEvent.getFormat(), chatEvent.getPlayer());
                 this.processModern(
                     this.modernRenderer(chatEvent.getFormat()),
@@ -101,6 +95,7 @@ public final class ChatProcessor {
                     chatEvent.getPlayer(),
