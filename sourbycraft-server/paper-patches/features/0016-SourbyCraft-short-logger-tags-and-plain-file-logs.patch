From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: YanIanZ <iwayanbagusaryadarma@student.telkomuniversity.ac.id>
Date: Wed, 21 Oct 2026 01:28:01 +0700
Subject: [PATCH] SourbyCraft - short logger tags and plain file logs


diff --git a/src/main/resources/log4j2.xml b/src/main/resources/log4j2.xml
index 86451d114ca7afec3695448615be092c8129bf57..0cb04faf39eebcdd4f5c50ac85e69176782be1c4 100644
--- a/src/main/resources/log4j2.xml
+++ b/src/main/resources/log4j2.xml
@@ -6,26 +6,23 @@
         </Queue>
         <TerminalConsole name="TerminalConsole">
             <PatternLayout>
-                <LoggerNamePatternSelector defaultPattern="%highlightError{[%d{HH:mm:ss} %level]: [%logger] %msg%n%xEx{full}}">
+                <!-- SourbyCraft start - short tags for internal loggers (%scLogger), escape codes only on a real terminal (%ansiIfTerminal), message and exception included -->
+                <LoggerNamePatternSelector defaultPattern="%highlightError{%ansiIfTerminal{[%d{HH:mm:ss} %level]: %scLogger{console} %msg%n%xEx{full}}}">
                     <!-- Log root, Minecraft, Mojang and Bukkit loggers without prefix -->
                     <!-- Disable prefix for various plugins that bypass the plugin logger -->
                     <PatternMatch key=",net.minecraft.,Minecraft,com.mojang.,com.sk89q.,ru.tehkode.,Minecraft.AWE"
-                                  pattern="%highlightError{[%d{HH:mm:ss} %level]: %msg%n%xEx{full}}" />
-                    <!-- SourbyCraft - paint the [SourbyCraft] engine prefix yellow on the console
-                         only (the message + everything else keep their normal colours; the File
-                         and ServerGuiConsole appenders below stay uncoloured). -->
-                    <PatternMatch key="SourbyCraft"
-                                  pattern="%highlightError{[%d{HH:mm:ss} %level]: %style{[%logger]}{yellow} %msg%n%xEx{full}}" />
+                                  pattern="%highlightError{%ansiIfTerminal{[%d{HH:mm:ss} %level]: %msg%n%xEx{full}}}" />
                 </LoggerNamePatternSelector>
+                <!-- SourbyCraft end -->
             </PatternLayout>
         </TerminalConsole>
         <RollingRandomAccessFile name="File" fileName="logs/latest.log" filePattern="logs/%d{yyyy-MM-dd}-%i.log.gz">
             <PatternLayout>
-                <LoggerNamePatternSelector defaultPattern="[%d{HH:mm:ss}] [%t/%level]: [%logger] %stripAnsi{%msg}%n%xEx{full}">
+                <LoggerNamePatternSelector defaultPattern="[%d{HH:mm:ss}] [%t/%level]: %scLogger %plainText{%msg%n%xEx{full}}">
                     <!-- Log root, Minecraft, Mojang and Bukkit loggers without prefix -->
                     <!-- Disable prefix for various plugins that bypass the plugin logger -->
                     <PatternMatch key=",net.minecraft.,Minecraft,com.mojang.,com.sk89q.,ru.tehkode.,Minecraft.AWE"
-                                  pattern="[%d{HH:mm:ss}] [%t/%level]: %stripAnsi{%msg}%n%xEx{full}" />
+                                  pattern="[%d{HH:mm:ss}] [%t/%level]: %plainText{%msg%n%xEx{full}}" />
                 </LoggerNamePatternSelector>
             </PatternLayout>
             <Policies>
@@ -44,6 +41,10 @@
         <Root level="info">
             <filters>
                 <MarkerFilter marker="NETWORK_PACKETS" onMatch="DENY" onMismatch="NEUTRAL" />
+                <!-- SourbyCraft start - print known repeated startup lines once (same text only) -->
+                <RepeatedMessageFilter logger="oshi." message="Unable to parse version" level="WARN" />
+                <RepeatedMessageFilter logger="Tick" message="Region tick threads: " level="INFO" />
+                <!-- SourbyCraft end -->
             </filters>
             <AppenderRef ref="Async"/>
         </Root>
