@@ -106,6 +128,7 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
     @Override
     public void cancelTasks(final Plugin plugin) {
         Objects.requireNonNull(plugin, "Plugin may not be null");
+        dev.iyanz.sourbycraft.bridge.AuroraBridge.cancelGlobal(plugin); // SourbyCraft - adapted LightingLuminol cancellation; release bridge indexes
 
