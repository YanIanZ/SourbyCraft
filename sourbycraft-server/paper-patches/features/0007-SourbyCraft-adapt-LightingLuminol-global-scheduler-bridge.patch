+    @org.jetbrains.annotations.ApiStatus.Internal
+    public ScheduledTask runDelayedNative(final Plugin plugin, final Consumer<ScheduledTask> task, final long delayTicks) {
+        // SourbyCraft end - LightingLuminol global scheduler compatibility
         Objects.requireNonNull(plugin, "Plugin may not be null");
         Objects.requireNonNull(task, "Task may not be null");
         if (delayTicks <= 0) {
@@ -78,6 +89,17 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
 
     @Override
     public ScheduledTask runAtFixedRate(final Plugin plugin, final Consumer<ScheduledTask> task, final long initialDelayTicks, final long periodTicks) {
+        // SourbyCraft start - LightingLuminol global scheduler compatibility (GPL v3)
+        if (dev.iyanz.sourbycraft.bridge.FoliaSchedulerCompatibility.shouldUseBukkitScheduler(plugin)) {
+            return dev.iyanz.sourbycraft.bridge.FoliaSchedulerCompatibility.runAtFixedRateOnBukkit(plugin, task, initialDelayTicks, periodTicks);
+        }
+        return this.runAtFixedRateNative(plugin, task, initialDelayTicks, periodTicks);
+    }
+
+    /** Server-internal bridge backend; retains global ownership without scheduler recursion. */
+    @org.jetbrains.annotations.ApiStatus.Internal
+    public ScheduledTask runAtFixedRateNative(final Plugin plugin, final Consumer<ScheduledTask> task, final long initialDelayTicks, final long periodTicks) {
+        // SourbyCraft end - LightingLuminol global scheduler compatibility
         Objects.requireNonNull(plugin, "Plugin may not be null");
         Objects.requireNonNull(task, "Task may not be null");
