@@ -54,6 +54,17 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
 
     @Override
     public ScheduledTask runDelayed(final Plugin plugin, final Consumer<ScheduledTask> task, final long delayTicks) {
+        // SourbyCraft start - LightingLuminol global scheduler compatibility (GPL v3)
+        if (dev.iyanz.sourbycraft.bridge.FoliaSchedulerCompatibility.shouldUseBukkitScheduler(plugin)) {
+            return dev.iyanz.sourbycraft.bridge.FoliaSchedulerCompatibility.runDelayedOnBukkit(plugin, task, delayTicks);
+        }
+        return this.runDelayedNative(plugin, task, delayTicks);
+    }
