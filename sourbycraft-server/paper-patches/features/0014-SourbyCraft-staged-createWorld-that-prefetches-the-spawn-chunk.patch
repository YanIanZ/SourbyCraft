diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index b4c71419c4c30e8e372156bd3c8d469f9ee2aa12..c28670e81063e12b9b83783bb87a5aa71aca8005 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -1198,6 +1198,28 @@ public final class CraftServer implements Server {
 
     @Override
     public World createWorld(WorldCreator creator) {
+        // SourbyCraft start - staged world creation
+        final Object constructed = this.sourbycraft$constructWorld(creator);
+        if (!(constructed instanceof ServerLevel serverLevel)) {
+            return (World) constructed; // the world that already exists, or null
+        }
+        this.console.addLevel(serverLevel);
+        this.console.initWorld(serverLevel, creator);
+
+        serverLevel.setSpawnSettings(true);
+
+        this.getServer().prepareLevel(serverLevel);
+
+        return serverLevel.getWorld();
+    }
+
+    /**
+     * {@link #createWorld} up to and including the construction of the new level, which registers
+     * its CraftWorld: the world that already exists under that name, {@code null}, or the new
+     * {@link ServerLevel}.
+     */
+    private Object sourbycraft$constructWorld(WorldCreator creator) {
+        // SourbyCraft end - staged world creation
         dev.iyanz.aurora.engine.util.TickGuard.ensureGlobalOrStartup("Cannot create worlds off global tick"); // Canvas - region threading
         Preconditions.checkState(this.console.getAllLevels().iterator().hasNext(), "Cannot create additional worlds on STARTUP");
         //Preconditions.checkState(!this.console.isIteratingOverLevels, "Cannot create a world while worlds are being ticked"); // Paper - Cat - Temp disable. We'll see how this goes.
@@ -1339,15 +1361,138 @@ public final class CraftServer implements Server {
             return null;
         }
 
-        this.console.addLevel(serverLevel);
-        this.console.initWorld(serverLevel, creator);
+        // SourbyCraft start - staged world creation
+        return serverLevel;
