From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: YanIanZ <iwayanbagusaryadarma@student.telkomuniversity.ac.id>
Date: Tue, 6 Oct 2026 16:36:29 +0700
Subject: [PATCH] SourbyCraft - report the global tick TPS off any region


diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index ffabbcf8ff320c1c606e7f5a5b314299fb319da4..88044ae59f6697a7379fd01dbe052f43d7cd5bd4 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -2943,6 +2943,12 @@ public final class CraftServer implements Server {
                 task = io.papermc.paper.threadedregions.TickRegionScheduler.getCurrentRegion().getData().getRegionSchedulingHandle();
             }
         }
+        // SourbyCraft start - off any region (an async task, a bridged legacy plugin's profiler), report
+        // the global tick's TPS instead of throwing: reading a rate needs no region ownership.
+        if (task == null) {
+            task = io.papermc.paper.threadedregions.RegionizedServer.getGlobalTickData();
+        }
+        // SourbyCraft end
         if (!(task instanceof io.papermc.paper.threadedregions.TickRegionScheduler.RegionScheduleHandle tickHandle)) {
             throw new UnsupportedOperationException("Not on any region");
         }
