diff --git a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
index 8e5f470fd0b98d3894d7a5234386ff4cbe127f78..d9568e4f80e71b1daa4e2fb314d7ed7d9a6aa4ec 100644
--- a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
+++ b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
@@ -58,7 +58,7 @@ public class TickThread extends Thread {
         if (!isTickThreadFor(world, pos) && !me.earthme.luminol.config.modules.experiment.DisableAsyncCatcherConfig.enabled) { // Luminol
             final String ex = "Thread failed main thread check: " +
                                reason + ", context=" + getThreadContext() + ", world=" + WorldUtil.getWorldName(world) + ", block_pos=" + pos;
-            LOGGER.error(ex, new Throwable());
+            logViolation(ex); // SourbyCraft - dedupe off-region violation dumps
             throw new IllegalStateException(ex);
         }
     }
@@ -67,16 +67,46 @@ public class TickThread extends Thread {
         if (!isTickThreadFor(world, pos, blockRadius) && !me.earthme.luminol.config.modules.experiment.DisableAsyncCatcherConfig.enabled) { // Luminol
             final String ex = "Thread failed main thread check: " +
                 reason + ", context=" + getThreadContext() + ", world=" + WorldUtil.getWorldName(world) + ", block_pos=" + pos + ", block_radius=" + blockRadius;
-            LOGGER.error(ex, new Throwable());
+            logViolation(ex); // SourbyCraft - dedupe off-region violation dumps
             throw new IllegalStateException(ex);
         }
     }
 
+
+    // SourbyCraft start - dedupe off-region violation dumps
+    // A buggy plugin loop (e.g. a scheduler backend touching region-owned entities from the
+    // global thread) repeats the SAME violation every few ticks; a full stack + entity dump per
+    // occurrence floods the log. The throw below is untouched — Folia semantics stay hard — but
+    // the full dump logs once per offending PLUGIN call-site, then a single line per repeat.
+    private static final java.util.Set<String> DUMPED_SITES = java.util.concurrent.ConcurrentHashMap.newKeySet();
+    private static final int MAX_DUMPED_SITES = 256;
+
+    private static void logViolation(final String ex) {
+        final Throwable trace = new Throwable();
+        String site = "unknown";
+        for (final StackTraceElement e : trace.getStackTrace()) {
+            final String cls = e.getClassName();
+            if (cls.startsWith("ca.spottedleaf.") || cls.startsWith("net.minecraft.")
+                || cls.startsWith("org.bukkit.") || cls.startsWith("io.papermc.")
+                || cls.startsWith("com.destroystokyo.")) {
+                continue;
+            }
+            site = cls + "#" + e.getMethodName() + ":" + e.getLineNumber();
+            break;
+        }
+        if (DUMPED_SITES.size() < MAX_DUMPED_SITES && DUMPED_SITES.add(site)) {
+            LOGGER.error(ex + " (first occurrence from " + site + "; repeats log a single line)", trace);
+        } else {
+            LOGGER.error("Thread failed main thread check (repeat) at " + site + " — stack suppressed, see the first occurrence above");
+        }
+    }
+    // SourbyCraft end - dedupe off-region violation dumps
+
     public static void ensureTickThread(final Level world, final ChunkPos pos, final String reason) {
         if (!isTickThreadFor(world, pos) && !me.earthme.luminol.config.modules.experiment.DisableAsyncCatcherConfig.enabled) { // Luminol
             final String ex = "Thread failed main thread check: " +
                 reason + ", context=" + getThreadContext() + ", world=" + WorldUtil.getWorldName(world) + ", chunk_pos=" + pos;
-            LOGGER.error(ex, new Throwable());
+            logViolation(ex); // SourbyCraft - dedupe off-region violation dumps
             throw new IllegalStateException(ex);
         }
     }
@@ -85,7 +115,7 @@ public class TickThread extends Thread {
         if (!isTickThreadFor(world, chunkX, chunkZ) && !me.earthme.luminol.config.modules.experiment.DisableAsyncCatcherConfig.enabled) { // Luminol
