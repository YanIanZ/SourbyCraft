diff --git a/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java b/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
index 8c6892ec60c1841cae45889da764cdd7d314d1f9..aee27c0e8783859b2810fb3e6ee44a04eb3f9327 100644
--- a/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
+++ b/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
@@ -264,6 +264,7 @@ public class CraftScheduler implements BukkitScheduler {
         if (taskId <= 0) {
             return;
         }
+        if (dev.iyanz.sourbycraft.bridge.AuroraBridge.cancel(taskId)) return; // SourbyCraft - Aurora Bridge
         // Paper start
         if (!this.isAsyncScheduler) {
             this.asyncScheduler.cancelTask(taskId);
@@ -311,6 +312,7 @@ public class CraftScheduler implements BukkitScheduler {
     @Override
     public void cancelTasks(final Plugin plugin) {
         Preconditions.checkArgument(plugin != null, "Cannot cancel tasks of null plugin");
+        if (dev.iyanz.sourbycraft.bridge.AuroraBridge.cancelAll(plugin)) return; // SourbyCraft - Aurora Bridge
         // Paper start
         if (!this.isAsyncScheduler) {
             this.asyncScheduler.cancelTasks(plugin);
@@ -355,6 +357,7 @@ public class CraftScheduler implements BukkitScheduler {
 
     @Override
     public boolean isCurrentlyRunning(final int taskId) {
+        if (dev.iyanz.sourbycraft.bridge.AuroraBridge.knows(taskId)) return dev.iyanz.sourbycraft.bridge.AuroraBridge.isRunning(taskId); // SourbyCraft - Aurora Bridge
         // Paper start
         if (!this.isAsyncScheduler) {
             if (this.asyncScheduler.isCurrentlyRunning(taskId)) {
@@ -380,6 +383,7 @@ public class CraftScheduler implements BukkitScheduler {
         if (taskId <= 0) {
             return false;
         }
+        if (dev.iyanz.sourbycraft.bridge.AuroraBridge.knows(taskId)) return true; // SourbyCraft - Aurora Bridge: scheduled and not finished or cancelled
         // Paper start
         if (!this.isAsyncScheduler && this.asyncScheduler.isQueued(taskId)) {
             return true;
@@ -442,6 +446,7 @@ public class CraftScheduler implements BukkitScheduler {
         // Paper start
         if (!this.isAsyncScheduler) {
             pending.addAll(this.asyncScheduler.getPendingTasks());
+            for (final Object bridged : dev.iyanz.sourbycraft.bridge.AuroraBridge.pendingTasks()) pending.add((BukkitTask) bridged); // SourbyCraft - Aurora Bridge
         }
         // Paper end
         return pending;
@@ -514,6 +519,12 @@ public class CraftScheduler implements BukkitScheduler {
     }
 
     protected CraftTask handle(final CraftTask task, final long delay) { // Paper
+        // SourbyCraft start - Aurora Bridge: route a bridged legacy plugin's task instead of refusing it
+        if (dev.iyanz.sourbycraft.bridge.AuroraBridge.handles(task.getOwner())) {
+            dev.iyanz.sourbycraft.bridge.AuroraBridge.submit(task.getOwner(), bridgeTask(task), delay);
+            return task;
+        }
+        // SourbyCraft end - Aurora Bridge
         if (true) throw new UnsupportedOperationException("Unsupported in region threading"); // Folia - region threading
         // Paper start
         if (!this.isAsyncScheduler && !task.isSync()) {
@@ -526,6 +537,31 @@ public class CraftScheduler implements BukkitScheduler {
         return task;
     }
 
+    // SourbyCraft start - Aurora Bridge
+    private static dev.iyanz.sourbycraft.bridge.BridgeRuntime.Task bridgeTask(final CraftTask task) {
+        return new dev.iyanz.sourbycraft.bridge.BridgeRuntime.Task() {
+            @Override public int id() { return task.getTaskId(); }
+            @Override public boolean sync() { return task.isSync(); }
+            @Override public long period() { return task.getPeriod(); }
+            @Override public boolean cancelled() { return task.isCancelled(); }
+            @Override public void markCancelled() { task.cancel0(); }
+            @Override public Object handle() { return task; }
+            @Override public void run() {
+                // CraftAsyncTask#run swallows and logs exceptions and keeps worker lists the bridge
+                // does not use; run the plugin's body directly so violations reach the bridge.
+                // CraftFuture must run itself: its run() is what completes the future.
+                if (task instanceof CraftFuture<?> || (task.rTask == null && task.cTask == null)) {
+                    task.run();
+                } else if (task.rTask != null) {
+                    task.rTask.run();
+                } else {
+                    task.cTask.accept(task);
+                }
+            }
+        };
+    }
+    // SourbyCraft end - Aurora Bridge
+
     private static void validate(final Plugin plugin, final Object task) {
         Preconditions.checkArgument(plugin != null, "Plugin cannot be null");
         Preconditions.checkArgument(task instanceof Runnable || task instanceof Consumer || task instanceof Callable, "Task must be Runnable, Consumer, or Callable");
