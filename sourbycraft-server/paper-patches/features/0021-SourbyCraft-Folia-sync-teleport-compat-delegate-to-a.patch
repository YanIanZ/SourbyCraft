diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
index efcb8b97cd685e1243c770bf3e8daf03615abb1d..69343fcfdb3adb24e27364bcc13934bde48c16e8 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
@@ -303,6 +303,17 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
 
     protected boolean teleport0(Location location, TeleportCause cause, TeleportFlag... flags) {
         // Folia start - region threading
+        // SourbyCraft - Folia sync-teleport compat: non-Folia plugins (e.g. Slimefun
+        // PickaxeOfTheSeeker) call the SYNCHRONOUS teleport from a region tick. Vanilla Folia throws,
+        // which breaks the plugin AND spam-floods the console (40+ stack traces in the operator's
+        // logs). When we are on the entity's OWNING region thread the async teleport runs immediately
+        // and in-region (teleportAsync's fast path), so the teleport still lands this tick — route the
+        // sync call through it and return true. Only a genuinely cross-region sync teleport (which
+        // cannot execute inline safely) still throws, so real threading bugs are not hidden.
+        if (org.bukkit.Bukkit.isOwnedByCurrentRegion(this)) {
+            this.teleportAsync(location, cause, flags);
+            return true;
+        }
         if (true) {
             throw new UnsupportedOperationException("Must use teleportAsync while in region threading");
         }
