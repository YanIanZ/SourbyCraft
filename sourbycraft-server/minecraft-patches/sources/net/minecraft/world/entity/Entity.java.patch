+        // Canvas end - region threading
+
+        Vec3 initialPosition = this.position();
+        ChunkPos initialPositionChunk = new ChunkPos(
+            ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkX(initialPosition),
+            ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkZ(initialPosition)
+        );
+        // Canvas start - region threading
+
+        // we need to set the portal state now, specifically START state
+        final dev.iyanz.aurora.engine.threadedregions.entities.EntityRegionTransferState previousTransferState = getRegionTransferState();
+        if (previousTransferState == null) {
+            // no state already set, perfect, set the start portal state
+            final String portalReason = "portaling from " + dev.iyanz.aurora.engine.util.Util.getLevelName(originWorld) + " -> " + dev.iyanz.aurora.engine.util.Util.getLevelName(finalDestination);
+
+            // LOGGER.info("Portaling entity {}, {}", this, portalReason);
+            setRegionTransferState(new dev.iyanz.aurora.engine.threadedregions.entities.EntityRegionTransferState.PortalStartTransferState(
