+    private static double canvas$teleportEntities(
+        Collection<? extends Entity> entities, ServerLevel world, SpreadPlayersCommand.Position[] positions, int maxY, boolean respectTeams
+    ) {
+        double totalMinDistance = 0.0;
+        int pileIndex = 0;
+        Map<Team, SpreadPlayersCommand.Position> teamAssignments = Maps.newHashMap();
+
+        for (Entity entity : entities) {
+            if (!entity.isAlive()) continue;
+            SpreadPlayersCommand.Position position = null;
+            if (respectTeams) {
+                Team playerTeam = entity instanceof Player player ? player.getTeam() : null;
+                if (playerTeam != null && !teamAssignments.containsKey(playerTeam)) {
+                    teamAssignments.put(playerTeam, positions[pileIndex++]);
+                }
+                position = teamAssignments.get(playerTeam);
+            }
+
+            // if we don't respect teams or there was no team assignment, we do this
+            if (position == null) {
+                position = positions[pileIndex++];
+            }
+
+            final BlockPos.MutableBlockPos blockPos = new BlockPos.MutableBlockPos(
+                (int) Math.round(Math.floor(position.x)), 0, (int) Math.round(Math.floor(position.z))
+            );
+            final SpreadPlayersCommand.Position finalPosition = position;
+
+            io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue.queueTickTaskQueue(
+                world, blockPos.getX() >> 4, blockPos.getZ() >> 4, () -> {
+                    blockPos.setY(finalPosition.getSpawnY(world, maxY));
+                    entity.getBukkitEntity().taskScheduler.schedule((entityAt) -> entityAt.teleportAsync(
+                        world, net.minecraft.world.phys.Vec3.atCenterOf(blockPos),
+                        entityAt.getYRot(), entityAt.getXRot(), entityAt.getDeltaMovement(),
+                        org.bukkit.event.player.PlayerTeleportEvent.TeleportCause.COMMAND,
+                        net.minecraft.world.entity.Entity.TELEPORT_FLAG_TELEPORT_PASSENGERS | net.minecraft.world.entity.Entity.TELEPORT_FLAG_LOAD_CHUNK, null
+                    ), null, 0L);
+                }
+            );
+
+            double minDistanceToOther = Double.MAX_VALUE;
+
+            for (SpreadPlayersCommand.Position otherPile : positions) {
+                if (position != otherPile) {
+                    double distance = position.dist(otherPile);
+                    minDistanceToOther = Math.min(distance, minDistanceToOther);
+                }
+            }
+
+            totalMinDistance += minDistanceToOther;
+        }
+
+        return entities.size() < 2 ? 0.0 : totalMinDistance / entities.size();
+    }
