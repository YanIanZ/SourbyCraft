+    private void respawn(
+        final java.util.function.@Nullable Consumer<ServerPlayer> respawnComplete,
+        final org.bukkit.event.player.PlayerRespawnEvent.RespawnReason reason,
+        final boolean alive
+    ) {
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(this, "Cannot respawn entity async");
+
+        this.getBukkitEntity(); // force bukkit entity to be created before TPing
+
+        if (alive != this.isAlive()) {
+            throw new IllegalStateException("isAlive expected = " + alive);
+        }
+
+        if (!this.hasNullCallback()) {
+            this.unRide();
+        }
+
+        if (this.isVehicle() || this.isPassenger()) {
+            throw new IllegalStateException("Dead player should not be a vehicle or passenger");
+        }
+
+        final ServerLevel origin = this.level();
+        final ServerPlayer.RespawnConfig respawnConfig = this.getRespawnConfig();
+        final ServerLevel respawnWorld = this.server.getLevel(ServerPlayer.RespawnConfig.getDimensionOrDefault(respawnConfig));
+
+        // modified based off PlayerList#respawn
+
+        final EntityTreeNode passengerTree = this.makePassengerTree();
+
+        this.isChangingDimension = true;
+        origin.removePlayerImmediately(this, RemovalReason.CHANGED_DIMENSION);
+
+        // reset player if needed, only after removal from world
+        if (!alive) {
+            ServerPlayer.this.reset();
+        }
+
+        // must be manually removed from connections, delay until after reset() so that we do not trip any thread checks
+        this.level().getCurrentWorldData().removeConnection(this);
+
+        final ca.spottedleaf.concurrentutil.completable.CallbackCompletable<org.bukkit.Location> spawnPosComplete =
+            new ca.spottedleaf.concurrentutil.completable.CallbackCompletable<>();
+        final RespawnArgs respawnArgs = new net.minecraft.server.level.ServerPlayer.RespawnArgs(); // Canvas - region threading
+
+        // set up post spawn location logic
+        spawnPosComplete.addWaiter((spawnLoc, _) -> {
+            // Canvas start - region threading
+            // call event, update pos and velocity
+            final io.canvasmc.canvas.event.PlayerRespawnAsyncEvent respawnEvent = new io.canvasmc.canvas.event.PlayerRespawnAsyncEvent(
+                ServerPlayer.this.getBukkitEntity(),
+                spawnLoc,
+                respawnArgs.isBedSpawn,
+                respawnArgs.usedRespawnAnchor,
+                respawnArgs.missingRespawnBlock,
+                reason
+            );
+            respawnEvent.callEvent();
+
+            final java.util.concurrent.atomic.AtomicReference<org.bukkit.Location> spawnLocAtomic = new java.util.concurrent.atomic.AtomicReference<>();
+            final Runnable finalize = () -> {
+
+            ServerPlayer.this.setPosRaw(spawnLocAtomic.get().getX(), spawnLocAtomic.get().getY(), spawnLocAtomic.get().getZ());
+            ServerPlayer.this.setYRot(spawnLocAtomic.get().getYaw());
+            ServerPlayer.this.setYHeadRot(spawnLocAtomic.get().getYaw());
+            ServerPlayer.this.setXRot(spawnLocAtomic.get().getPitch());
+
+            // Canvas end - region threading
+            ServerPlayer.this.setDeltaMovement(Vec3.ZERO);
+            // placeInAsync will update the world
+
+            this.placeInAsync(
+                origin,
+                // use the load chunk flag just in case the spawn loc isn't loaded, and to ensure the chunks
+                // stay loaded for a bit with the teleport ticket
+                ((org.bukkit.craftbukkit.CraftWorld)spawnLocAtomic.get().getWorld()).getHandle(), // Canvas - region threading
+                TELEPORT_FLAG_LOAD_CHUNK | TELEPORT_FLAGS_PLAYER_RESPAWN,
+                passengerTree, // note: we expect this to just be the player, no passengers
+                (_) -> {
+
+                    // now the player is in the world, and can receive sound and can decrement the anchor charge
+                    if (respawnArgs.usedRespawnAnchor) { // Canvas - region threading
+                        ServerPlayer.this.connection.send(
+                            new net.minecraft.network.protocol.game.ClientboundSoundPacket(
+                                net.minecraft.sounds.SoundEvents.RESPAWN_ANCHOR_DEPLETE, net.minecraft.sounds.SoundSource.BLOCKS,
+                                ServerPlayer.this.getX(), ServerPlayer.this.getY(), ServerPlayer.this.getZ(),
+                                1.0F, 1.0F, ServerPlayer.this.level().getRandom().nextLong()
+                            )
+                        );
+                        // Canvas start - region threading
+                        // we fix the anchor charge to be thread-safe, so this should be fine
+                        if (
+                            respawnArgs.respawnPosAngle != null &&
+                            respawnArgs.respawnPosAngle.consumeAnchorCharge != null
+                        ) respawnArgs.respawnPosAngle.consumeAnchorCharge.run();
+                        // Canvas end - region threading
+                    }
+
+                    ServerPlayer.this.connection.restartClientLoadTimerAfterRespawn();
+                    // now the respawn logic is complete
+
+                    // last, call the function callback
+                    if (respawnComplete != null) {
+                        respawnComplete.accept(ServerPlayer.this);
+                    }
+                    // Canvas start - region threading
+
+                    new io.canvasmc.canvas.event.PlayerPostRespawnAsyncEvent(
+                        ServerPlayer.this.getBukkitEntity(),
+                        spawnLoc,
+                        respawnArgs.isBedSpawn,
+                        respawnArgs.usedRespawnAnchor,
+                        respawnArgs.missingRespawnBlock,
+                        reason
+                    ).callEvent();
+                    // Canvas end - region threading
+                }, true // Canvas - region threading - set respawning arg
+            );
+            // Canvas start - region threading
+            };
+            final org.bukkit.Location eventRespawnLocation = respawnEvent.getRespawnLocation();
+            // set the atomic, then compare locations
+            spawnLocAtomic.set(eventRespawnLocation);
+            if (spawnLoc != eventRespawnLocation) {
+                // event changed the location, load async and then call finalizer
+                // use all the events location for this, they may have changed the world
+                final ServerLevel respawnAt = ((org.bukkit.craftbukkit.CraftWorld) eventRespawnLocation.getWorld()).getHandle();
+
+                // load chunks, give 1 chunk of radius to avoid syncloading stuff
+                respawnAt.canvas$loadOrRunAtChunksAsync(
+                    new BlockPos(eventRespawnLocation.getBlockX(), eventRespawnLocation.getBlockY(), eventRespawnLocation.getBlockZ()),
+                    16, ca.spottedleaf.concurrentutil.util.Priority.HIGHER, finalize
+                );
+            } else {
+                // event didn't modify location, run finalizer
+                finalize.run();
+            }
+            // Canvas end - region threading
+        });
+    // Canvas start - region threading
+        if (canvas$isDisplayingEndCredits) {
+
+            LOGGER.info("Displaying end credits for {}", getScoreboardName());
+
+            // we are displaying the end credits, we shouldn't run
+            // part 2 QUITE yet, but we need to place tickets to keep
+            // this region active and ticking our connection
+
+            //noinspection rawtypes
+            final Ticket ticket = new Ticket(TicketType.END_CREDITS, ChunkMap.FORCED_TICKET_LEVEL);
+
+            final int chunkX = chunkPosition().x();
+            final int chunkZ = chunkPosition().z();
+            final int radius = 1;
+
+            // place back in connections and add to end credits list
+            final io.papermc.paper.threadedregions.RegionizedWorldData currentWorldData = this.level().getCurrentWorldData();
+
+            currentWorldData.addConnection(this);
+            currentWorldData.addToEndCredits(this);
+
+            // place the tickets around the position with the radius
+            for (int x = chunkX - radius; x <= chunkX + radius; x++) {
+                for (int z = chunkZ - radius; z <= chunkZ + radius; z++) {
+                    origin.getChunkSource().addTicket(ticket, new ChunkPos(x, z));
+                }
+            }
+
+            canvas$exitEndCreditsCallback = () -> {
+                ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(this, "Cannot complete end credits lifecycle async");
+                LOGGER.info("Received signal to exit credits, completing respawn for {}", getScoreboardName());
+
+                // remove the player from the connections again and remove from end credits list
+                final io.papermc.paper.threadedregions.RegionizedWorldData worldData = this.level().getCurrentWorldData();
+
+                worldData.removeConnection(this);
+                worldData.removeFromEndCredits(this);
+
+                for (int x = chunkX - radius; x <= chunkX + radius; x++) {
+                    for (int z = chunkZ - radius; z <= chunkZ + radius; z++) {
+                        origin.getChunkSource().ticketStorage.removeTicket(ticket, new ChunkPos(x, z));
+                    }
+                }
+
+                // complete respawn part 2
+                respawnPart2(respawnWorld, respawnArgs, spawnPosComplete, alive, respawnConfig);
+            };
+        }
+        else {
+            // not displaying end credits, run respawn part 2
+            respawnPart2(respawnWorld, respawnArgs, spawnPosComplete, alive, respawnConfig);
+        }
+    }
