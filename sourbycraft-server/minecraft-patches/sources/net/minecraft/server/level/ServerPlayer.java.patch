+    private static class RespawnArgs {
+        boolean missingRespawnBlock = false;
+        boolean isBedSpawn = false;
+        boolean usedRespawnAnchor = false;
+        @Nullable
+        RespawnPosAngle respawnPosAngle = null;
+    }
+
+    private void respawnPart2(
+        @Nullable
+        final ServerLevel respawnWorld,
+        final RespawnArgs respawnArgs,
+        final ca.spottedleaf.concurrentutil.completable.CallbackCompletable<org.bukkit.Location> spawnPosComplete,
+        final boolean alive,
+        @Nullable
+        final RespawnConfig respawnConfig
+    ) {
+        final ServerLevel overworld = this.server.overworld();
+    // Canvas end - region threading
+        // find and modify respawn block state
+        if (respawnWorld == null || respawnConfig == null || respawnWorld.canvas$unloadTicket.isPresent()) { // Canvas - region threading
+            // default to regular spawn
+            fudgeSpawnLocation(overworld, spawnPosComplete);; // Canvas - region threading
+        } else {
+            // load chunk for block
+            // give at least 1 radius of loaded chunks so that we do not sync load anything
+            final int radiusBlocks = 16;
+            respawnWorld.moonrise$loadChunksAsync(respawnConfig.respawnData.pos(), radiusBlocks,
+                ca.spottedleaf.concurrentutil.util.Priority.HIGHER,
+                (_) -> {
+                    ServerPlayer.RespawnPosAngle spawnPos = ServerPlayer.findRespawnAndUseSpawnBlock(
+                        respawnWorld, respawnConfig, !alive
+                    ).orElse(null);
+                    if (spawnPos == null) {
+                        respawnArgs.missingRespawnBlock = true; // Canvas - region threading
+                        // no spawn
+                        ServerPlayer.this.connection.send(
+                            new ClientboundGameEventPacket(ClientboundGameEventPacket.NO_RESPAWN_BLOCK_AVAILABLE, 0.0F)
+                        );
+                        ServerPlayer.this.setRespawnPosition(
+                            null, false, com.destroystokyo.paper.event.player.PlayerSetSpawnEvent.Cause.PLAYER_RESPAWN
+                        );
+                        // default to regular spawn
+                        fudgeSpawnLocation(overworld, spawnPosComplete); // Canvas - region threading
+                        return;
+                    }
+
+                    final boolean isRespawnAnchor = respawnWorld.getBlockState(respawnConfig.respawnData.pos()).is(net.minecraft.world.level.block.Blocks.RESPAWN_ANCHOR);
+
+                    // Canvas start - region threading
+                    respawnArgs.isBedSpawn = respawnWorld.getBlockState(respawnConfig.respawnData.pos()).is(net.minecraft.tags.BlockTags.BEDS); // Canvas - region threading
+                    respawnArgs.usedRespawnAnchor = !alive && isRespawnAnchor;
+                    respawnArgs.respawnPosAngle = spawnPos;
+                    // Canvas end - region threading
+
+                    // finished now, pass the location on
+                    spawnPosComplete.complete(
+                        io.papermc.paper.util.MCUtil.toLocation(respawnWorld, spawnPos.position(), spawnPos.yaw(), 0.0f)
+                    );
+                    return;
+                }
+            );
+        }
+    }
