+    ) {
+        final CrashReport crashReport = CrashReport.forThrowable(thrown, title);
+        final MinecraftServer server = MinecraftServer.getServer();
+        final Path reportSavePath = server.getServerDirectory()
+            .resolve("crash-reports")
+            .resolve("crash-" + net.minecraft.util.Util.getFilenameFormattedDateTime() + "-server.txt");
+
+        if (reportFiller != null) {
+            reportFiller.accept(crashReport);
+        }
+        server.fillSystemReport(crashReport.getSystemReport());
+
+        if (crashReport.saveToFile(reportSavePath, ReportType.CRASH)) {
+            LOGGER.error("This crash report has been saved to: {}", reportSavePath.toAbsolutePath());
+        }
+        else {
+            LOGGER.error("Unable to save crash report to disk.");
+        }
+    }
