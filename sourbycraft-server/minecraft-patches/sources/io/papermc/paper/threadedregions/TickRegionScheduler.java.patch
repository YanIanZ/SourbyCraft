+    private void regionFailed(final @NonNull RegionScheduleHandle handle, final boolean executingTasks, final Throwable thrown) {
+        // when a region fails, we need to shut down the server gracefully
+
+        // Canvas start - region threading
+        generateCrashReport(thrown, "Region Failure", (report) -> {
+            final CrashReportCategory schedulerInfo = report.addCategory("Region Scheduler Info");
+
+            schedulerInfo.setDetail("initial_threads", SchedulerUtil.getSchedulerInfo().initialThreads());
+            schedulerInfo.setDetail("scheduler_type", SchedulerUtil.getSchedulerInfo().schedulerType());
+
+            final CrashReportCategory regionSpecificInfo = report.addCategory("Related Region Info");
+            final long current = System.nanoTime();
+
+            regionSpecificInfo.setDetail("current_tick", handle.currentTick);
+            regionSpecificInfo.setDetail("next_scheduled_start", Util.formatTargetTime(current, handle.scheduledStart));
+            regionSpecificInfo.setDetail("tick_manager", handle.tickManager.toString());
+            regionSpecificInfo.setDetail("id", handle.id);
+            regionSpecificInfo.setDetail("marked_non_schedulable", handle.isMarkedAsNonSchedulable());
+            regionSpecificInfo.setDetail("has_intermediate_tasks", handle.hasTasks());
+
+            if (handle instanceof TickRegions.ConcreteRegionTickHandle concrete) {
+                regionSpecificInfo.setDetail("region", concrete.region.region.toString());
+            }
+            else if (handle instanceof RegionizedServer.GlobalTickTickHandle) {
+                regionSpecificInfo.setDetail("is_global", true);
+            }
+
+            final CrashReportCategory regionizerInfo = report.addCategory("Regionizer Info");
+            final MutableInt regionCount = new MutableInt(0);
+
+            for (final ServerLevel world : RegionizedServer.getInstance().worlds) {
+                world.regioniser.computeForAllRegions((region) -> {
+                    regionizerInfo.setDetail(Util.getLevelName(world) + "-region-" + regionCount.incrementAndGet(), region.toString());
+                });
+            }
+
+            if (regionCount.intValue() == 0) {
+                regionizerInfo.setDetail("regions", "no regions loaded");
+            }
+        });
+        // Canvas end - region threading
+
+        // prevent further ticks from occurring
+        // we CANNOT sync, because WE ARE ON A SCHEDULER THREAD
+        this.scheduler.halt();
+
+        final ChunkPos center = handle.region == null ? null : handle.region.region.getCenterChunk();
+        final ServerLevel world = handle.region == null ? null : handle.region.world;
+
+        LOGGER.error("Region #{} centered at chunk {} in world '{}' failed to {}:", handle.region == null ? -1L : handle.region.id, center, world == null ? "null" : world.getWorld().getName(), executingTasks ? "execute tasks" : "tick", thrown);
+
+        MinecraftServer.getServer().stopServer();
+    }
