+    // SourbyCraft start - encode detached data on the caller and preserve the existing write/shutdown chain
+    public <T extends SavedData> CompletableFuture<?> sourbycraft$saveSnapshot(final SavedDataType<T> type, final T snapshot) {
+        if (this.closed) throw new IllegalStateException("Trying to save a snapshot after storage was closed");
+        final CompoundTag tag = this.encodeUnchecked(type, snapshot, this.registries.createSerializationContext(NbtOps.INSTANCE));
+        this.pendingWriteFuture = this.pendingWriteFuture.thenCompose(ignored ->
+            CompletableFuture.runAsync(() -> this.tryWrite(type, tag), Util.DIMENSION_DATA_IO_POOL));
+        return this.pendingWriteFuture;
+    }
+    // SourbyCraft end - encode detached data on the caller and preserve the existing write/shutdown chain
+
