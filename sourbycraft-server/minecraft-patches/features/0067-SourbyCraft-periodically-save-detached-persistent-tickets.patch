+    // SourbyCraft start - detached periodic ticket snapshot; normal shutdown codec path is unchanged
+    private @Nullable List<Pair<ChunkPos, Ticket>> sourbycraft$snapshotTickets;
+
+    public TicketStorage sourbycraft$snapshot() {
+        final List<Pair<ChunkPos, Ticket>> packed = new ArrayList<>();
+        // Same lock order as activation: deactivated map, then the manager's existing section locks.
+        synchronized (this.deactivatedTickets) {
+            final var active = this.chunkMap.level.moonrise$getChunkTaskScheduler().chunkHolderManager.getTicketsCopyForPersistence();
+            for (final var entry : Long2ObjectMaps.fastIterable(active)) {
+                final ChunkPos pos = ChunkPos.unpack(entry.getLongKey());
+                for (final Ticket ticket : entry.getValue()) {
+                    packed.add(new Pair<>(pos, ticket)); // already detached under the section lock
+                }
+            }
+            forEachTicket((pos, ticket) -> {
+                if (ticket.getType().persist()) {
+                    packed.add(new Pair<>(pos, new Ticket(ticket.getType(), ticket.getTicketLevel(), ticket.moonrise$getRemoveDelay())));
+                }
+            }, this.deactivatedTickets);
+        }
+        final TicketStorage snapshot = new TicketStorage();
+        snapshot.sourbycraft$snapshotTickets = List.copyOf(packed);
+        return snapshot;
+    }
+    // SourbyCraft end - detached periodic ticket snapshot
+
