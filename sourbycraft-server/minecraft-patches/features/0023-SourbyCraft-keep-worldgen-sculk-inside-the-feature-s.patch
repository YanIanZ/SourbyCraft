@@ -287,6 +287,12 @@ public class SculkSpreader {
                                 this.charge = 0;
                                 return;
                             }
+                            // SourbyCraft start - keep worldgen sculk inside the chunks the feature may touch
+                            if (spreader.isWorldGeneration() && !isInsideWorldGenWriteZone(level, this.pos)) {
