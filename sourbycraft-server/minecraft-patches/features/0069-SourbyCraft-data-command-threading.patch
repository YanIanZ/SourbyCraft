+    private BlockEntity entity() throws com.mojang.brigadier.exceptions.CommandSyntaxException {
+        if (this.entity == null) {
+            this.ensureTickThread("Resolve block entity on its owner");
+            final BlockEntity found = this.level.getBlockEntity(this.pos);
+            if (found == null) {
+                throw ERROR_NOT_A_BLOCK_ENTITY.create();
+            }
+            this.entity = found;
+        }
+        return this.entity;
+    }
+    // SourbyCraft end
