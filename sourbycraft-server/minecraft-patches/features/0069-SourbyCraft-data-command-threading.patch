         public DataAccessor access(final CommandContext<CommandSourceStack> context) throws CommandSyntaxException {
+            // SourbyCraft start - no world access off the owner: console/RCON resolve on the owning region, regions refuse
+            final net.minecraft.server.level.ServerLevel level = context.getSource().getLevel();
