@@ -33,6 +33,10 @@ public final class ChunkUpgradeGenericStatusTask extends ChunkProgressionTask im
 
     private final PrioritisedExecutor.PrioritisedTask generateTask;
 
+    // SourbyCraft - optional timing only; preserve the executor/radius ownership lifecycle.
+    private long generationQueuedAt;
+    private boolean measuredGeneration;
+
     public ChunkUpgradeGenericStatusTask(final ChunkTaskScheduler scheduler, final ServerLevel world, final int chunkX,
                                          final int chunkZ, final ChunkAccess chunk, final StaticCache2D<GenerationChunkHolder> neighbours,
                                          final ChunkStatus toStatus, final Priority priority) {
@@ -69,6 +73,20 @@ public final class ChunkUpgradeGenericStatusTask extends ChunkProgressionTask im
 
     @Override
     public void run() {
+        final boolean timing = dev.iyanz.sourbycraft.perf.ChunkGenerationMetrics.ENABLED;
+        final long started = timing ? System.nanoTime() : 0L;
+        try {
+            this.runTask();
+        } finally {
+            if (timing && this.measuredGeneration) {
+                dev.iyanz.sourbycraft.perf.ChunkGenerationMetrics.GLOBAL.record(
+                    this.toStatus.getName(), started - this.generationQueuedAt, System.nanoTime() - started
+                );
+            }
+        }
+    }
+
+    private void runTask() {
         final ChunkAccess chunk = this.fromChunk;
 
         final ServerChunkCache serverChunkCache = this.world.getChunkSource();
@@ -94,6 +112,7 @@ public final class ChunkUpgradeGenericStatusTask extends ChunkProgressionTask im
                     this.complete(chunk, null);
