From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: YanIanZ <iwayanbagusaryadarma@student.telkomuniversity.ac.id>
Date: Tue, 20 Oct 2026 01:24:12 +0700
Subject: [PATCH] SourbyCraft - security guard hooks

Observe client limits in LOG mode by default. Scope NBT checks to
network decode and retain native codec limits and channel ownership.

diff --git a/net/minecraft/nbt/ByteArrayTag.java b/net/minecraft/nbt/ByteArrayTag.java
index 4fc0cfeabf60d4bd0dcfd9814d13858454bc39da..c22dce2a6b40fea73419d19c012871516799252a 100644
--- a/net/minecraft/nbt/ByteArrayTag.java
+++ b/net/minecraft/nbt/ByteArrayTag.java
@@ -23,6 +23,7 @@ public final class ByteArrayTag implements CollectionTag {
         private static byte[] readAccounted(final DataInput input, final NbtAccounter accounter) throws IOException {
             accounter.accountBytes(24L);
             int length = input.readInt();
+            dev.iyanz.sourbycraft.security.SecurityGuards.INSTANCE.check(dev.iyanz.sourbycraft.security.SecurityGuards.Limit.NBT_LIST, length); // SourbyCraft
             com.google.common.base.Preconditions.checkArgument(length < 1 << 24); // Spigot
             accounter.accountBytes(1L, length);
             byte[] data = new byte[length];
diff --git a/net/minecraft/nbt/CompoundTag.java b/net/minecraft/nbt/CompoundTag.java
index b9f6aa790159b2df712244c44c55d6393c837d16..dfe133d3f608e577e580ae6bf27990e3d498e025 100644
--- a/net/minecraft/nbt/CompoundTag.java
+++ b/net/minecraft/nbt/CompoundTag.java
@@ -128,6 +128,7 @@ public final class CompoundTag implements Tag {
 
         private static String readString(final DataInput input, final NbtAccounter accounter) throws IOException {
             String key = input.readUTF();
+            dev.iyanz.sourbycraft.security.SecurityGuards.INSTANCE.check(dev.iyanz.sourbycraft.security.SecurityGuards.Limit.NBT_STRING, key.length()); // SourbyCraft
             accounter.accountBytes(28L);
             accounter.accountBytes(2L, key.length());
             return key;
diff --git a/net/minecraft/nbt/IntArrayTag.java b/net/minecraft/nbt/IntArrayTag.java
index 8ed91b84eb90cfe31993fa32b35263e7adea918e..0579cc712c976c503a3ef86be9758484f1ad394d 100644
