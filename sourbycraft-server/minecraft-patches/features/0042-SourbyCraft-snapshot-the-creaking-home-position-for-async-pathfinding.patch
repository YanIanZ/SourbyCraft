From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: YanIanZ <iwayanbagusaryadarma@student.telkomuniversity.ac.id>
Date: Tue, 20 Oct 2026 13:37:50 +0700
Subject: [PATCH] SourbyCraft - snapshot the creaking home position for async
 pathfinding


diff --git a/net/minecraft/world/entity/monster/creaking/Creaking.java b/net/minecraft/world/entity/monster/creaking/Creaking.java
index 111390f67f6f32cdb4aa0d0c4830c94c9799a1a3..74f6af8df618a45944984613b50175701bbda77c 100644
--- a/net/minecraft/world/entity/monster/creaking/Creaking.java
+++ b/net/minecraft/world/entity/monster/creaking/Creaking.java
@@ -35,6 +35,7 @@ import net.minecraft.world.entity.player.Player;
 import net.minecraft.world.entity.projectile.Projectile;
 import net.minecraft.world.level.Level;
 import net.minecraft.world.level.LevelReader;
+import net.minecraft.world.level.PathNavigationRegion;
 import net.minecraft.world.level.block.Blocks;
 import net.minecraft.world.level.block.CreakingHeartBlock;
 import net.minecraft.world.level.block.entity.CreakingHeartBlockEntity;
@@ -49,6 +50,7 @@ import net.minecraft.world.level.storage.ValueInput;
 import net.minecraft.world.level.storage.ValueOutput;
 import net.minecraft.world.phys.AABB;
 import net.minecraft.world.phys.Vec3;
+import dev.iyanz.sourbycraft.perf.MobPathSnapshot; // SourbyCraft - async pathfinding
 import org.jspecify.annotations.Nullable;
 
 public class Creaking extends Monster {
@@ -589,28 +591,49 @@ public class Creaking extends Monster {
             }
         }
 
-        // SourbyCraft start - async pathfinding: HomeNodeEvaluator reads Creaking.this.getHomePos() (synched
-        // entity data on the outer instance) during the solve, which MobPathSnapshot does not carry; keep it synchronous.
-        @Override
-        protected boolean sourbyAsyncSolveSafe() {
-            return false;
-        }
-        // SourbyCraft end - async pathfinding
-
         @Override
         protected PathFinder createPathFinder(final int maxVisitedNodes) {
-            this.nodeEvaluator = Creaking.this.new HomeNodeEvaluator();
-            this.nodeEvaluator.setCanPassDoors(true);
-            return new PathFinder(this.nodeEvaluator, maxVisitedNodes);
+            HomeNodeEvaluator evaluator = Creaking.this.new HomeNodeEvaluator();
+            // SourbyCraft start - async pathfinding: capture the home position here, on the owning thread
+            // (createPathFinder runs on the owner for both the live and the isolated solver), so an
+            // off-thread solve reads this snapshot instead of the live synched entity data.
+            evaluator.sourbyHomePos = Creaking.this.getHomePos();
+            // SourbyCraft end - async pathfinding
+            this.nodeEvaluator = evaluator;
+            evaluator.setCanPassDoors(true);
+            return new PathFinder(evaluator, maxVisitedNodes);
         }
     }
 
     private class HomeNodeEvaluator extends WalkNodeEvaluator {
         private static final int MAX_DISTANCE_TO_HOME_SQ = 1024;
+        // SourbyCraft start - async pathfinding: the home position captured on the owner (createPathFinder)
+        // and read only during an off-thread snapshot solve. The discriminator is an explicit flag, not
+        // `this.mob == null`: NodeEvaluator.done() also clears mob on the live evaluator between solves,
+        // and owner-thread queries (e.g. MoveControl.isWalkable) call getPathType without preparing, so the
+        // live evaluator must always read the current getHomePos().
+        private @Nullable BlockPos sourbyHomePos;
+        private boolean sourbySnapshotSolve;
+        // SourbyCraft end - async pathfinding
+
+        @Override
+        public void prepare(final PathNavigationRegion level, final MobPathSnapshot subject) {
+            super.prepare(level, subject);
+            this.sourbySnapshotSolve = true;
+        }
+
+        @Override
+        public void done() {
+            super.done();
+            this.sourbySnapshotSolve = false;
+        }
 
         @Override
         public PathType getPathType(final PathfindingContext context, final int x, final int y, final int z) {
-            BlockPos homePos = Creaking.this.getHomePos();
+            // SourbyCraft start - async pathfinding: only the off-thread solve reads the snapshotted home;
+            // every other call (the synchronous solve and owner-thread queries) reads the live home as vanilla does.
+            BlockPos homePos = this.sourbySnapshotSolve ? this.sourbyHomePos : Creaking.this.getHomePos();
+            // SourbyCraft end - async pathfinding
             if (homePos == null) {
                 return super.getPathType(context, x, y, z);
             }
