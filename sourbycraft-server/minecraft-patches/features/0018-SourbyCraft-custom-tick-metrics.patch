 public final class TickData {
 
     private final long interval; // ns
+    private final RegionTickMetrics shared;
+    private final RegionTickMetricsHolder sharedHolder;
 
-    private final ArrayDeque<TickTime> timeData = new ArrayDeque<>();
+    private final ArrayDeque<TickTime> timeData;
 
     public TickData(final long intervalNS) {
         this.interval = intervalNS;
+        this.shared = null;
+        this.sharedHolder = null;
+        this.timeData = new ArrayDeque<>();
+    }
+
+    public TickData(final RegionTickMetrics shared, final long intervalNS) {
+        this.interval = intervalNS;
+        this.shared = Objects.requireNonNull(shared);
+        this.sharedHolder = null;
+        this.timeData = null;
+    }
+
+    public TickData(final RegionTickMetricsHolder sharedHolder, final long intervalNS) {
+        this.interval = intervalNS;
+        this.shared = null;
+        this.sharedHolder = Objects.requireNonNull(sharedHolder);
+        this.timeData = null;
+    }
+
+    private RegionTickMetrics shared() {
+        return this.sharedHolder == null ? this.shared : this.sharedHolder.current();
