From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Tue, 21 Jul 2026 22:52:27 +0700
Subject: [PATCH] SourbyCraft - async pathfinding: offload periodic path
 recompute off the region thread
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Phase 1a wiring (config-gated, default OFF). PathNavigation.recomputePath —
the throttled ~20-tick path refresh that dominates repeated pathfinding for
chasing/following mobs — now, when perf.ai.async-pathfinding is on AND the
mob already has a live path to keep following, offloads the A* solve to the
AsyncPathProcessor pool.

The logic lives in dev.iyanz.sourbycraft.perf.AsyncPathRecompute (admission
checks, EntityPathfindEvent, the immutable SnapshotPathRegion, submission and
the owner-thread delivery with its staleness checks; the list of navigations
and mobs whose solve writes to the mob and so stay synchronous). This patch
keeps one delegating call behind the flag in recomputePath and the seams that
must touch PathNavigation's private state: the pending flag, two lazy reads,
the isolated PathFinder/NodeEvaluator and the write of an accepted result.

Flag OFF (default) = byte-for-byte the vanilla synchronous recompute. First
paths and direct moveTo stay synchronous; only the repeated recompute goes
async. Degrades to sync on any failure. Needs a live mob-behaviour soak
before default-on.

diff --git a/net/minecraft/world/entity/ai/navigation/PathNavigation.java b/net/minecraft/world/entity/ai/navigation/PathNavigation.java
index 0b5fab274d9471472ffe81dead60e4d0906b0f31..0461856c593da513a7e9796160d4f8050fb24ba3 100644
--- a/net/minecraft/world/entity/ai/navigation/PathNavigation.java
+++ b/net/minecraft/world/entity/ai/navigation/PathNavigation.java
@@ -100,6 +100,15 @@ public abstract class PathNavigation {
         if (this.tick - this.timeLastRecompute <= 20L || !this.canUpdatePath()) { // Folia - region threading
             this.hasDelayedRecomputation = true;
         } else if (this.targetPos != null) {
+            // SourbyCraft start - async pathfinding: offload the periodic recompute off the region thread
+            // (perf/AsyncPathRecompute; flag perf.ai.async-pathfinding, default off)
+            if (dev.iyanz.sourbycraft.perf.AsyncPathProcessor.isEnabled()
+                && dev.iyanz.sourbycraft.perf.AsyncPathRecompute.offload(this, this.mob, this.level, this.targetPos, this.reachRange)) {
+                this.timeLastRecompute = this.tick; // Folia - region threading
+                this.hasDelayedRecomputation = false;
+                return;
+            }
+            // SourbyCraft end
             this.path = null;
             this.path = this.createPath(this.targetPos, this.reachRange);
             this.timeLastRecompute = this.tick; // Folia - region threading
@@ -107,6 +116,41 @@ public abstract class PathNavigation {
         }
     }
 
+    // SourbyCraft start - async pathfinding: the navigation's side of perf/AsyncPathRecompute, which reads
+    // and writes these on the owning region thread only (the flag also from the delivery's release).
+    public volatile boolean sourbyAsyncPathPending = false;
+
+    public final float sourbyMaxPathLength() {
+        return this.getMaxPathLength();
+    }
+
+    public final float sourbyVisitedNodesMultiplier() {
+        return this.maxVisitedNodesMultiplier;
+    }
+
+    /**
+     * A {@code PathFinder} with its own {@code NodeEvaluator} for one off-thread solve.
+     * {@link #createPathFinder} replaces {@code this.nodeEvaluator} as a side effect; the live one is
+     * put back (see {@code AsyncPathRecompute.restoreLiveEvaluator}).
+     */
+    public final PathFinder sourbyIsolatedPathFinder(final int maxVisitedNodes) {
+        final NodeEvaluator live = this.nodeEvaluator;
+        try {
+            return this.createPathFinder(maxVisitedNodes);
+        } finally {
+            this.nodeEvaluator = dev.iyanz.sourbycraft.perf.AsyncPathRecompute.restoreLiveEvaluator(live, this.nodeEvaluator);
+        }
+    }
+
+    /** An async result AsyncPathRecompute accepted, on the owning region thread. */
+    public final void sourbyApplyAsyncPath(final Path path, final int reachRange) {
+        this.path = path;
+        this.targetPos = path.getTarget();
+        this.reachRange = reachRange;
+        this.resetStuckTimeout();
+    }
+    // SourbyCraft end - async pathfinding
+
     public final @Nullable Path createPath(final double x, final double y, final double z, final int reachRange) {
         return this.createPath(BlockPos.containing(x, y, z), reachRange);
     }
