From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: YanIanZ <iwayanbagusaryadarma@student.telkomuniversity.ac.id>
Date: Tue, 20 Oct 2026 19:16:41 +0700
Subject: [PATCH] SourbyCraft - count chunk lifecycle transitions


diff --git a/ca/spottedleaf/moonrise/paper/util/BaseChunkSystemHooks.java b/ca/spottedleaf/moonrise/paper/util/BaseChunkSystemHooks.java
index f9b5c7cf5fa6985f4da73e8350d2ca420c59f5a1..ddd063344a394793e0f5ff4840e7dff10b7f5753 100644
--- a/ca/spottedleaf/moonrise/paper/util/BaseChunkSystemHooks.java
+++ b/ca/spottedleaf/moonrise/paper/util/BaseChunkSystemHooks.java
@@ -75,11 +75,13 @@ public abstract class BaseChunkSystemHooks implements ca.spottedleaf.moonrise.co
 
     @Override
     public void onChunkHolderCreate(final ServerLevel level, final ChunkHolder holder) {
+        dev.iyanz.sourbycraft.perf.ChunkLifecycleCounters.count(dev.iyanz.sourbycraft.perf.ChunkLifecycleCounters.Transition.HOLDER_CREATED); // SourbyCraft - chunk lifecycle counters
         level.regioniser.addChunk(holder.getPos().x(), holder.getPos().z()); // Folia - region threading
     }
 
     @Override
     public void onChunkHolderDelete(final ServerLevel level, final ChunkHolder holder) {
+        dev.iyanz.sourbycraft.perf.ChunkLifecycleCounters.count(dev.iyanz.sourbycraft.perf.ChunkLifecycleCounters.Transition.HOLDER_DELETED); // SourbyCraft - chunk lifecycle counters
         level.regioniser.removeChunk(holder.getPos().x(), holder.getPos().z()); // Folia - region threading
     }
 
@@ -91,12 +93,14 @@ public abstract class BaseChunkSystemHooks implements ca.spottedleaf.moonrise.co
 
     @Override
     public void onChunkBorder(final LevelChunk chunk, final ChunkHolder holder) {
+        dev.iyanz.sourbycraft.perf.ChunkLifecycleCounters.count(dev.iyanz.sourbycraft.perf.ChunkLifecycleCounters.Transition.FULL); // SourbyCraft - chunk lifecycle counters
         chunk.getLevel().getCurrentWorldData().addChunk(chunk); // Folia - region threading
         chunk.loadCallback();
     }
 
     @Override
     public void onChunkNotBorder(final LevelChunk chunk, final ChunkHolder holder) {
+        dev.iyanz.sourbycraft.perf.ChunkLifecycleCounters.count(dev.iyanz.sourbycraft.perf.ChunkLifecycleCounters.Transition.NOT_FULL); // SourbyCraft - chunk lifecycle counters
         chunk.getLevel().getCurrentWorldData().removeChunk(chunk); // Folia - region threading
         chunk.unloadCallback();
     }
@@ -109,6 +113,7 @@ public abstract class BaseChunkSystemHooks implements ca.spottedleaf.moonrise.co
 
     @Override
     public void onChunkTicking(final LevelChunk chunk, final ChunkHolder holder) {
+        dev.iyanz.sourbycraft.perf.ChunkLifecycleCounters.count(dev.iyanz.sourbycraft.perf.ChunkLifecycleCounters.Transition.TICKING); // SourbyCraft - chunk lifecycle counters
         chunk.getLevel().getCurrentWorldData().addTickingChunk(chunk); // Folia - region threading
         if (!((ChunkSystemLevelChunk)chunk).moonrise$isPostProcessingDone()) {
             chunk.postProcessGeneration((ServerLevel)chunk.getLevel());
@@ -118,17 +123,20 @@ public abstract class BaseChunkSystemHooks implements ca.spottedleaf.moonrise.co
 
     @Override
     public void onChunkNotTicking(final LevelChunk chunk, final ChunkHolder holder) {
+        dev.iyanz.sourbycraft.perf.ChunkLifecycleCounters.count(dev.iyanz.sourbycraft.perf.ChunkLifecycleCounters.Transition.NOT_TICKING); // SourbyCraft - chunk lifecycle counters
         chunk.getLevel().getCurrentWorldData().removeTickingChunk(chunk); // Folia - region threading
     }
 
     @Override
     public void onChunkEntityTicking(final LevelChunk chunk, final ChunkHolder holder) {
+        dev.iyanz.sourbycraft.perf.ChunkLifecycleCounters.count(dev.iyanz.sourbycraft.perf.ChunkLifecycleCounters.Transition.ENTITY_TICKING); // SourbyCraft - chunk lifecycle counters
         chunk.getLevel().getCurrentWorldData().addEntityTickingChunk(chunk); // Folia - region threading
         ((ChunkTickServerLevel)(ServerLevel)chunk.getLevel()).moonrise$markChunkForPlayerTicking(chunk); // Moonrise - chunk tick iteration
     }
 
     @Override
     public void onChunkNotEntityTicking(final LevelChunk chunk, final ChunkHolder holder) {
+        dev.iyanz.sourbycraft.perf.ChunkLifecycleCounters.count(dev.iyanz.sourbycraft.perf.ChunkLifecycleCounters.Transition.NOT_ENTITY_TICKING); // SourbyCraft - chunk lifecycle counters
         chunk.getLevel().getCurrentWorldData().removeEntityTickingChunk(chunk); // Folia - region threading
         ((ChunkTickServerLevel)(ServerLevel)chunk.getLevel()).moonrise$removeChunkForPlayerTicking(chunk); // Moonrise - chunk tick iteration
     }
