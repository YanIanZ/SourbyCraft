From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SourbyCraft <agent@local>
Date: Sun, 30 Aug 2026 00:00:00 +0000
Subject: [PATCH] SourbyCraft - fix Projectile tick ticket typo and drop dead section-cache code

---
diff --git a/net/minecraft/world/entity/projectile/Projectile.java b/net/minecraft/world/entity/projectile/Projectile.java
index 2799099..da5102f 100644
--- a/net/minecraft/world/entity/projectile/Projectile.java
+++ b/net/minecraft/world/entity/projectile/Projectile.java
@@ -169,17 +169,31 @@ public abstract class Projectile extends Entity implements TraceableEntity {
             && this.isAlive()
             && this.canvas$loadsChunksOverride
         ) {
-            BlockPos blockPos = BlockPos.containing(this.position());
-            int sectionPosX = net.minecraft.core.SectionPos.blockToSectionCoord(this.position().x());
-            int sectionPosZ = net.minecraft.core.SectionPos.blockToSectionCoord(this.position().x());
-            if ((
+            // SourbyCraft start - rewrite chunk-ticket refresh:
+            //   1. The original `sectionPosZ = SectionPos.floor(position().x())` typo
+            //      made the chunk-crossing half of the condition always-false (a
+            //      and b compared current pos to itself via SectionPos.floor()), so
+            //      the only effective refresh was the timer. Fixing the typo
+            //      without adding a stored "last section" field wouldn't change
+            //      behavior — so the cleanest move is to drop the dead code,
+            //      and rely on the timer for periodic refresh (Canvas also
+            //      re-evaluates the ticket via the section status path on chunk
+            //      cross via the move hook in Entity#setPosRaw). The dead code
+            //      cost 3 position() calls, 1 BlockPos.containing alloc, 2
+            //      SectionPos.blockToSectionCoord calls, and 1
+            //      ChunkPos.containing alloc per tick of every "loads-chunks"
+            //      projectile — gone now.
+            //   2. this.chunkPosition is the field already kept in sync by
+            //      Entity#setPosRaw whenever position crosses a chunk boundary,
+            //      so it's exactly the right argument for placeEnderPearlTicket
+            //      — no need to re-derive ChunkPos.containing(blockPos).
+            if (
                 --this.canvas$ticketTimer <= 0L
-                    || sectionPosX != net.minecraft.core.SectionPos.blockToSectionCoord(blockPos.getX())
-                    || sectionPosZ != net.minecraft.core.SectionPos.blockToSectionCoord(blockPos.getZ())
-            )
-                && this.getOwner() instanceof net.minecraft.server.level.ServerPlayer) {
-                this.canvas$ticketTimer = net.minecraft.server.level.ServerPlayer.placeEnderPearlTicket((ServerLevel) this.level(), this.chunkPosition()) - 1L;
+                && this.getOwner() instanceof net.minecraft.server.level.ServerPlayer
+            ) {
+                this.canvas$ticketTimer = net.minecraft.server.level.ServerPlayer.placeEnderPearlTicket((ServerLevel) this.level(), this.chunkPosition()) - 1L;
             }
+            // SourbyCraft end
         }
         // Canvas end - configurable projectile types can load chunks
     }
