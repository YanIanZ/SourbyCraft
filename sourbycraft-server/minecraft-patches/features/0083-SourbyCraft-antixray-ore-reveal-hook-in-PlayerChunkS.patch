@@ -88,6 +88,8 @@ public class PlayerChunkSender {
             new io.papermc.paper.event.packet.PlayerChunkLoadEvent(new org.bukkit.craftbukkit.CraftChunk(chunk), connection.getPlayer().getBukkitEntity()).callEvent();
         }
         // Paper end - PlayerChunkLoadEvent
+        // SourbyCraft - antixray ore raytrace: hide exposed ores post-send, reveal via raytrace (S4)
