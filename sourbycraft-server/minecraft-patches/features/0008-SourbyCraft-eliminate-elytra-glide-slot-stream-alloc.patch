From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SourbyCraft <agent@local>
Date: Sun, 30 Aug 2026 00:00:00 +0000
Subject: [PATCH] SourbyCraft - eliminate elytra glide-slot stream allocation


diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 33dc433b5955cc7bace1457189ddf83547eca494..39080d25e83588c78c06d24046a4fda80b7ad5b1 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -3915,8 +3915,23 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             if (checkFallFlyTicks % 10 == 0) {
                 int freeFallInterval = checkFallFlyTicks / 10;
                 if (freeFallInterval % 2 == 0) {
-                    List<EquipmentSlot> slotsWithGliders = EquipmentSlot.VALUES.stream().filter(slot -> canGlideUsing(this.getItemBySlot(slot), slot)).toList();
-                    EquipmentSlot slotToDamage = Util.getRandom(slotsWithGliders, this.random);
+                    // SourbyCraft start - elytra glide: avoid the per-call List<EquipmentSlot> +
+                    // stream + toList + Util.getRandom round-trip. EquipmentSlot.VALUES has only
+                    // 6 entries and canGlideUsing() is a pure read of the entity's equipment map,
+                    // so a single-pass reservoir-style pick is allocation-free and trivially
+                    // equivalent in the only case the call site actually exercises (>= 1 elytra
+                    // equipped: filter result has 0 or 1 element, Util.getRandom on empty would
+                    // NPE just as the original; the nextInt(++count) == 0 reservoir pick is the
+                    // uniform distribution Util.getRandom on N elements would have produced).
+                    // Mirrors the existing for-each style already used in canGlide() above.
+                    EquipmentSlot slotToDamage = null;
+                    int gliderCount = 0;
+                    for (final EquipmentSlot slot : EquipmentSlot.VALUES) {
+                        if (canGlideUsing(this.getItemBySlot(slot), slot) && this.random.nextInt(++gliderCount) == 0) {
+                            slotToDamage = slot;
+                        }
+                    }
+                    // SourbyCraft end
                     this.getItemBySlot(slotToDamage).hurtAndBreak(1, this, slotToDamage);
                 }
 
