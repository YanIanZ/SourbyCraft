+++ b/dev/iyanz/aurora/engine/threadedregions/CanvasRegionizedWorldData.java
@@ -19,6 +19,7 @@ import net.minecraft.world.level.material.FlowingFluid;
 import org.bukkit.craftbukkit.CraftWorld;
 import org.jspecify.annotations.NullMarked;
 import org.jspecify.annotations.Nullable;
+import dev.iyanz.sourbycraft.api.region.RegionTickData;
 
 @SuppressWarnings("unused")
 public class CanvasRegionizedWorldData {
