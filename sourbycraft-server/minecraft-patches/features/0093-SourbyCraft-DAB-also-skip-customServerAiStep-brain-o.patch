From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Sun, 19 Jul 2026 00:28:07 +0700
Subject: [PATCH] SourbyCraft DAB: also skip customServerAiStep (brain) on a
 distance-throttled tick


diff --git a/net/minecraft/world/entity/Mob.java b/net/minecraft/world/entity/Mob.java
index 4603731460e7ca224ad03e243d571082ff0793ef..bae4f11180110b4d23f90cfba6118d038c766e9a 100644
--- a/net/minecraft/world/entity/Mob.java
+++ b/net/minecraft/world/entity/Mob.java
@@ -888,7 +888,15 @@ public abstract class Mob extends LivingEntity implements Targeting, EquipmentUs
         this.navigation.tick();
         profiler.pop();
         profiler.push("mob tick");
-        this.customServerAiStep((ServerLevel)this.level());
+        // SourbyCraft DAB: skip the mob-specific AI step (the brain — Villager/Piglin/etc. sensors,
+        // behaviors + memories, the single largest remaining entity cost) on a distance-throttled tick.
+        // Runs every Nth tick for a mob with no player within the throttle radius; navigation + controls
+        // below still run EVERY tick so the mob keeps moving/pathing smoothly. This is Dynamic Activation
+        // of Brain: distant mobs think at a lower rate (fine — nobody is near them) while near mobs are
+        // full-fidelity. On the every-Nth full tick the brain catches up.
+        if (!sourbyAiThrottledThisTick) {
+            this.customServerAiStep((ServerLevel)this.level());
+        }
         profiler.pop();
         profiler.push("controls");
         profiler.push("move");
