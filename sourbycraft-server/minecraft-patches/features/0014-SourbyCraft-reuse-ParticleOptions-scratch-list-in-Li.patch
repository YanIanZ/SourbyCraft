From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SourbyCraft <agent@local>
Date: Sun, 30 Aug 2026 00:00:00 +0000
Subject: [PATCH] SourbyCraft - reuse ParticleOptions scratch list in
 LivingEntity effect sync


diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 39080d25e83588c78c06d24046a4fda80b7ad5b1..433b225807a463016388d0c360044ae1a6d04412 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -991,6 +991,20 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
 
     private boolean tickingEffects = false; // CraftBukkit
     private final java.util.Queue<Runnable> deferredEffectUpdates = new java.util.concurrent.ConcurrentLinkedQueue<>(); // CraftBukkit
+    // SourbyCraft start - build the synced particle list in a reused scratch buffer.
+    // updateSynchronizedMobEffectParticles runs once per tick for every LivingEntity holding an
+    // active effect, and upstream allocated a fresh ArrayList each time only for SynchedEntityData
+    // to compare it against the stored value and usually discard it.
+    //
+    // The scratch MUST NOT be handed to entityData.set(): DataItem#setValue stores the reference
+    // it is given, and set() only marks the entry dirty when the new value is notEqual to the
+    // stored one. Passing the scratch makes the stored value and the candidate the same object,
+    // so every later set() compares the list to itself, never marks it dirty, and the client stops
+    // being told that the effect particles changed. We therefore compare against the stored value
+    // and publish an immutable copy only when the contents actually differ — which allocates less
+    // than upstream, since an unchanged effect set now allocates nothing at all.
+    private final List<ParticleOptions> effectParticlesScratch = new java.util.ArrayList<>();
+    // SourbyCraft end
 
     protected void tickEffects() {
         if (this.level() instanceof ServerLevel serverLevel) {
@@ -1060,8 +1069,9 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
     }
 
     private void updateSynchronizedMobEffectParticles() {
-        // Canvas start - remove streams
-        List<ParticleOptions> visibleEffectParticles = new java.util.ArrayList<>();
+        // SourbyCraft start - fill the reused scratch buffer (see declaration above).
+        this.effectParticlesScratch.clear();
+        final List<ParticleOptions> visibleEffectParticles = this.effectParticlesScratch;
         final Collection<MobEffectInstance> effectsValues = this.activeEffects.values(); // Canvas - optimized collection
 
         for (MobEffectInstance effect : effectsValues) { // Canvas - optimized collection
@@ -1069,7 +1081,12 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
                 visibleEffectParticles.add(effect.getParticleOptions());
             }
         }
-        // Canvas end - remove streams
-        this.entityData.set(DATA_EFFECT_PARTICLES, visibleEffectParticles);
+        // Publish an immutable copy, never the scratch itself, and only on a real change so the
+        // dirty flag still fires. List.copyOf returns a shared empty list when there is nothing
+        // to send, so the common "no visible effects" case allocates nothing.
+        if (!visibleEffectParticles.equals(this.entityData.get(DATA_EFFECT_PARTICLES))) {
+            this.entityData.set(DATA_EFFECT_PARTICLES, List.copyOf(visibleEffectParticles));
+        }
+        // SourbyCraft end
         this.entityData.set(DATA_EFFECT_AMBIENCE_ID, areAllEffectsAmbient(effectsValues)); // Canvas - optimized collection
     }
