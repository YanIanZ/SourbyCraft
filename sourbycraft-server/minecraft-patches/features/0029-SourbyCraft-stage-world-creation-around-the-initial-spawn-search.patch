+    // SourbyCraft start - staged world creation
+    /**
+     * The first half of {@link #syncLoadNonFull} without the wait: adds the same non-full load
+     * ticket and starts the same load, then returns at once. The chunk can be polled with
+     * {@code moonrise$getSpecificChunkIfLoaded(chunkX, chunkZ, status)} from any thread; pass the
+     * returned id to {@link #endNonFullLoad} to drop the ticket. Legal wherever syncLoadNonFull
+     * is, including on the global tick for a world not yet added to the regionised server.
+     */
+    public Long beginNonFullLoad(final int chunkX, final int chunkZ, final ChunkStatus status) {
+        if (status == null || status.isOrAfter(ChunkStatus.FULL)) {
+            throw new IllegalArgumentException("Status: " + status);
+        }
+        if (this.hasShutdown()) {
+            throw new IllegalStateException(
+                "Chunk system has shut down, cannot process chunk requests in world '" + ca.spottedleaf.moonrise.common.util.WorldUtil.getWorldName(this.world) + "' at "
+                    + "(" + chunkX + "," + chunkZ + ") status: " + status
+            );
+        }
+        final Long ticketId = getNextNonFullLoadId();
+        this.chunkHolderManager.addTicketAtLevel(NON_FULL_CHUNK_LOAD, chunkX, chunkZ, getTicketLevel(status), ticketId);
+        this.chunkHolderManager.processTicketUpdates();
+        this.beginChunkLoadForNonFullSync(chunkX, chunkZ, status, Priority.BLOCKING);
+        return ticketId;
+    }
+
+    /** Drops the ticket {@link #beginNonFullLoad} added, as {@link #syncLoadNonFull} does after its wait. */
+    public void endNonFullLoad(final int chunkX, final int chunkZ, final ChunkStatus status, final Long ticketId) {
+        this.chunkHolderManager.removeTicketAtLevel(NON_FULL_CHUNK_LOAD, chunkX, chunkZ, getTicketLevel(status), ticketId);
+    }
+    // SourbyCraft end - staged world creation
+
     // Note: on Moonrise the non-full sync load requires blocking on managedBlock, but this is fine since there is only
     // one main thread. On Folia, it is required that the non-full load can occur completely asynchronously to avoid deadlock
     // between regions
