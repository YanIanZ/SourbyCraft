+    // SourbyCraft start - staged world creation
+    /**
+     * The chunk {@link #initWorldSpawn} loads first, to {@code ChunkStatus.SPAWN}, when it searches
+     * for the initial spawn: the chunk holding the climate sampler's spawn position. It is found by
+     * the same checks, in the same order, as {@code initWorldSpawn} and {@code setInitialSpawn},
+     * without loading anything. {@code null} when no search will run: the spawn is already set, the
+     * creator forces one, the world is a debug world, or its generator fixes one (a plugin's
+     * {@code getFixedSpawnLocation} is therefore asked once here and once more by the search).
+     */
+    public @Nullable ChunkPos initialSpawnSearchChunk(final ServerLevel level, final org.bukkit.@Nullable WorldCreator worldCreator) {
+        if (level.serverLevelData.isInitialized()) {
+            return null;
+        }
+        if (worldCreator != null && worldCreator.forcedSpawnPosition() != null) {
+            return null;
+        }
+        if (SharedConstants.DEBUG_ONLY_GENERATE_HALF_THE_WORLD && SharedConstants.DEBUG_WORLD_RECREATE || this.worldData.isDebugWorld()) {
+            return null;
+        }
+        if (level.generator != null) {
+            final org.bukkit.Location spawn = level.generator.getFixedSpawnLocation(level.getWorld(), new java.util.Random(level.getSeed()));
+            if (spawn != null && spawn.getWorld() != null) {
+                return null;
+            }
+        }
+        return ChunkPos.containing(level.getChunkSource().randomState().sampler().findSpawnPosition());
+    }
+    // SourbyCraft end - staged world creation
+
