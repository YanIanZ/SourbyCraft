From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: agent <agent@local>
Date: Sun, 20 Sep 2026 23:45:06 +0700
Subject: [PATCH] SourbyCraft - compute the tracker's effective range once per
 broadcast

ChunkMap$TrackedEntity.updatePlayer is third on the CPU list under real
AI load, 186 of 5364 execution samples, and getEffectiveRange is its
largest callee at 12.

The range depends on the tracked entity and its passengers -- it calls
getPassengers, and for a ridden entity walks getIndirectPassengers and
loops over them -- and never on the player being updated. Both broadcast
loops called it once per player, so a server with N players recomputed
the same value N times per entity per tick.

It is now computed once per broadcast and passed in. The single-argument
updatePlayer stays for the callers that update one player against one
entity, where there is nothing to hoist.

Also reads entity.chunkPosition() once instead of twice in the same
expression.

Hoisting is safe because nothing in the loop mutates what the range
depends on: updatePlayer only adds or removes the player from seenBy and
sends packets, and neither touches the entity's passengers.

diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index dd420759b64ef9f18008e86816e37ebf94086b76..ba9ba7aa416190b031c70b95122149e97bae4d20 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -1237,9 +1237,11 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
 
             final ServerPlayer[] playersRaw = players.getRawDataUnchecked();
 
+            // SourbyCraft - one effective range for the whole broadcast, not one per player
+            final int effectiveRange = this.getEffectiveRange();
             for (int i = 0, len = players.size(); i < len; ++i) {
                 final ServerPlayer player = playersRaw[i];
-                this.updatePlayer(player);
+                this.updatePlayer(player, effectiveRange);
             }
 
             if (lastChunkUpdate != currChunkUpdate || lastTrackedChunk != chunk) {
@@ -1352,6 +1354,12 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
         }
 
         public void updatePlayer(final ServerPlayer player) {
+            // SourbyCraft - getEffectiveRange() depends on the tracked entity and its passengers,
+            // never on the player, so the broadcast loops below compute it once and pass it in.
+            this.updatePlayer(player, this.getEffectiveRange());
+        }
+
+        public void updatePlayer(final ServerPlayer player, final int effectiveRange) {
             org.spigotmc.AsyncCatcher.catchOp("player tracker update"); // Spigot
             if (player != this.entity) {
                 // Paper start - remove allocation of Vec3D here
@@ -1360,7 +1368,7 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
                 double deltaToPlayerZ = player.getZ() - this.entity.getZ();
                 // Paper end - remove allocation of Vec3D here
                 int playerViewDistance = ChunkMap.this.getPlayerViewDistance(player);
-                double visibleRange = Math.min(this.getEffectiveRange(), playerViewDistance * 16);
+                double visibleRange = Math.min(effectiveRange, playerViewDistance * 16); // SourbyCraft - hoisted out of the per-player loop
                 double distanceSquared = deltaToPlayerX * deltaToPlayerX + deltaToPlayerZ * deltaToPlayerZ; // Paper
                 double rangeSquared = visibleRange * visibleRange;
                 // Paper start - Configurable entity tracking range by Y
@@ -1372,9 +1380,10 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
                         visibleToPlayer = deltaToPlayerY * deltaToPlayerY <= rangeY * rangeY;
                     }
                 }
+                final ChunkPos trackedChunk = this.entity.chunkPosition(); // SourbyCraft - read once, not twice
                 visibleToPlayer = visibleToPlayer
                     && this.entity.broadcastToPlayer(player)
-                    && ChunkMap.this.isChunkTracked(player, this.entity.chunkPosition().x(), this.entity.chunkPosition().z());
+                    && ChunkMap.this.isChunkTracked(player, trackedChunk.x(), trackedChunk.z());
                 // Paper end - Configurable entity tracking range by Y
                 // Folia start - region threading
                 if (visibleToPlayer && (this.entity instanceof ServerPlayer thisEntity) && thisEntity.broadcastedDeath) {
@@ -1432,8 +1441,10 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
         }
 
         public void updatePlayers(final List<ServerPlayer> players) {
+            // SourbyCraft - one effective range for the whole broadcast, not one per player
+            final int effectiveRange = this.getEffectiveRange();
             for (ServerPlayer player : players) {
-                this.updatePlayer(player);
+                this.updatePlayer(player, effectiveRange);
             }
         }
     }
