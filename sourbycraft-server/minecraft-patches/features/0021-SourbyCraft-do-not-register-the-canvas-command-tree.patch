From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: agent <agent@local>
Date: Mon, 5 Oct 2026 15:01:39 +0700
Subject: [PATCH] SourbyCraft - do not register the /canvas command tree


diff --git a/net/minecraft/commands/Commands.java b/net/minecraft/commands/Commands.java
index d33950382e50f717c0deed1266dfae39b280c26e..99b9fe50fe334fc8110dc57ac2280fad21969045 100644
--- a/net/minecraft/commands/Commands.java
+++ b/net/minecraft/commands/Commands.java
@@ -299,7 +299,10 @@ public class Commands {
             WhitelistCommand.register(this.dispatcher);
         }
 
-        dev.iyanz.aurora.engine.commands.CanvasCommands.INSTANCE.build(this.dispatcher, context); // Canvas - Rebrand - register commands
+        // SourbyCraft - /canvas command removed: do not register the Canvas command tree (root
+        // /canvas + subcommands region-bar/region-tick/reload/etc.). This is the actual dispatcher
+        // registration; the CanvasCommands.register(...) population in GlobalConfiguration is also
+        // removed. (was: dev.iyanz.aurora.engine.commands.CanvasCommands.INSTANCE.build(this.dispatcher, context);)
         if (commandSelection.includeIntegrated) {
             PublishCommand.register(this.dispatcher);
             UnpublishCommand.register(this.dispatcher);
