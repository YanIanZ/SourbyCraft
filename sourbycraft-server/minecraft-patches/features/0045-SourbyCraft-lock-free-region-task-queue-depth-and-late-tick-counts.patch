diff --git a/io/papermc/paper/threadedregions/TickRegionScheduler.java b/io/papermc/paper/threadedregions/TickRegionScheduler.java
index d9b53333108add6e6d873e1472e1dedb52beaf99..26a8e3d4b02278af9d7397fc9bf3c83cd4c7b0d0 100644
--- a/io/papermc/paper/threadedregions/TickRegionScheduler.java
+++ b/io/papermc/paper/threadedregions/TickRegionScheduler.java
@@ -88,6 +88,58 @@ public final class TickRegionScheduler {
         return DEFAULT_TICK_TIME_NANOS;
     }
     // Canvas end - region threading
+    // SourbyCraft start - count late tick starts for /perf scheduler
+    /**
+     * A tick is late when it starts more than this past its scheduled start. The same 1 ms the
+     * {@code /perf scheduler} view uses for "ready but past its tick start".
+     */
+    public static final long SOURBY_LATE_TICK_THRESHOLD_NANOS = dev.iyanz.sourbycraft.perf.SchedulerQueueCollector.OVERDUE_THRESHOLD_NANOS;
+    // LongAdder: every scheduler thread counts here; contention spreads over cells allocated once
+    // (bounded by the CPU count), never per tick. Read lock-free with sum().
+    private static final java.util.concurrent.atomic.LongAdder SOURBY_REGION_TICKS = new java.util.concurrent.atomic.LongAdder();
+    private static final java.util.concurrent.atomic.LongAdder SOURBY_LATE_REGION_TICKS = new java.util.concurrent.atomic.LongAdder();
+    private static final java.util.concurrent.atomic.LongAdder SOURBY_GLOBAL_TICKS = new java.util.concurrent.atomic.LongAdder();
+    private static final java.util.concurrent.atomic.LongAdder SOURBY_LATE_GLOBAL_TICKS = new java.util.concurrent.atomic.LongAdder();
+
+    static void sourbyCountTickStart(final boolean global, final long scheduledStart, final long tickStart) {
+        if (scheduledStart == TimeUtil.DEADLINE_NOT_SET) {
+            return;
+        }
+        final boolean late = tickStart - scheduledStart > SOURBY_LATE_TICK_THRESHOLD_NANOS;
+        if (global) {
+            SOURBY_GLOBAL_TICKS.increment();
+            if (late) {
+                SOURBY_LATE_GLOBAL_TICKS.increment();
+            }
+        } else {
+            SOURBY_REGION_TICKS.increment();
+            if (late) {
+                SOURBY_LATE_REGION_TICKS.increment();
+            }
+        }
+    }
+
+    /** Region ticks started since boot (approximate while ticks are starting: LongAdder.sum()). */
+    public static long sourbyRegionTicksStarted() {
+        return SOURBY_REGION_TICKS.sum();
+    }
+
+    /** Region ticks that started more than {@link #SOURBY_LATE_TICK_THRESHOLD_NANOS} late since boot. */
+    public static long sourbyLateRegionTicks() {
+        return SOURBY_LATE_REGION_TICKS.sum();
+    }
+
+    /** Global ticks started since boot. */
+    public static long sourbyGlobalTicksStarted() {
+        return SOURBY_GLOBAL_TICKS.sum();
+    }
+
+    /** Global ticks that started more than {@link #SOURBY_LATE_TICK_THRESHOLD_NANOS} late since boot. */
+    public static long sourbyLateGlobalTicks() {
+        return SOURBY_LATE_GLOBAL_TICKS.sum();
+    }
+    // SourbyCraft end - count late tick starts for /perf scheduler
+
     // Folia start - watchdog
     public static final FoliaWatchdogThread WATCHDOG_THREAD = new FoliaWatchdogThread();
     static {
@@ -583,6 +635,7 @@ public final class TickRegionScheduler {
 
             final long scheduledStart = this.getScheduledStart();
