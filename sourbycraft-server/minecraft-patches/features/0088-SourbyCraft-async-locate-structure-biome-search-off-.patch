+    // SourbyCraft start - async /locate (structure + biome search off the region thread)
+    // Evidence from production logs: "Locating element minecraft:ice_spikes took 2792 ms" froze the
+    // player's region thread for ~3 seconds and drove the perf tier straight to EMERGENCY; a structure
+    // locate (ring search over up to 100 chunks of STRUCTURE_STARTS gen + region-file reads) can be
+    // worse. Both searches are safe off a tick thread: the biome search is pure climate-noise math
+    // (no chunk access at all), and the structure search's chunk gets go through
+    // ServerChunkCache.syncLoad, which from a NON-tick thread schedules into the Moonrise chunk
+    // scheduler and parks the calling thread (the TickThread assertion only rejects WRONG-region
+    // tick threads). The searching thread is a virtual thread; the result/error is delivered from
+    // it directly — component build + connection.send are thread-safe.
+    /** One in-flight locate per command source; a second /locate while one runs is refused. */
+    private static final java.util.Set<java.util.UUID> IN_FLIGHT =
+        java.util.concurrent.ConcurrentHashMap.newKeySet();
+
+    private static java.util.UUID inFlightKey(final CommandSourceStack source) {
+        final net.minecraft.world.entity.Entity entity = source.getEntity();
+        // Console/command blocks share one slot — fine: worst case a refusal message.
+        return entity != null ? entity.getUUID() : new java.util.UUID(0L, 0L);
+    }
+
+    private static int locateAsync(final CommandSourceStack source, final String printableName,
+                                   final java.util.concurrent.Callable<Integer> search) {
+        final java.util.UUID key = inFlightKey(source);
+        if (!IN_FLIGHT.add(key)) {
+            source.sendFailure(Component.literal("A /locate search is already running — wait for it to finish."));
+            return 0;
+        }
+        source.sendSystemMessage(Component.literal("Searching for " + printableName + "…").withStyle(ChatFormatting.GRAY));
+        dev.iyanz.sourbycraft.util.VirtualExecutor.run(() -> {
+            try {
+                search.call();
+            } catch (CommandSyntaxException e) {
+                source.sendFailure(ComponentUtils.fromMessage(e.getRawMessage()));
+            } catch (Throwable t) {
+                LOGGER.error("Async /locate for {} failed", printableName, t);
+                source.sendFailure(Component.literal("Locate failed: " + t.getMessage()));
+            } finally {
+                IN_FLIGHT.remove(key);
+            }
+        });
+        return Command.SINGLE_SUCCESS;
+    }
+
