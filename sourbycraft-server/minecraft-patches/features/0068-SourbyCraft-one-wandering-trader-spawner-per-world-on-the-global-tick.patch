+        if (getGlobalTickData().getTickManager().doesRunGameElements() && world.tickTime) { // SourbyCraft - one world timer
+            dev.iyanz.sourbycraft.world.WanderingTraderCoordinator.tick(world, tickCount); // game time advanced by tickCount
+        }
 
         world.updateTickData();
 
