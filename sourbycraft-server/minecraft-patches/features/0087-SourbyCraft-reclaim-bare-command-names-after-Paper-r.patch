From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <superwhisz@gmail.com>
Date: Sun, 12 Jul 2026 21:46:24 +0700
Subject: [PATCH] SourbyCraft: reclaim bare command names after Paper registers
 them


diff --git a/net/minecraft/server/dedicated/DedicatedServer.java b/net/minecraft/server/dedicated/DedicatedServer.java
index 466702284248eb3f516701c60773ba00bd41f355..cf602e6c70fdd7efaca002c13ece8b2117504250 100644
--- a/net/minecraft/server/dedicated/DedicatedServer.java
+++ b/net/minecraft/server/dedicated/DedicatedServer.java
@@ -249,6 +249,7 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
         org.spigotmc.WatchdogThread.doStart(org.spigotmc.SpigotConfig.timeoutTime, org.spigotmc.SpigotConfig.restartOnCrash); // Paper - start watchdog thread
         consoleThread.start(); // Paper - Enhance console tab completions for brigadier commands; start console thread after MinecraftServer.console & PaperConfig are initialized
         io.papermc.paper.command.PaperCommands.registerCommands(this); // Paper - setup /paper command
+        dev.iyanz.sourbycraft.command.SourbyCraftCommands.reclaimBareNames(); // SourbyCraft - reclaim /tps /mspt /ver etc from Paper's built-ins (Paper registers them AFTER our post-config hook)
         this.server.spark.registerCommandBeforePlugins(this.server); // Paper - spark // SourbyCraft - re-enable bundled spark
         com.destroystokyo.paper.Metrics.PaperMetrics.startMetrics(); // Paper - start metrics
         com.destroystokyo.paper.VersionHistoryManager.INSTANCE.getClass(); // Paper - load version history now
