+        // SourbyCraft start - legacy PlayerTeleportEvent on the async route; adapted from LightingLuminol MC 0001 Entity#teleportAsync ("// LightingLuminol Start"), fired here on the owning thread, honouring cancel and getTo(), never twice for one call (AsyncTeleportEvents)
+        if (this instanceof ServerPlayer sourbyPlayer && dev.iyanz.sourbycraft.entity.teleport.AsyncTeleportEvents.firesPlayerTeleport(callEvents)) {
+            final org.bukkit.Location sourbyTo = dev.iyanz.sourbycraft.entity.teleport.AsyncTeleportEvents.playerTeleport(sourbyPlayer, originWorld, currPos, destination, pos, yaw, pitch, cause);
+            if (sourbyTo == null) {
+                // cancelled by a listener: the same cleanup as a cancelled EntityTeleportAsyncEvent
+                final dev.iyanz.aurora.engine.threadedregions.entities.EntityRegionTransferState sourbyTransferState = getRegionTransferState();
+                if (sourbyTransferState instanceof dev.iyanz.aurora.engine.threadedregions.entities.EntityRegionTransferState.PluginTeleportAsyncState) {
+                    clearRegionTransferState();
+                } else if (sourbyTransferState != null) {
+                    throw new IllegalStateException("Teleport event was cancelled, but transfer state was present? Currently: " + sourbyTransferState);
+                }
+                return false;
+            }
+            pos = new Vec3(sourbyTo.getX(), sourbyTo.getY(), sourbyTo.getZ());
+            destination = ((org.bukkit.craftbukkit.CraftWorld) sourbyTo.getWorld()).getHandle();
+            yaw = sourbyTo.getYaw();
+            pitch = sourbyTo.getPitch();
+            // if plugin did something funky, kill
+            canvas$ensureCanTeleportAsync(destination, pos, teleportFlags);
+        }
+        // SourbyCraft end - legacy PlayerTeleportEvent on the async route
+
         // verify and set the transfer state
         final dev.iyanz.aurora.engine.threadedregions.entities.EntityRegionTransferState previousTransferState = getRegionTransferState();
         if (previousTransferState == null) {
