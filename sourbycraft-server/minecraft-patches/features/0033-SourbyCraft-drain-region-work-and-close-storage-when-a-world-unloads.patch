@@ -305,6 +305,18 @@ public final class RegionizedTaskQueue {
         public boolean hasTasks() {
             return !this.tickTaskQueue.isEmpty() || !this.chunkQueue.isEmpty();
         }
+
+        // SourbyCraft start - cancel-only drain for an unloading world
+        /**
+         * Cancels every queued task without running it, for a region of a world being unloaded:
+         * it never ticks again. Chunk tickets are not released; the world's chunk system is closed.
+         *
+         * @return how many tasks were cancelled
+         */
+        public int sourbyCancelQueuedTasks() {
+            return this.tickTaskQueue.sourbyCancelAll() + this.chunkQueue.sourbyCancelAll();
+        }
+        // SourbyCraft end - cancel-only drain for an unloading world
     }
 
     static final class PrioritisedQueue {
@@ -334,6 +346,27 @@ public final class RegionizedTaskQueue {
             }
         }
 
+        // SourbyCraft start - cancel-only drain for an unloading world
+        int sourbyCancelAll() {
+            final java.util.List<ChunkBasedPriorityTask> drained = new java.util.ArrayList<>();
+            synchronized (this) {
+                for (final ArrayDeque<ChunkBasedPriorityTask> queue : this.queues) {
+                    ChunkBasedPriorityTask task;
+                    while ((task = queue.pollFirst()) != null) {
+                        drained.add(task);
+                    }
+                }
+            }
+            int cancelled = 0;
+            for (final ChunkBasedPriorityTask task : drained) {
+                if (task.sourbyCancelWithoutTicket()) {
+                    ++cancelled;
+                }
+            }
+            return cancelled;
+        }
+        // SourbyCraft end - cancel-only drain for an unloading world
+
         public boolean isEmpty() {
             final ArrayDeque<ChunkBasedPriorityTask>[] queues = this.queues;
             final int max = Priority.IDLE.priority;
@@ -558,6 +591,23 @@ public final class RegionizedTaskQueue {
                 this.run = null;
             }
 
+            // SourbyCraft start - cancel-only drain for an unloading world
+            // Claims the task like tryComplete(true) but leaves its chunk ticket alone: the world's
+            // chunk system is already closed when an unload drains its queues.
+            private boolean sourbyCancelWithoutTicket() {
+                for (ReferenceCountData curr = this.getReferenceCounterVolatile();;) {
+                    if (curr == null) {
+                        return false;
+                    }
+                    if (curr == (curr = this.compareAndExchangeReferenceCounter(curr, null))) {
+                        this.setPriorityVolatile(Priority.COMPLETING);
+                        this.cancelInternal();
+                        return true;
+                    }
+                }
+            }
+            // SourbyCraft end - cancel-only drain for an unloading world
+
             private boolean tryComplete(final boolean cancel) {
                 int failures = 0;
                 for (ReferenceCountData curr = this.getReferenceCounterVolatile();;) {
diff --git a/io/papermc/paper/threadedregions/scheduler/FoliaRegionScheduler.java b/io/papermc/paper/threadedregions/scheduler/FoliaRegionScheduler.java
index 31478be4da6f1bdb184b4579338eca7942a3098e..f2dd35f0f6fbc1f54920389e084d9f91c49316f9 100644
--- a/io/papermc/paper/threadedregions/scheduler/FoliaRegionScheduler.java
+++ b/io/papermc/paper/threadedregions/scheduler/FoliaRegionScheduler.java
@@ -150,6 +150,34 @@ public final class FoliaRegionScheduler implements RegionScheduler {
         SCHEDULER_DATA.get().tick();
     }
 
+    // SourbyCraft start - cancel what a region of an unloading world still holds
+    /**
+     * Cancels every task the current region's scheduler holds, for a region of a world being
+     * unloaded: it never ticks again, so the tasks would otherwise stay {@code IDLE} forever.
+     * Chunk tickets are left alone; the world's chunk system is closed by then.
+     *
+     * @return how many tasks were cancelled
+     */
+    public static int sourbyCancelCurrentRegionTasks() {
+        final Scheduler scheduler = SCHEDULER_DATA.get();
+        if (scheduler == null) {
+            return 0;
+        }
+        int cancelled = 0;
+        for (final Long2ObjectOpenHashMap<List<LocationScheduledTask>> section : scheduler.tasksByDeadlineBySection.values()) {
+            for (final List<LocationScheduledTask> tasks : section.values()) {
+                for (final LocationScheduledTask task : tasks) {
+                    if (task.cancel() == ScheduledTask.CancelledState.CANCELLED_BY_CALLER) {
+                        ++cancelled;
+                    }
+                }
+            }
+        }
+        scheduler.tasksByDeadlineBySection.clear();
+        return cancelled;
+    }
+    // SourbyCraft end - cancel what a region of an unloading world still holds
+
     private static final class Scheduler {
 
         private Scheduler(final TickRegions.TickRegionData regionData) {}
