                         .then(
-                            Commands.argument("distance", DoubleArgumentType.doubleArg(-5.999997E7F, 5.999997E7F))
+                            Commands.argument("distance", DoubleArgumentType.doubleArg(-6.5999968E7, 6.5999968E7))
