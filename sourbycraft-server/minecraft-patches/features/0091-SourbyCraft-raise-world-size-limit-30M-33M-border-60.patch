diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index 000e4924e8e338728715a3946002903a3118a98a..63417c383dfceaa3c16a2f1ec8a4c1883f7e5283 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -108,8 +108,14 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
     public static final ResourceKey<Level> OVERWORLD = ResourceKey.create(Registries.DIMENSION, Identifier.withDefaultNamespace("overworld"));
     public static final ResourceKey<Level> NETHER = ResourceKey.create(Registries.DIMENSION, Identifier.withDefaultNamespace("the_nether"));
     public static final ResourceKey<Level> END = ResourceKey.create(Registries.DIMENSION, Identifier.withDefaultNamespace("the_end"));
-    public static final int MAX_LEVEL_SIZE = 30000000;
-    public static final int ACROSS_THE_WHOLE_WORLD = 60000000;
+    // SourbyCraft: raised the world coordinate limit 30M -> 33M (border 60M -> 66M). 33M stays UNDER
+    // the BlockPos 26-bit hard cap (MAX_HORIZONTAL_COORDINATE = 33,554,431) with ~554k of margin, so
+    // block packing, chunk/region addressing and the client's own BlockPos handling remain valid — no
+    // corruption. Beyond the old 30M ring the vanilla client has float-precision jitter, but no player
+    // ever reaches ±30M+ so it is academic. 100M (±50M) is impossible: it exceeds 26-bit BlockPos and
+    // would need a client protocol change. This is the maximum SAFE expansion.
+    public static final int MAX_LEVEL_SIZE = 33000000;
+    public static final int ACROSS_THE_WHOLE_WORLD = 66000000;
     public static final int LONG_PARTICLE_CLIP_RANGE = 512;
     public static final int SHORT_PARTICLE_CLIP_RANGE = 32;
     public static final int MAX_BRIGHTNESS = 15;
@@ -973,7 +979,7 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
     }
 
     private static boolean isInWorldBoundsHorizontal(final BlockPos pos) {
-        return pos.getX() >= -30000000 && pos.getZ() >= -30000000 && pos.getX() < 30000000 && pos.getZ() < 30000000; // Paper - Diff on change warnUnsafeChunk() and isInsideBuildHeightAndWorldBoundsHorizontal
+        return pos.getX() >= -MAX_LEVEL_SIZE && pos.getZ() >= -MAX_LEVEL_SIZE && pos.getX() < MAX_LEVEL_SIZE && pos.getZ() < MAX_LEVEL_SIZE; // SourbyCraft: use raised MAX_LEVEL_SIZE (33M) // Paper - Diff on change warnUnsafeChunk() and isInsideBuildHeightAndWorldBoundsHorizontal
     }
 
     private static boolean isInValidBoundsHorizontal(final BlockPos pos) {
@@ -1312,7 +1318,7 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
     @Override
     public int getHeight(final Heightmap.Types type, final int x, final int z) {
         int y;
-        if (x >= -30000000 && z >= -30000000 && x < 30000000 && z < 30000000) {
+        if (x >= -MAX_LEVEL_SIZE && z >= -MAX_LEVEL_SIZE && x < MAX_LEVEL_SIZE && z < MAX_LEVEL_SIZE) { // SourbyCraft: raised MAX_LEVEL_SIZE (33M)
             if (this.hasChunk(SectionPos.blockToSectionCoord(x), SectionPos.blockToSectionCoord(z))) {
                 y = this.getChunk(SectionPos.blockToSectionCoord(x), SectionPos.blockToSectionCoord(z)).getHeight(type, x & 15, z & 15) + 1;
             } else {
