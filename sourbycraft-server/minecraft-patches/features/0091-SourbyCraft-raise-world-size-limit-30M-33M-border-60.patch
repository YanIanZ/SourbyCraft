--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -209,7 +209,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     private static final int AUTOSAVE_INTERVAL = 6000;
     private static final int MIMINUM_AUTOSAVE_TICKS = 100;
     private static final int MAX_TICK_LATENCY = 3;
-    public static final int ABSOLUTE_MAX_WORLD_SIZE = 29999984;
+    public static final int ABSOLUTE_MAX_WORLD_SIZE = 32999984; // SourbyCraft: raised 30M -> 33M (under BlockPos 26-bit cap)
     public static final LevelSettings DEMO_SETTINGS = new LevelSettings(
         "Demo World", GameType.SURVIVAL, LevelSettings.DifficultySettings.DEFAULT, false, WorldDataConfiguration.DEFAULT
     );
@@ -2397,7 +2397,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     }
 
     public int getAbsoluteMaxWorldSize() {
-        return 29999984;
+        return ABSOLUTE_MAX_WORLD_SIZE; // SourbyCraft: 33M (was hardcoded 29999984)
     }
 
     @Override
