+        return pos.getX() >= -net.minecraft.world.level.Level.MAX_LEVEL_SIZE && pos.getZ() >= -net.minecraft.world.level.Level.MAX_LEVEL_SIZE && pos.getX() < net.minecraft.world.level.Level.MAX_LEVEL_SIZE && pos.getZ() < net.minecraft.world.level.Level.MAX_LEVEL_SIZE // SourbyCraft: use raised MAX_LEVEL_SIZE (33M)
             ? this.getRawBrightness(pos, skyDarkening)
             : 15;
     }
