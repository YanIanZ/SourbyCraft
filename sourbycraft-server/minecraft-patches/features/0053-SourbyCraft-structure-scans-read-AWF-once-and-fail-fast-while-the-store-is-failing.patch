@@ -457,7 +457,7 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
     public void scanChunk(final ChunkPos pos, final StreamTagVisitor scanner) throws IOException {
         // SourbyCraft start - Aurora World Fabric: structure scans must see the chunk AWF holds
         if (this.sourby$awf != null) {
-            final byte[] owned = this.sourby$awf.read(pos.x(), pos.z());
+            final byte[] owned = this.sourby$awf.scanRead(pos.x(), pos.z()); // SourbyCraft - structure scans: one attempt, no fence, refused while the store is failing
             if (owned == dev.iyanz.sourbycraft.awf.AwfRegionStorage.DELETED) return;
             if (owned != null) {
                 try (DataInputStream in = new DataInputStream(new java.io.ByteArrayInputStream(owned))) {
