From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: YanIanZ <iwayanbagusaryadarma@student.telkomuniversity.ac.id>
Date: Tue, 20 Oct 2026 14:56:47 +0700
Subject: [PATCH] SourbyCraft - time region-file chunk saves for /perf storage


diff --git a/net/minecraft/world/level/chunk/storage/RegionFileStorage.java b/net/minecraft/world/level/chunk/storage/RegionFileStorage.java
index 42bc751f0e34baefe01b7240258f19b23ff364df..65996dbb0046784e46500c31771b7eba2f270ee2 100644
--- a/net/minecraft/world/level/chunk/storage/RegionFileStorage.java
+++ b/net/minecraft/world/level/chunk/storage/RegionFileStorage.java
@@ -27,6 +27,7 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
     // Paper start - recalculate region file headers
     private final boolean isChunkData;
     private final dev.iyanz.sourbycraft.awf.AwfRegionStorage sourby$awf; // SourbyCraft - Aurora World Fabric: null unless this folder's world is stored in AWF
+    private final dev.iyanz.sourbycraft.perf.RegionFileSaveLatency.Recorder sourby$saveLatency; // SourbyCraft - /perf storage: region-file save latency
 
     @Nullable
     public static ChunkPos getRegionFileCoordinates(Path file) {
@@ -191,6 +192,21 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
             return;
         }
         // SourbyCraft end - Aurora World Fabric
+        // SourbyCraft start - /perf storage: time the region-file I/O stage, on success and on failure; the exception propagates unchanged
+        final long sourby$started = System.nanoTime();
+        boolean sourby$failed = true;
+        try {
+            this.sourby$finishRegionFileWrite(chunkX, chunkZ, writeData);
+            sourby$failed = false;
+        } finally {
+            this.sourby$saveLatency.record(sourby$started, System.nanoTime(), sourby$failed);
+        }
+    }
+
+    private void sourby$finishRegionFileWrite(
+        final int chunkX, final int chunkZ, final ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO.RegionDataController.WriteData writeData
+    ) throws IOException {
+        // SourbyCraft end - /perf storage
         final ChunkPos pos = new ChunkPos(chunkX, chunkZ);
         if (writeData.result() == ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO.RegionDataController.WriteData.WriteResult.DELETE) {
             final RegionFile regionFile = this.moonrise$getRegionFileIfExists(chunkX, chunkZ);
@@ -302,6 +318,7 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
         this.sync = sync;
         this.info = info;
         this.isChunkData = info.dfuType()[0] == net.minecraft.util.datafix.DataFixTypes.CHUNK; // Paper - recalculate region file headers
+        this.sourby$saveLatency = dev.iyanz.sourbycraft.perf.RegionFileSaveLatency.GLOBAL.recorder(String.valueOf(info.level()), info.dimension() == null ? "?" : info.dimension().identifier().toString(), String.valueOf(info.type())); // SourbyCraft - /perf storage
         this.sourby$awf = sourby$attachAwf(folder); // SourbyCraft - Aurora World Fabric
     }
 
