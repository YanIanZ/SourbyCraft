From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <Yan>
Date: Sat, 11 Jul 2026 22:04:06 +0700
Subject: [PATCH] SourbyCraft antixray: particle line-of-sight gate


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 10b5783ec1220393e6f9c6233c6111654f5fd461..326d0abf1c1993985c19c7b5c6961f92ccaaf670 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -2393,6 +2393,13 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         } else {
             BlockPos pos = player.blockPosition();
             if (pos.closerToCenterThan(new Vec3(x, y, z), overrideLimiter ? 512.0 : 32.0)) {
+                // SourbyCraft start - particle ray-trace gate (anti-ESP). Runs on the owning region
+                // thread (sendParticles is region-local); level.clip reads region-local blocks. Zero cost when off.
+                if (dev.iyanz.sourbycraft.antixray.ParticleVisibilityCheck.ENABLED.get()
+                    && !dev.iyanz.sourbycraft.antixray.ParticleVisibilityCheck.canSee(player, x, y, z)) {
+                    return false;
+                }
+                // SourbyCraft end - particle ray-trace gate
                 player.connection.send(packet);
                 return true;
             } else {
