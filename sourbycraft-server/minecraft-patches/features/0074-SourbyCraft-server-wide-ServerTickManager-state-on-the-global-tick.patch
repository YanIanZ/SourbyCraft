+                                if (this.player.level().getCurrentWorldData().regionData.getRegionSchedulingHandle().getTickManager().doesRunGameElements()) { // SourbyCraft - frozen ticks skip move counting again (region and server-wide ServerTickManager state)
                                     this.receivedMovePacketCount++;
                                     int deltaPackets = this.receivedMovePacketCount - this.knownMovePacketCount;
                                     // CraftBukkit start - handle custom speeds and skipped ticks
