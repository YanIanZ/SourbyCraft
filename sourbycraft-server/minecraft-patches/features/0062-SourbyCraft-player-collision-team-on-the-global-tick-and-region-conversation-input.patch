diff --git a/net/minecraft/world/scores/Scoreboard.java b/net/minecraft/world/scores/Scoreboard.java
index 712af9176a201fa060dee66a7099b2f22269c128..b46a3caa210965af57dd779b26c573a4793670d0 100644
--- a/net/minecraft/world/scores/Scoreboard.java
+++ b/net/minecraft/world/scores/Scoreboard.java
@@ -403,6 +403,27 @@ public class Scoreboard {
         // Canvas end - region threading
     }
 
+    // SourbyCraft start - atomic add for the player collision team: unlike addPlayerToTeam it never moves a holder that already has a team
+    public boolean addPlayerToTeamIfAbsent(final String player, final PlayerTeam team) {
+        final MutableBoolean added = new MutableBoolean(false);
+
+        this.teamReferences.swapValue((current) -> {
+            if (current.teamsByHolder.containsKey(player) || current.teamsByName.get(team.getName()) != team) {
+                return current;
+            }
+
+            var newTeamsByHolder = new Object2ObjectOpenHashMap<>(current.teamsByHolder);
+            newTeamsByHolder.put(player, team);
+            team.getPlayers().add(player);
+            added.setTrue();
+
+            return new Entry(current.teamsByName, newTeamsByHolder);
+        });
+
+        return added.isTrue();
+    }
+    // SourbyCraft end
+
     public boolean removePlayerFromTeam(final String player) {
         // Canvas start - region threading
         final MutableBoolean wasInTeam = new MutableBoolean(false);
