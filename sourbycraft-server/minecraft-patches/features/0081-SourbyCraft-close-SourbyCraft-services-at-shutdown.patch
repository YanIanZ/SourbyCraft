From: YanIanZ <iwayanbagusaryadarma@student.telkomuniversity.ac.id>
Date: Thu, 22 Oct 2026 05:55:41 +0700
Subject: [PATCH] SourbyCraft - close SourbyCraft services at shutdown


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index a0b7305f5e51b1392ed8abc210aac1271a2525d7..a6185bcbce53adb5cf581203005e2301ad7bf085 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1112,6 +1112,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             this.server.spark.disable(); // Paper - spark
             this.server.disablePlugins();
             this.server.waitForAsyncTasksShutdown(); // Paper - Wait for Async Tasks during shutdown
+            dev.iyanz.sourbycraft.core.SourbyCraftBootstrap.close();
         }
         // CraftBukkit end
         this.isSaving = true; // Canvas - region threading
