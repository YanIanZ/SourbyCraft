+            // during GlobalConfiguration's load, before SourbyCraftBootstrap has loaded anything.
+            tickThreads = dev.iyanz.aurora.cpu.AuroraCpu.regionTickThreads();
+            LOGGER.info("Region tick threads: {} ({})", tickThreads,
+                dev.iyanz.aurora.cpu.AuroraCpu.describe());
         } else {
             tickThreads = config.threads;
         }
