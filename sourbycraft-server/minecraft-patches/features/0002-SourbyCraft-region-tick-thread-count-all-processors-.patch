@@ -59,12 +58,30 @@ public final class TickRegions implements ThreadedRegionizer.RegionCallbacks<Tic
     private static int getTickThreads(final GlobalConfiguration.@NonNull ThreadedRegions config) {
         int tickThreads;
         if (config.threads <= 0) {
-            tickThreads = OSNuma.getNativeInstance().getTotalCores() / 2;
-            if (tickThreads <= 4) {
-                tickThreads = 1;
-            } else {
-                tickThreads =  tickThreads / 4;
-            }
+            // SourbyCraft - sane default region tick-thread count
+            // Upstream resolved -1 to totalCores/2 then /4 (<=4 -> 1), which gives ONE region tick
+            // thread on any host with <= 8 cores and only 2 on 16 cores — the whole region-threaded
+            // engine ends up serialised onto a single thread while the remaining cores idle.
+            //
+            // Folia's own default is half the processors, and this matched it until it was
+            // measured. On an 8-core host under identical block-tick load, 8 threads against that
+            // default of 4 cut mean MSPT 32% (25.07 -> 17.17ms) and the tail 62% (48.7 -> 18.3ms),
+            // while using LESS average CPU — the 4-thread arm spent its time contending. A 48.7ms
+            // maximum against a 50ms budget is a tick nearly missed, so half is not a safe default;
+            // it is a quieter way to run out of headroom. See docs/architecture/region-parallelism.md.
+            //
+            // A region only ever ticks on one thread, so this is a ceiling on parallelism, not a
+            // reservation: threads past the number of disconnected active regions simply idle,
+            // which is why raising it costs nothing on a world that cannot use them. An operator
+            // who needs cores held back for chunk workers or Netty sets threads: N explicitly.
+            //
+            // availableProcessors() (not OSNuma total cores) so container CPU quotas are respected.
+            // aurora.cpu.cores caps it when an operator wants the machine shared; unset, this is
