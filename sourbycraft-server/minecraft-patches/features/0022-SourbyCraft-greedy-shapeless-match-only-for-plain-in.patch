From: agent <agent@local>
Date: Mon, 5 Oct 2026 15:01:39 +0700
Subject: [PATCH] SourbyCraft - greedy shapeless match only for plain
 ingredients


diff --git a/net/minecraft/world/item/crafting/ShapelessRecipe.java b/net/minecraft/world/item/crafting/ShapelessRecipe.java
index 786d512ce9820f1a552b750a4d1c1b9bf3a68941..34b048c1971ba4bdb2025b7f0cde2e853229707f 100644
--- a/net/minecraft/world/item/crafting/ShapelessRecipe.java
+++ b/net/minecraft/world/item/crafting/ShapelessRecipe.java
@@ -83,7 +83,11 @@ public class ShapelessRecipe extends NormalCraftingRecipe {
     @Override
     public boolean matches(final CraftingInput input, final Level level) {
         // Pufferfish start
-        if (!this.isBukkit) {
+        // SourbyCraft start - the greedy first-fit match is only sound for plain ingredients; an
+        // exact or predicate ingredient (Paper PredicateChoice) needs Paper's assignment below, or
+        // a renamed item can be consumed by a regular slot it does not satisfy.
+        if (!this.isBukkit && this.ingredients.stream().noneMatch(ingredient -> ingredient.isExact() || ingredient.stackPredicate != null)) {
+        // SourbyCraft end
             java.util.List<Ingredient> ingredients = com.google.common.collect.Lists.newArrayList(this.ingredients.toArray(new Ingredient[0]));
 
             inventory: for (int index = 0; index < input.size(); index++) {
