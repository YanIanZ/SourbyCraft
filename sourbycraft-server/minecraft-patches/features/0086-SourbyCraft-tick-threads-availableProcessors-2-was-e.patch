From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yan <superwhisz@gmail.com>
Date: Sun, 12 Jul 2026 16:07:35 +0700
Subject: [PATCH] SourbyCraft: tick threads = availableProcessors/2 (was
 effectively 1)


diff --git a/io/papermc/paper/threadedregions/TickRegions.java b/io/papermc/paper/threadedregions/TickRegions.java
index 97c514673a454b752ab86b944fd143725ca8090d..c7ccf5c4ef3d49efce2dce2771b7e921dafe3c65 100644
--- a/io/papermc/paper/threadedregions/TickRegions.java
+++ b/io/papermc/paper/threadedregions/TickRegions.java
@@ -44,12 +44,17 @@ public final class TickRegions implements ThreadedRegionizer.RegionCallbacks<Tic
     private static int getTickThreads(final GlobalConfiguration.ThreadedRegions config) {
         int tickThreads;
         if (config.threads <= 0) {
-            tickThreads = OSNuma.getNativeInstance().getTotalCores() / 2;
-            if (tickThreads <= 4) {
-                tickThreads = 1;
-            } else {
-                tickThreads =  tickThreads / 4;
-            }
+            // SourbyCraft: half the cores, like upstream Folia. The previous formula
+            // (cores/2, then <=4 -> 1, else /4) gave ONE tick thread to every host with
+            // <= 9 cores and TWO to a 16-core box — a single EDF thread then multiplexes
+            // the global region + every world region, so one region's chunk-gen burst
+            // (e.g. a player joining) slips every other region's deadline: TPS < 20 and
+            // 15ms+ worst-region MSPT with a single player online.
+            // Runtime.availableProcessors, NOT OSNuma.getTotalCores(): the native NUMA probe
+            // returns 0/1 cores on hosts without the native lib (macOS, many containers), which
+            // silently collapsed the pool back to a single thread. availableProcessors is also
+            // container-aware (respects cgroup CPU limits on panels).
+            tickThreads = Math.max(1, Runtime.getRuntime().availableProcessors() / 2);
         } else {
             tickThreads = config.threads;
         }
